      "type": "array"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "read",
            "propose",
            "approve",
            "people",
            "admin"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Scope"
    }
  },
  "required": [
    "scope",
    "capabilities",
    "permissions",
    "expires_at"
