  "additionalProperties": false,
  "description": "Effective permissions and expiry, without a token or any write.",
  "properties": {
    "capabilities": {
      "items": {
        "enum": [
          "api.read",
          "fleet.read",
          "metrics.read",
          "topology.read",
          "fleet.apply",
          "nodes.enroll",
          "people.read",
          "people.query",
          "people.batch",
          "people.private",
          "people.edit",
          "people.credentials",
          "people.reset",
          "people.reissue",
          "people.remove",
          "people.devices",
          "people.bulk",
          "commands.read",
          "commands.restart",
          "commands.run",
          "commands.cut_off",
          "backup.read",
          "backup.edit",
          "settings.edit",
          "tokens.read",
          "tokens.issue",
          "tokens.revoke",
          "revisions.read",
          "revisions.propose",
          "revisions.approve",
          "revisions.approve_own",
