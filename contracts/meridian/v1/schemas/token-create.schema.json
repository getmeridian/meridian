{
  "additionalProperties": false,
  "description": "Choose one compatible preset or an explicit nonempty grant; new tokens expire by default.",
  "properties": {
    "capabilities": {
      "anyOf": [
        {
          "items": {
            "enum": [
              "api.read",
              "fleet.read",
              "metrics.read",
              "topology.read",
              "fleet.apply",
              "nodes.enroll",
              "people.read",
              "people.query",
              "people.batch",
              "people.private",
              "people.edit",
              "people.credentials",
              "people.reset",
              "people.reissue",
              "people.remove",
              "people.devices",
              "people.bulk",
              "commands.read",
              "commands.restart",
              "commands.run",
              "commands.cut_off",
              "backup.read",
              "backup.edit",
              "settings.edit",
              "tokens.read",
              "tokens.issue",
              "tokens.revoke",
              "revisions.read",
              "revisions.propose",
              "revisions.approve",
              "revisions.approve_own",
              "owner.read",
              "console.read"
            ],
            "type": "string"
          },
          "maxItems": 33,
          "minItems": 1,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Capabilities"
    },
    "expires_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Future UTC expiry instead of expires_in_days.",
      "title": "Expires At"
    },
    "expires_in_days": {
      "anyOf": [
        {
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": 90,
      "description": "Whole days from issuance; defaults to 90. Null needs never_expires=true.",
      "title": "Expires In Days"
    },
    "name": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Name",
      "type": "string"
    },
    "never_expires": {
      "default": false,
      "description": "Explicitly opt out of expiry; cannot accompany an expiry value.",
      "title": "Never Expires",
      "type": "boolean"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "read",
            "propose",
            "approve",
            "people",
            "admin"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    }
  },
  "required": [
    "name"
  ],
  "title": "TokenCreate",
  "type": "object"
}
