{
  "$defs": {
    "AccessChange": {
      "additionalProperties": false,
      "properties": {
        "gained": {
          "items": {
            "type": "string"
          },
          "title": "Gained",
          "type": "array"
        },
        "lost": {
          "items": {
            "type": "string"
          },
          "title": "Lost",
          "type": "array"
        },
        "profiles": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "profiles",
        "gained",
        "lost"
      ],
      "title": "AccessChange",
      "type": "object"
    },
    "AccessProfileReview": {
      "additionalProperties": false,
      "properties": {
        "access_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Hash",
          "type": "string"
        },
        "access_profiles": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "items": {
                "pattern": "^inbound:[a-z0-9][a-z0-9:_.-]{0,191}$",
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 48,
            "minLength": 1
          },
          "title": "Access Profiles",
          "type": "object"
        },
        "cut_off": {
          "$ref": "#/$defs/CutOffPlan"
        },
        "gained_people": {
          "minimum": 0,
          "title": "Gained People",
          "type": "integer"
        },
        "lost_people": {
          "minimum": 0,
          "title": "Lost People",
          "type": "integer"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/AccessChange"
          },
          "title": "People",
          "type": "array"
        }
      },
      "required": [
        "access_hash",
        "access_profiles",
        "people",
        "gained_people",
        "lost_people",
        "cut_off"
      ],
      "title": "AccessProfileReview",
      "type": "object"
    },
    "CompiledPlanDriftResult": {
      "additionalProperties": false,
      "description": "One V4 compiler resource that does not match remote state.",
      "properties": {
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        }
      },
      "required": [
        "logical_id"
      ],
      "title": "CompiledPlanDriftResult",
      "type": "object"
    },
    "CompiledPlanResourceResult": {
      "additionalProperties": false,
      "description": "Secret-free identity for one reviewed V4 compiler resource.",
      "properties": {
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "desired_hash": {
          "title": "Desired Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "server_baseline",
            "control_plane_runtime",
            "config_profile",
            "inbound",
            "node_binding",
            "node_runtime",
            "host",
            "internal_squad",
            "external_squad",
            "access_user",
            "service_user",
            "subscription_template",
            "subscription_settings",
            "nginx_artifact",
            "realm_hop",
            "firewall_rule",
            "certificate",
            "routing_gateway",
            "egress_pool",
            "route_rule",
            "probe",
            "control_service",
            "agent_runtime",
            "node_workload",
            "client_endpoint",
            "control_user",
            "service_settings"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "kind",
        "desired_hash"
      ],
      "title": "CompiledPlanResourceResult",
      "type": "object"
    },
    "CutOffNode": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "default": "inbound_reset",
          "description": "A core restart reconnects every Xray inbound and bridge on this node; an inbound reset reconnects the listed inbounds, with whole-core fallback on failure.",
          "enum": [
            "inbound_reset",
            "core_restart"
          ],
          "title": "Effect",
          "type": "string"
        },
        "inbound_tags": {
          "items": {
            "description": "Xray inbound tag.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Inbound Tags",
          "type": "array"
        },
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "inbound_tags"
      ],
      "title": "CutOffNode",
      "type": "object"
    },
    "CutOffPlan": {
      "additionalProperties": false,
      "description": "Every managed inbound that may hold the person's open sessions; contains no person or credential.",
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/CutOffNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "CutOffPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Success data returned by plan execution.",
  "properties": {
    "access_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessProfileReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "drifted_resources": {
      "items": {
        "$ref": "#/$defs/CompiledPlanDriftResult"
      },
      "title": "Drifted Resources",
      "type": "array"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "observation_errors": {
      "items": {
        "$ref": "#/$defs/CompiledPlanDriftResult"
      },
      "title": "Observation Errors",
      "type": "array"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/CompiledPlanResourceResult"
      },
      "title": "Resources",
      "type": "array"
    },
    "retiring_resources": {
      "items": {
        "type": "string"
      },
      "title": "Retiring Resources",
      "type": "array"
    },
    "review_hash": {
      "default": "",
      "description": "Plan hash bound to the exact retirement set; equals plan_hash when nothing is removed.",
      "title": "Review Hash",
      "type": "string"
    },
    "state_changes": {
      "items": {
        "type": "string"
      },
      "title": "State Changes",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "warnings": {
      "description": "Conditions that will make apply refuse, such as a stale state copy.",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "plan_hash",
    "converged",
    "summary",
    "exit_code"
  ],
  "title": "PlanCommandData",
  "type": "object"
}
