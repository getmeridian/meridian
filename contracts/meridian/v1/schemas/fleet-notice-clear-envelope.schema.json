{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Notice": {
      "additionalProperties": false,
      "description": "One service-owned notice; reviewed topology applies never replace it.",
      "properties": {
        "text": {
          "description": "One plain paragraph; only {name}, {expires}, {days_left}, {used}, {quota}.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC expiry instant; null keeps the notice indefinitely.",
          "title": "Until"
        }
      },
      "required": [
        "text"
      ],
      "title": "Notice",
      "type": "object"
    },
    "NoticeState": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "title": "Active",
          "type": "boolean"
        },
        "allowed_substitutions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Substitutions",
          "type": "array"
        },
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "for_user": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "For User"
        },
        "notice": {
          "anyOf": [
            {
              "$ref": "#/$defs/Notice"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "maxLength": 1024,
          "title": "Preview",
          "type": "string"
        }
      },
      "required": [
        "notice",
        "active",
        "for_user",
        "preview"
      ],
      "title": "NoticeState",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetNoticeClearSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.notice.clear",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/NoticeState"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "changed",
            "no_changes"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetNoticeClearSuccessEnvelope",
      "type": "object"
    },
    "_FleetNoticeClearTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.notice.clear",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetNoticeClearTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet notice clear --json`.",
  "discriminator": {
    "mapping": {
      "changed": "#/$defs/_FleetNoticeClearSuccessEnvelope",
      "failed": "#/$defs/_FleetNoticeClearTerminalEnvelope",
      "no_changes": "#/$defs/_FleetNoticeClearSuccessEnvelope",
      "ok": "#/$defs/_FleetNoticeClearSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetNoticeClearSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetNoticeClearTerminalEnvelope"
    }
  ],
  "title": "FleetNoticeClearOutputEnvelope"
}
