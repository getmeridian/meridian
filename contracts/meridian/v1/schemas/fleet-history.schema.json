{
  "$defs": {
    "RevisionActor": {
      "additionalProperties": false,
      "description": "Who proposed or approved a revision: an issued token, or the root config token (`token_id` null).",
      "properties": {
        "name": {
          "description": "The token's name; `root` for the configured admin token, the deployer's.",
          "title": "Name",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "RevisionActor",
      "type": "object"
    },
    "RevisionSummary": {
      "additionalProperties": false,
      "description": "One reviewed apply: proposed, then approved, then applied or failed.",
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionActor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "author": {
          "$ref": "#/$defs/RevisionActor"
        },
        "created_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Created At",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "intent_sha256": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        },
        "number": {
          "description": "Increases by one per proposal and is never reused.",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "plan_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "review_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "applied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "number",
        "created_at",
        "author",
        "intent_sha256",
        "plan_hash",
        "review_hash",
        "status"
      ],
      "title": "RevisionSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "revisions": {
      "description": "Newest first.",
      "items": {
        "$ref": "#/$defs/RevisionSummary"
      },
      "title": "Revisions",
      "type": "array"
    }
  },
  "required": [
    "revisions"
  ],
  "title": "RevisionList",
  "type": "object"
}
