{
  "additionalProperties": false,
  "description": "Effective dates after catch-up; calculating them never writes or activates an account.",
  "properties": {
    "activation_duration_days": {
      "anyOf": [
        {
          "maximum": 3650,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Activation Duration Days"
    },
    "activation_pending": {
      "title": "Activation Pending",
      "type": "boolean"
    },
    "expire_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expire At"
    },
    "next_renewal_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Renewal At"
    },
    "next_reset_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Reset At"
    },
    "renewal_enabled": {
      "title": "Renewal Enabled",
      "type": "boolean"
    },
    "renewals_completed": {
      "minimum": 0,
      "title": "Renewals Completed",
      "type": "integer"
    },
    "renewals_due": {
      "description": "Missed renewals applied together with one traffic reset.",
      "minimum": 0,
      "title": "Renewals Due",
      "type": "integer"
    },
    "renewals_left": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null for unlimited renewals or when renewal is off.",
      "title": "Renewals Left"
    }
  },
  "required": [
    "activation_pending",
    "activation_duration_days",
    "expire_at",
    "next_reset_at",
    "renewal_enabled",
    "next_renewal_at",
    "renewals_left",
    "renewals_due",
    "renewals_completed"
  ],
  "title": "AccountSchedulePreview",
  "type": "object"
}
