{
  "$defs": {
    "AccessIntent": {
      "additionalProperties": false,
      "description": "Meridian-owned access squad and human users.\n\n`users` are panel usernames (Latin only, as Remnawave requires); `display_names`\nkeeps the name as typed, in any script, for users whose username differs from it.",
      "properties": {
        "creation_settings": {
          "description": "First account settings only; reviewed applies never replace an existing person's settings.",
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/UserCreationSettings"
            }
          },
          "propertyNames": {
            "maxLength": 36,
            "minLength": 3
          },
          "title": "Creation Settings",
          "type": "object"
        },
        "display_names": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 36,
            "minLength": 3
          },
          "title": "Display Names",
          "type": "object"
        },
        "squad_name": {
          "default": "Meridian Access",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Squad Name",
          "type": "string"
        },
        "users": {
          "items": {
            "maxLength": 36,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Users",
          "type": "array"
        }
      },
      "required": [
        "users"
      ],
      "title": "AccessIntent",
      "type": "object"
    },
    "AccessProfileIntent": {
      "additionalProperties": false,
      "description": "A named set of reviewed exits, gateways, public endpoints, or authentication inbounds.",
      "properties": {
        "grants": {
          "items": {
            "pattern": "^(?:exit|gateway|inbound|endpoint):[a-z0-9][a-z0-9:_.-]{0,191}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Grants",
          "type": "array"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "grants"
      ],
      "title": "AccessProfileIntent",
      "type": "object"
    },
    "BlockAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "block",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BlockAction",
      "type": "object"
    },
    "CidrMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cidr",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 49,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "CidrMatch",
      "type": "object"
    },
    "ControlPlaneIntent": {
      "additionalProperties": false,
      "description": "One server that owns the control-plane workload.",
      "properties": {
        "backend": {
          "default": "meridian",
          "enum": [
            "remnawave",
            "meridian"
          ],
          "title": "Backend",
          "type": "string"
        },
        "public_hostname": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Public Hostname"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        },
        "title": {
          "default": "Meridian",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "server_ref"
      ],
      "title": "ControlPlaneIntent",
      "type": "object"
    },
    "DeliveryAction": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "kind": {
          "enum": [
            "proxy",
            "direct",
            "block",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryAction",
      "type": "object"
    },
    "DeliveryDns": {
      "additionalProperties": false,
      "properties": {
        "fake_ip": {
          "default": false,
          "title": "Fake Ip",
          "type": "boolean"
        },
        "resolvers": {
          "items": {
            "discriminator": {
              "mapping": {
                "doh": "#/$defs/DohResolver",
                "dot": "#/$defs/DotResolver",
                "plain": "#/$defs/PlainResolver"
              },
              "propertyName": "transport"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DohResolver"
              },
              {
                "$ref": "#/$defs/DotResolver"
              },
              {
                "$ref": "#/$defs/PlainResolver"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Resolvers",
          "type": "array"
        }
      },
      "required": [
        "resolvers"
      ],
      "title": "DeliveryDns",
      "type": "object"
    },
    "DeliveryIntent": {
      "additionalProperties": false,
      "description": "Canonical Remnawave subscription presentation settings.",
      "properties": {
        "client_routing": {
          "default": "ru-split",
          "description": "Client routing: ru-split bypasses Russian destinations; full tunnels them. Both bypass private/LAN ranges and retain Xray's best-effort BitTorrent bypass.",
          "enum": [
            "ru-split",
            "full"
          ],
          "title": "Client Routing",
          "type": "string"
        },
        "default_policy": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Policy"
        },
        "delivery_policies": {
          "items": {
            "$ref": "#/$defs/DeliveryPolicy"
          },
          "maxItems": 64,
          "title": "Delivery Policies",
          "type": "array"
        },
        "formats": {
          "items": {
            "enum": [
              "base64",
              "xray_json",
              "mihomo",
              "singbox"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "owner_contact": {
          "$ref": "#/$defs/OwnerContact",
          "description": "Optional public owner contact, chosen through reviewed delivery intent."
        },
        "profile_policies": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 48,
            "minLength": 1
          },
          "title": "Profile Policies",
          "type": "object"
        },
        "profile_title": {
          "default": "Meridian",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Profile Title",
          "type": "string"
        },
        "response_rules": {
          "items": {
            "$ref": "#/$defs/ResponseRule"
          },
          "maxItems": 64,
          "title": "Response Rules",
          "type": "array"
        },
        "template_name": {
          "default": "meridian",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Template Name",
          "type": "string"
        },
        "update_interval_hours": {
          "default": 6,
          "maximum": 168,
          "minimum": 1,
          "title": "Update Interval Hours",
          "type": "integer"
        }
      },
      "title": "DeliveryIntent",
      "type": "object"
    },
    "DeliveryPolicy": {
      "additionalProperties": false,
      "description": "LAN always precedes custom rules; the preset's remaining rules follow them.",
      "properties": {
        "dns": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryDns"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "preset": {
          "default": "full",
          "enum": [
            "ru-split",
            "full"
          ],
          "title": "Preset",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/DeliveryRule"
          },
          "maxItems": 128,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeliveryPolicy",
      "type": "object"
    },
    "DeliveryPortRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start"
      ],
      "title": "DeliveryPortRange",
      "type": "object"
    },
    "DeliveryRule": {
      "additionalProperties": false,
      "description": "Values are alternatives; network and ports narrow the whole match with AND.",
      "properties": {
        "action": {
          "$ref": "#/$defs/DeliveryAction"
        },
        "match": {
          "discriminator": {
            "mapping": {
              "cidr": "#/$defs/CidrMatch",
              "domain_full": "#/$defs/DomainFullMatch",
              "domain_keyword": "#/$defs/DomainKeywordMatch",
              "domain_suffix": "#/$defs/DomainSuffixMatch",
              "geoip": "#/$defs/GeoipMatch",
              "geosite": "#/$defs/GeositeMatch",
              "network": "#/$defs/NetworkMatch",
              "port": "#/$defs/PortMatch"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DomainSuffixMatch"
            },
            {
              "$ref": "#/$defs/DomainKeywordMatch"
            },
            {
              "$ref": "#/$defs/DomainFullMatch"
            },
            {
              "$ref": "#/$defs/GeositeMatch"
            },
            {
              "$ref": "#/$defs/GeoipMatch"
            },
            {
              "$ref": "#/$defs/CidrMatch"
            },
            {
              "$ref": "#/$defs/PortMatch"
            },
            {
              "$ref": "#/$defs/NetworkMatch"
            }
          ],
          "title": "Match"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "tcp",
                "udp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/DeliveryPortRange"
          },
          "maxItems": 16,
          "title": "Ports",
          "type": "array"
        }
      },
      "required": [
        "match",
        "action"
      ],
      "title": "DeliveryRule",
      "type": "object"
    },
    "DohResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "path": {
          "default": "/dns-query",
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "doh",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DohResolver",
      "type": "object"
    },
    "DomainFullMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_full",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainFullMatch",
      "type": "object"
    },
    "DomainKeywordMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_keyword",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainKeywordMatch",
      "type": "object"
    },
    "DomainSuffixMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_suffix",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainSuffixMatch",
      "type": "object"
    },
    "DotResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 853,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "dot",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DotResolver",
      "type": "object"
    },
    "EgressOverrideIntent": {
      "additionalProperties": false,
      "description": "Send matching destinations through WARP, directly, or nowhere, ahead of the exit's default egress.",
      "properties": {
        "action": {
          "enum": [
            "warp",
            "direct",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "enum": [
            "domain",
            "geosite",
            "geoip"
          ],
          "title": "Match",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "match",
        "values",
        "action"
      ],
      "title": "EgressOverrideIntent",
      "type": "object"
    },
    "EgressPoolIntent": {
      "additionalProperties": false,
      "description": "An ordered set of exits used for server-side failover.",
      "properties": {
        "exit_refs": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Exit Refs",
          "type": "array"
        },
        "fail_closed": {
          "default": true,
          "title": "Fail Closed",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "probe_url": {
          "default": "https://www.apple.com/library/test/success.html",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Probe Url",
          "type": "string"
        },
        "strategy": {
          "const": "least_ping",
          "default": "least_ping",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "exit_refs"
      ],
      "title": "EgressPoolIntent",
      "type": "object"
    },
    "FormatAction": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "headers": {
          "$ref": "#/$defs/ResponseHeaders"
        },
        "kind": {
          "const": "format",
          "title": "Kind",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        }
      },
      "required": [
        "kind",
        "format"
      ],
      "title": "FormatAction",
      "type": "object"
    },
    "GeoipMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "geoip",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "GeoipMatch",
      "type": "object"
    },
    "GeositeMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "geosite",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "GeositeMatch",
      "type": "object"
    },
    "HeadersAction": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "$ref": "#/$defs/ResponseHeaders"
        },
        "kind": {
          "const": "headers",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "headers"
      ],
      "title": "HeadersAction",
      "type": "object"
    },
    "LiteralCondition": {
      "additionalProperties": false,
      "description": "A nonempty literal; case folding never turns it into a pattern.",
      "properties": {
        "operator": {
          "enum": [
            "equals",
            "prefix",
            "contains"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "operator",
        "value"
      ],
      "title": "LiteralCondition",
      "type": "object"
    },
    "NetworkMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "network",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "enum": [
              "tcp",
              "udp"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "NetworkMatch",
      "type": "object"
    },
    "OrderedRouteIntent": {
      "additionalProperties": false,
      "description": "One explicit first-match routing rule.",
      "properties": {
        "action": {
          "default": "route",
          "enum": [
            "route",
            "direct",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "country",
            "domain",
            "geosite",
            "ip",
            "network"
          ],
          "title": "Match",
          "type": "string"
        },
        "match_values": {
          "items": {
            "type": "string"
          },
          "title": "Match Values",
          "type": "array"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "source_gateway_ref": {
          "default": "",
          "maxLength": 48,
          "pattern": "^$|^[a-z0-9][a-z0-9_-]*$",
          "title": "Source Gateway Ref",
          "type": "string"
        },
