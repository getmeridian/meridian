{
  "$defs": {
    "DeliveryAction": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "kind": {
          "enum": [
            "proxy",
            "direct",
            "block",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryAction",
      "type": "object"
    },
    "DeliveryDestination": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "network": {
          "default": "tcp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Network",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "protocol": {
          "default": "other",
          "enum": [
            "other",
            "bittorrent"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "title": "DeliveryDestination",
      "type": "object"
    },
    "DeliveryExplanation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "$ref": "#/$defs/DeliveryDestination"
        },
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "geodata_available": {
          "title": "Geodata Available",
          "type": "boolean"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/DeliveryPolicyOmission"
          },
          "maxItems": 512,
          "title": "Omitted",
          "type": "array"
        },
        "policy": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Policy",
          "type": "string"
        },
        "reason": {
          "enum": [
            "rule_matched",
            "default_proxy",
            "geodata_unavailable",
            "port_required",
            "ip_required",
            "rules_not_carried",
            "no_connections",
            "inactive_person"
          ],
          "title": "Reason",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "maximum": 133,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "status": {
          "enum": [
            "matched",
            "default",
            "unknown",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "destination",
        "format",
        "policy",
        "status",
        "action",
        "reason",
        "geodata_available"
      ],
      "title": "DeliveryExplanation",
      "type": "object"
    },
    "DeliveryPolicyOmission": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "enum": [
                "xray_individual_profiles",
                "xray_fingerprint_profiles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "exit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "profile_count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Count"
        },
        "reason": {
          "enum": [
            "rules_not_carried",
            "dns_not_carried",
            "geosite_not_supported",
            "geoip_not_supported",
            "bittorrent_not_supported",
            "dns_transport_not_supported",
            "fake_ip_not_supported",
            "exit_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "rule": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DeliveryPolicyOmission",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetRoutingExplainSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.routing.explain",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DeliveryExplanation"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetRoutingExplainSuccessEnvelope",
      "type": "object"
    },
    "_FleetRoutingExplainTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.routing.explain",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetRoutingExplainTerminalEnvelope",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_FleetRoutingExplainTerminalEnvelope",
      "ok": "#/$defs/_FleetRoutingExplainSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetRoutingExplainSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetRoutingExplainTerminalEnvelope"
    }
  ],
  "title": "FleetRoutingExplainOutputEnvelope"
}
