{
  "additionalProperties": false,
  "description": "Remove these declared usernames in one local review and apply; carries no session cut-off choice.",
  "properties": {
    "fleet_id": {
      "description": "Fleet identifier: a lowercase UUID fixed when the fleet is created.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Fleet Id",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "intent_sha256": {
      "description": "Lowercase hex SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Intent Sha256",
      "type": "string"
    },
    "plan_hash": {
      "description": "Lowercase hex SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "meridian.people-removal/v1",
      "default": "meridian.people-removal/v1",
      "title": "Schema",
      "type": "string"
    },
    "usernames": {
      "items": {
        "maxLength": 36,
        "minLength": 3,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "maxItems": 50000,
      "minItems": 1,
      "title": "Usernames",
      "type": "array"
    }
  },
  "required": [
    "fleet_id",
    "revision",
    "generation",
    "plan_hash",
    "intent_sha256",
    "usernames"
  ],
  "title": "PeopleRemovalProposal",
  "type": "object"
}
