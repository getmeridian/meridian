{
  "$defs": {
    "CompiledPlanDriftResult": {
      "additionalProperties": false,
      "description": "One V4 compiler resource that does not match remote state.",
      "properties": {
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        }
      },
      "required": [
        "logical_id"
      ],
      "title": "CompiledPlanDriftResult",
      "type": "object"
    },
    "CompiledPlanResourceResult": {
      "additionalProperties": false,
      "description": "Secret-free identity for one reviewed V4 compiler resource.",
      "properties": {
        "dependencies": {
          "items": {
            "type": "string"
          },
          "title": "Dependencies",
          "type": "array"
        },
        "desired_hash": {
          "title": "Desired Hash",
          "type": "string"
        },
        "kind": {
          "enum": [
            "server_baseline",
            "control_plane_runtime",
            "config_profile",
            "inbound",
            "node_binding",
            "node_runtime",
            "host",
            "internal_squad",
            "external_squad",
            "access_user",
            "service_user",
            "subscription_template",
            "subscription_settings",
            "nginx_artifact",
            "realm_hop",
            "firewall_rule",
            "certificate",
            "routing_gateway",
            "egress_pool",
            "route_rule",
            "probe"
          ],
          "title": "Kind",
          "type": "string"
        },
        "logical_id": {
          "title": "Logical Id",
          "type": "string"
        }
      },
      "required": [
        "logical_id",
        "kind",
        "desired_hash"
      ],
      "title": "CompiledPlanResourceResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Read-only drift result for a V4 compiler plan.",
  "properties": {
    "converged": {
      "title": "Converged",
      "type": "boolean"
    },
    "drifted_resources": {
      "items": {
        "$ref": "#/$defs/CompiledPlanDriftResult"
      },
      "title": "Drifted Resources",
      "type": "array"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "observation_errors": {
      "items": {
        "$ref": "#/$defs/CompiledPlanDriftResult"
      },
      "title": "Observation Errors",
      "type": "array"
    },
    "plan_hash": {
      "title": "Plan Hash",
      "type": "string"
    },
    "resources": {
      "items": {
        "$ref": "#/$defs/CompiledPlanResourceResult"
      },
      "title": "Resources",
      "type": "array"
    },
    "state_changes": {
      "items": {
        "type": "string"
      },
      "title": "State Changes",
      "type": "array"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    }
  },
  "required": [
    "plan_hash",
    "converged",
    "summary",
    "exit_code"
  ],
  "title": "CompiledPlanResult",
  "type": "object"
}
