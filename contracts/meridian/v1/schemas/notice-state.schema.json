{
  "$defs": {
    "Notice": {
      "additionalProperties": false,
      "description": "One service-owned notice; reviewed topology applies never replace it.",
      "properties": {
        "text": {
          "description": "One plain paragraph; only {name}, {expires}, {days_left}, {used}, {quota}.",
          "maxLength": 500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC expiry instant; null keeps the notice indefinitely.",
          "title": "Until"
        }
      },
      "required": [
        "text"
      ],
      "title": "Notice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "active": {
      "title": "Active",
      "type": "boolean"
    },
    "allowed_substitutions": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Substitutions",
      "type": "array"
    },
    "changed": {
      "default": false,
      "title": "Changed",
      "type": "boolean"
    },
    "for_user": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "For User"
    },
    "notice": {
      "anyOf": [
        {
          "$ref": "#/$defs/Notice"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview": {
      "maxLength": 1024,
      "title": "Preview",
      "type": "string"
    }
  },
  "required": [
    "notice",
    "active",
    "for_user",
    "preview"
  ],
  "title": "NoticeState",
  "type": "object"
}
