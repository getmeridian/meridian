{
  "$defs": {
    "ApiSchemaResult": {
      "additionalProperties": false,
      "description": "Result for `meridian api schema NAME --envelope`.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schema": {
          "additionalProperties": true,
          "title": "Schema",
          "type": "object"
        }
      },
      "required": [
        "name",
        "schema"
      ],
      "title": "ApiSchemaResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by failed or cancelled envelopes.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ApiSchemaSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "api.schema",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ApiSchemaResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApiSchemaSuccessEnvelope",
      "type": "object"
    },
    "_ApiSchemaTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "api.schema",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApiSchemaTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian api schema NAME --envelope`.",
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/_ApiSchemaTerminalEnvelope",
      "failed": "#/$defs/_ApiSchemaTerminalEnvelope",
      "ok": "#/$defs/_ApiSchemaSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ApiSchemaSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ApiSchemaTerminalEnvelope"
    }
  ],
  "title": "ApiSchemaOutputEnvelope"
}
