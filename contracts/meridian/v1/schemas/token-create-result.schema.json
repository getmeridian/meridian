{
  "$defs": {
    "CapabilityPermission": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "enum": [
            "api.read",
            "fleet.read",
            "metrics.read",
            "topology.read",
            "fleet.apply",
            "nodes.enroll",
            "people.read",
            "people.query",
            "people.batch",
            "people.private",
            "people.edit",
            "people.delivery",
            "delivery.read",
            "delivery.explain",
            "people.credentials",
            "people.reset",
            "people.reissue",
            "people.remove",
            "people.devices",
            "people.bulk",
            "commands.read",
            "commands.restart",
            "commands.run",
            "commands.cut_off",
            "backup.read",
            "backup.edit",
            "settings.edit",
            "tokens.read",
            "tokens.issue",
            "tokens.revoke",
            "revisions.read",
            "revisions.propose",
            "revisions.approve",
            "revisions.approve_own",
            "owner.read",
            "console.read"
          ],
          "title": "Capability",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "en",
              "ru",
              "fa",
              "zh"
            ]
          },
          "title": "Labels",
          "type": "object"
        }
      },
      "required": [
        "capability",
        "labels"
      ],
      "title": "CapabilityPermission",
      "type": "object"
    },
    "IssuedToken": {
      "additionalProperties": false,
      "description": "Only this producing response contains the token secret.",
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "api.read",
              "fleet.read",
              "metrics.read",
              "topology.read",
              "fleet.apply",
              "nodes.enroll",
              "people.read",
              "people.query",
              "people.batch",
              "people.private",
              "people.edit",
              "people.delivery",
              "delivery.read",
              "delivery.explain",
              "people.credentials",
              "people.reset",
              "people.reissue",
              "people.remove",
              "people.devices",
              "people.bulk",
              "commands.read",
              "commands.restart",
              "commands.run",
              "commands.cut_off",
              "backup.read",
              "backup.edit",
              "settings.edit",
              "tokens.read",
              "tokens.issue",
              "tokens.revoke",
              "revisions.read",
              "revisions.propose",
              "revisions.approve",
              "revisions.approve_own",
              "owner.read",
              "console.read"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "created_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "id": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "last_used_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coarse: updated at most once a minute.",
          "title": "Last Used At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "read",
                "propose",
                "approve",
                "people",
                "admin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        },
        "token": {
          "description": "Opaque base64url token.",
          "maxLength": 256,
          "minLength": 32,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Token",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "scope",
        "created_at",
        "token"
      ],
      "title": "IssuedToken",
      "type": "object"
    },
    "TokenPreview": {
      "additionalProperties": false,
      "description": "Effective permissions and expiry, without a token or any write.",
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "api.read",
              "fleet.read",
              "metrics.read",
              "topology.read",
              "fleet.apply",
              "nodes.enroll",
              "people.read",
              "people.query",
              "people.batch",
              "people.private",
              "people.edit",
              "people.delivery",
              "delivery.read",
              "delivery.explain",
              "people.credentials",
              "people.reset",
              "people.reissue",
              "people.remove",
              "people.devices",
              "people.bulk",
              "commands.read",
              "commands.restart",
              "commands.run",
              "commands.cut_off",
              "backup.read",
              "backup.edit",
              "settings.edit",
              "tokens.read",
              "tokens.issue",
              "tokens.revoke",
              "revisions.read",
              "revisions.propose",
              "revisions.approve",
              "revisions.approve_own",
              "owner.read",
              "console.read"
            ],
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "expires_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/CapabilityPermission"
          },
          "title": "Permissions",
          "type": "array"
        },
        "scope": {
          "anyOf": [
            {
              "enum": [
                "read",
                "propose",
                "approve",
                "people",
                "admin"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scope"
        }
      },
      "required": [
        "scope",
        "capabilities",
        "permissions",
        "expires_at"
      ],
      "title": "TokenPreview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A CLI preview and, after confirmation, its one-time issued credential.",
  "properties": {
    "issued": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssuedToken"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "preview": {
      "$ref": "#/$defs/TokenPreview"
    }
  },
  "required": [
    "preview"
  ],
  "title": "TokenCreateResult",
  "type": "object"
}
