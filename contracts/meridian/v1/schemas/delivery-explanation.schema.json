{
  "$defs": {
    "DeliveryAction": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "kind": {
          "enum": [
            "proxy",
            "direct",
            "block",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryAction",
      "type": "object"
    },
    "DeliveryDestination": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "network": {
          "default": "tcp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Network",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "protocol": {
          "default": "other",
          "enum": [
            "other",
            "bittorrent"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "title": "DeliveryDestination",
      "type": "object"
    },
    "DeliveryPolicyOmission": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "enum": [
                "xray_individual_profiles",
                "xray_fingerprint_profiles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "exit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "profile_count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Count"
        },
        "reason": {
          "enum": [
            "rules_not_carried",
            "dns_not_carried",
            "geosite_not_supported",
            "geoip_not_supported",
            "bittorrent_not_supported",
            "dns_transport_not_supported",
            "fake_ip_not_supported",
            "exit_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "rule": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DeliveryPolicyOmission",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryAction"
        },
        {
          "type": "null"
        }
      ]
    },
    "destination": {
      "$ref": "#/$defs/DeliveryDestination"
    },
    "format": {
      "enum": [
        "browser",
        "mihomo",
        "stash",
        "singbox",
        "xray-json",
        "base64"
      ],
      "title": "Format",
      "type": "string"
    },
    "geodata_available": {
      "title": "Geodata Available",
      "type": "boolean"
    },
    "omitted": {
      "items": {
        "$ref": "#/$defs/DeliveryPolicyOmission"
      },
      "maxItems": 512,
      "title": "Omitted",
      "type": "array"
    },
    "policy": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Policy",
      "type": "string"
    },
    "reason": {
      "enum": [
        "rule_matched",
        "default_proxy",
        "geodata_unavailable",
        "port_required",
        "ip_required",
        "rules_not_carried",
        "no_connections",
        "inactive_person"
      ],
      "title": "Reason",
      "type": "string"
    },
    "rule": {
      "anyOf": [
        {
          "maximum": 133,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule"
    },
    "status": {
      "enum": [
        "matched",
        "default",
        "unknown",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "destination",
    "format",
    "policy",
    "status",
    "action",
    "reason",
    "geodata_available"
  ],
  "title": "DeliveryExplanation",
  "type": "object"
}
