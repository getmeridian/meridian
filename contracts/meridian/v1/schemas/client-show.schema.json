{
  "$defs": {
    "ClientDetail": {
      "additionalProperties": false,
      "description": "Client metadata for a detail view.",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "declared": {
          "default": true,
          "description": "False for a person added in the control service's web console rather than the fleet's reviewed intent; the CLI reads them, and the console manages them.",
          "title": "Declared",
          "type": "boolean"
        },
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None uses the fleet's default cap.",
          "title": "Device Limit"
        },
        "expires_at": {
          "description": "UTC timestamp; empty means never.",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "title": "Last Seen",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "description": "0 means unlimited.",
          "title": "Traffic Limit Bytes",
          "type": "integer"
        },
        "traffic_reset": {
          "description": "When used traffic starts again from zero: never, day, week, month, or the panel-only month_rolling (monthly from the day the client was created).",
          "title": "Traffic Reset",
          "type": "string"
        },
        "traffic_used_bytes": {
          "title": "Traffic Used Bytes",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "id",
        "status",
        "traffic_used_bytes",
        "traffic_limit_bytes",
        "traffic_reset",
        "expires_at",
        "created_at",
        "last_seen"
      ],
      "title": "ClientDetail",
      "type": "object"
    },
    "ClientHandoff": {
      "additionalProperties": false,
      "description": "Handoff links for one client: a page to open and a subscription to import.",
      "properties": {
        "share_available": {
          "title": "Share Available",
          "type": "boolean"
        },
        "share_url": {
          "default": "",
          "title": "Share Url",
          "type": "string"
        },
        "subscription_available": {
          "title": "Subscription Available",
          "type": "boolean"
        },
        "subscription_url": {
          "default": "",
          "title": "Subscription Url",
          "type": "string"
        }
      },
      "required": [
        "share_available",
        "subscription_available"
      ],
      "title": "ClientHandoff",
      "type": "object"
    },
    "UserTrafficDay": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "downlink_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Downlink Bytes",
          "type": "integer"
        },
        "uplink_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Uplink Bytes",
          "type": "integer"
        }
      },
      "required": [
        "day",
        "uplink_bytes",
        "downlink_bytes"
      ],
      "title": "UserTrafficDay",
      "type": "object"
    },
    "UserUsage": {
      "additionalProperties": false,
      "description": "UTC days, oldest first, including zero-use days; never reconstructed from lifetime totals.",
      "properties": {
        "daily": {
          "items": {
            "$ref": "#/$defs/UserTrafficDay"
          },
          "title": "Daily",
          "type": "array"
        },
        "days": {
          "description": "Days returned, including today; at most the retention cap.",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "history_days": {
          "maximum": 730,
          "minimum": 7,
          "title": "History Days",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "days",
        "history_days",
        "daily"
      ],
      "title": "UserUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result for showing one client.",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientDetail"
    },
    "handoff": {
      "$ref": "#/$defs/ClientHandoff"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The last seven UTC days, absent while daily history is off."
    }
  },
  "required": [
    "client",
    "handoff"
  ],
  "title": "ClientShowResult",
  "type": "object"
}
