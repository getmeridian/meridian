{
  "$defs": {
    "ClientDetail": {
      "additionalProperties": false,
      "description": "Client metadata for a detail view.",
      "properties": {
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "declared": {
          "default": true,
          "description": "False for a person added in the control service's web console rather than the fleet's reviewed intent; the CLI reads them, and the console manages them.",
          "title": "Declared",
          "type": "boolean"
        },
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None uses the fleet's default cap.",
          "title": "Device Limit"
        },
        "expires_at": {
          "description": "UTC timestamp; empty means never.",
          "title": "Expires At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "last_seen": {
          "title": "Last Seen",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "description": "0 means unlimited.",
          "title": "Traffic Limit Bytes",
          "type": "integer"
        },
        "traffic_reset": {
          "description": "When used traffic starts again from zero: never, day, week, month, or the panel-only month_rolling (monthly from the day the client was created).",
          "title": "Traffic Reset",
          "type": "string"
        },
        "traffic_used_bytes": {
          "title": "Traffic Used Bytes",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "id",
        "status",
        "traffic_used_bytes",
        "traffic_limit_bytes",
        "traffic_reset",
        "expires_at",
        "created_at",
        "last_seen"
      ],
      "title": "ClientDetail",
      "type": "object"
    },
    "ClientHandoff": {
      "additionalProperties": false,
      "description": "Handoff links for one client: a page to open and a subscription to import.",
      "properties": {
        "share_available": {
          "title": "Share Available",
          "type": "boolean"
        },
        "share_url": {
          "default": "",
          "title": "Share Url",
          "type": "string"
        },
        "subscription_available": {
          "title": "Subscription Available",
          "type": "boolean"
        },
        "subscription_url": {
          "default": "",
          "title": "Subscription Url",
          "type": "string"
        }
      },
      "required": [
        "share_available",
        "subscription_available"
      ],
      "title": "ClientHandoff",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result for showing one client.",
  "properties": {
    "client": {
      "$ref": "#/$defs/ClientDetail"
    },
    "handoff": {
      "$ref": "#/$defs/ClientHandoff"
    }
  },
  "required": [
    "client",
    "handoff"
  ],
  "title": "ClientShowResult",
  "type": "object"
}
