{
  "$defs": {
    "ServerConnectionDraft": {
      "additionalProperties": false,
      "description": "Unsaved server connection details collected by an onboarding UI.",
      "properties": {
        "host": {
          "anyOf": [
            {
              "format": "ipv4",
              "type": "string"
            },
            {
              "format": "ipv6",
              "type": "string"
            }
          ],
          "title": "Host"
        },
        "role_intent": {
          "default": "exit",
          "enum": [
            "exit",
            "relay"
          ],
          "title": "Role Intent",
          "type": "string"
        },
        "ssh_port": {
          "default": 22,
          "maximum": 65535,
          "minimum": 1,
          "title": "Ssh Port",
          "type": "integer"
        },
        "ssh_user": {
          "default": "root",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9._-]+$",
          "title": "Ssh User",
          "type": "string"
        },
        "title": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "host"
      ],
      "title": "ServerConnectionDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Request to validate either a saved server reference or unsaved draft details.",
  "oneOf": [
    {
      "properties": {
        "draft": {
          "type": "null"
        },
        "server_ref": {
          "minLength": 1
        }
      },
      "required": [
        "server_ref"
      ]
    },
    {
      "properties": {
        "server_ref": {
          "const": ""
        }
      },
      "required": [
        "draft"
      ]
    }
  ],
  "properties": {
    "draft": {
      "anyOf": [
        {
          "$ref": "#/$defs/ServerConnectionDraft"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "server_ref": {
      "default": "",
      "maxLength": 120,
      "pattern": "^$|^[^\\r\\n\\t]+$",
      "title": "Server Ref",
      "type": "string"
    }
  },
  "title": "ServerValidateRequest",
  "type": "object"
}
