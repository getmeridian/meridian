{
  "$defs": {
    "DeliveryAction": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "kind": {
          "enum": [
            "proxy",
            "direct",
            "block",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryAction",
      "type": "object"
    },
    "DeliveryDns": {
      "additionalProperties": false,
      "properties": {
        "fake_ip": {
          "default": false,
          "title": "Fake Ip",
          "type": "boolean"
        },
        "resolvers": {
          "items": {
            "discriminator": {
              "mapping": {
                "doh": "#/$defs/DohResolver",
                "dot": "#/$defs/DotResolver",
                "plain": "#/$defs/PlainResolver"
              },
              "propertyName": "transport"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DohResolver"
              },
              {
                "$ref": "#/$defs/DotResolver"
              },
              {
                "$ref": "#/$defs/PlainResolver"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Resolvers",
          "type": "array"
        }
      },
      "required": [
        "resolvers"
      ],
      "title": "DeliveryDns",
      "type": "object"
    },
    "DeliveryFormatCapabilities": {
      "additionalProperties": false,
      "properties": {
        "bittorrent": {
          "title": "Bittorrent",
          "type": "boolean"
        },
        "dns_transports": {
          "items": {
            "enum": [
              "doh",
              "dot",
              "plain"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Dns Transports",
          "type": "array"
        },
        "fake_ip": {
          "title": "Fake Ip",
          "type": "boolean"
        },
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "local_geodata": {
          "title": "Local Geodata",
          "type": "boolean"
        },
        "matches": {
          "items": {
            "enum": [
              "domain_suffix",
              "domain_keyword",
              "domain_full",
              "geosite",
              "geoip",
              "cidr",
              "port",
              "network"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Matches",
          "type": "array"
        },
        "via_exit": {
          "title": "Via Exit",
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "matches",
        "dns_transports",
        "fake_ip",
        "via_exit",
        "bittorrent",
        "local_geodata"
      ],
      "title": "DeliveryFormatCapabilities",
      "type": "object"
    },
    "DeliveryPolicyOmission": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "enum": [
                "xray_individual_profiles",
                "xray_fingerprint_profiles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "exit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "profile_count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Count"
        },
        "reason": {
          "enum": [
            "rules_not_carried",
            "dns_not_carried",
            "geosite_not_supported",
            "geoip_not_supported",
            "bittorrent_not_supported",
            "dns_transport_not_supported",
            "fake_ip_not_supported",
            "exit_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "rule": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DeliveryPolicyOmission",
      "type": "object"
    },
    "DeliveryPortRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start"
      ],
      "title": "DeliveryPortRange",
      "type": "object"
    },
    "DeliveryRoutePreview": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/DeliveryAction"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Domains",
          "type": "array"
        },
        "ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Ips",
          "type": "array"
        },
        "networks": {
          "items": {
            "enum": [
              "tcp",
              "udp"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Networks",
          "type": "array"
        },
        "number": {
          "maximum": 133,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "lan",
            "preset",
            "rule"
          ],
          "title": "Origin",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/DeliveryPortRange"
          },
          "maxItems": 16,
          "title": "Ports",
          "type": "array"
        },
        "protocols": {
          "items": {
            "const": "bittorrent",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Protocols",
          "type": "array"
        },
        "source_rule": {
          "anyOf": [
            {
              "maximum": 128,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Rule"
        }
      },
      "required": [
        "number",
        "origin",
        "action"
      ],
      "title": "DeliveryRoutePreview",
      "type": "object"
    },
    "DohResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "path": {
          "default": "/dns-query",
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "doh",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DohResolver",
      "type": "object"
    },
    "DotResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 853,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "dot",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DotResolver",
      "type": "object"
    },
    "PlainResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 53,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "protocol": {
          "default": "udp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "transport": {
          "const": "plain",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "PlainResolver",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/DeliveryFormatCapabilities"
    },
    "dns": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryDns"
        },
        {
          "type": "null"
        }
      ]
    },
    "dns_source": {
      "enum": [
        "preset",
        "custom",
        "omitted"
      ],
      "title": "Dns Source",
      "type": "string"
    },
    "final_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeliveryAction"
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "enum": [
        "browser",
        "mihomo",
        "stash",
        "singbox",
        "xray-json",
        "base64"
      ],
      "title": "Format",
      "type": "string"
    },
    "omitted": {
      "items": {
        "$ref": "#/$defs/DeliveryPolicyOmission"
      },
      "maxItems": 512,
      "title": "Omitted",
      "type": "array"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/DeliveryRoutePreview"
      },
      "maxItems": 133,
      "title": "Rules",
      "type": "array"
    }
  },
  "required": [
    "format",
    "capabilities",
    "rules",
    "final_action",
    "dns",
    "dns_source",
    "omitted"
  ],
  "title": "FormatDeliveryPolicy",
  "type": "object"
}
