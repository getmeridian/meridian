{
  "additionalProperties": false,
  "description": "Answers collected by a deploy wizard renderer.",
  "properties": {
    "client_name": {
      "default": "",
      "pattern": "^$|^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
      "title": "Client Name",
      "type": "string"
    },
    "color": {
      "default": "",
      "title": "Color",
      "type": "string"
    },
    "confirm": {
      "default": false,
      "title": "Confirm",
      "type": "boolean"
    },
    "domain": {
      "anyOf": [
        {
          "const": "",
          "type": "string"
        },
        {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Domain"
    },
    "geo_block": {
      "default": true,
      "title": "Geo Block",
      "type": "boolean"
    },
    "harden": {
      "default": true,
      "title": "Harden",
      "type": "boolean"
    },
    "icon": {
      "default": "",
      "title": "Icon",
      "type": "string"
    },
    "ip": {
      "anyOf": [
        {
          "format": "ipv4",
          "type": "string"
        },
        {
          "format": "ipv6",
          "type": "string"
        },
        {
          "pattern": "^$|^[Ll][Oo][Cc][Aa][Ll](?:[Ll][Yy])?$",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Ip"
    },
    "server_name": {
      "default": "",
      "title": "Server Name",
      "type": "string"
    },
    "sni": {
      "anyOf": [
        {
          "const": "",
          "type": "string"
        },
        {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Sni"
    },
    "user": {
      "default": "root",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._-]+$",
      "title": "User",
      "type": "string"
    },
    "warp": {
      "default": false,
      "title": "Warp",
      "type": "boolean"
    }
  },
  "title": "DeployWorkflowAnswers",
  "type": "object"
}
