{
  "additionalProperties": false,
  "description": "One ordered set of saved servers assigned a transparent relay path.",
  "properties": {
    "exit_ref": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Exit Ref",
      "type": "string"
    },
    "hop_server_refs": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "pattern": "^[^\\r\\n\\t]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Hop Server Refs",
      "type": "array"
    },
    "id": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "listen_port": {
      "default": 443,
      "maximum": 65535,
      "minimum": 1,
      "title": "Listen Port",
      "type": "integer"
    },
    "protocol_path_ref": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Protocol Path Ref",
      "type": "string"
    },
    "reality_sni": {
      "anyOf": [
        {
          "const": "",
          "type": "string"
        },
        {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Reality Sni"
    }
  },
  "required": [
    "id",
    "hop_server_refs",
    "exit_ref",
    "protocol_path_ref"
  ],
  "title": "SetupRelayRole",
  "type": "object"
}
