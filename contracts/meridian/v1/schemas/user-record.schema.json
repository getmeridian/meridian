{
  "$defs": {
    "PeriodTraffic": {
      "additionalProperties": false,
      "description": "Period counters; legacy traffic with no known direction is included in download.",
      "properties": {
        "download_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Download Bytes",
          "type": "integer"
        },
        "unattributed_bytes": {
          "default": 0,
          "description": "Part of download whose direction an import or an older reset did not retain.",
          "minimum": 0,
          "title": "Unattributed Bytes",
          "type": "integer"
        },
        "upload_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Upload Bytes",
          "type": "integer"
        }
      },
      "title": "PeriodTraffic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One access user as the service stores it.\n\nThe operator sets `active` or `disabled`; the service's enforcement turns an\nactive user `expired` once `expire_at` passes and `limited` at the traffic limit,\nand back once a change or a new traffic period lifts it.",
  "properties": {
    "created_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Created At",
      "type": "string"
    },
    "device_limit": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None uses the fleet's default cap.",
      "title": "Device Limit"
    },
    "expire_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expire At"
    },
    "first_traffic_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the service first accepted traffic growth; unknown for historical use.",
      "title": "First Traffic At"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "en",
            "ru",
            "fa",
            "zh"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Starting connection/support page and app status language; null follows the fleet.",
      "title": "Language"
    },
    "last_traffic_node": {
      "anyOf": [
        {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The node whose latest accepted growth set the user's last traffic time.",
      "title": "Last Traffic Node"
    },
    "lifetime_traffic_bytes": {
      "default": 0,
      "description": "What agents counted plus what an import carried in from before.",
      "minimum": 0,
      "title": "Lifetime Traffic Bytes",
      "type": "integer"
    },
    "note": {
      "default": "",
      "description": "Private operator note; people/admin only.",
      "maxLength": 500,
      "title": "Note",
      "type": "string"
    },
    "online_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When an agent last counted the user's traffic.",
      "title": "Online At"
    },
    "period_traffic": {
      "$ref": "#/$defs/PeriodTraffic"
    },
    "status": {
      "enum": [
        "active",
        "disabled",
        "limited",
        "expired"
      ],
      "title": "Status",
      "type": "string"
    },
    "sub_token": {
      "title": "Sub Token",
      "type": "string"
    },
    "tag": {
      "default": "",
      "description": "Private operator tag; people/admin only.",
      "pattern": "^[A-Z0-9_]{0,16}$",
      "title": "Tag",
      "type": "string"
    },
    "traffic_limit_bytes": {
      "default": 0,
      "description": "0 means unlimited.",
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Traffic Limit Bytes",
      "type": "integer"
    },
    "traffic_limit_strategy": {
      "default": "no_reset",
      "enum": [
        "no_reset",
        "day",
        "week",
        "month"
      ],
      "title": "Traffic Limit Strategy",
      "type": "string"
    },
    "traffic_reset_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the current traffic period began.",
      "title": "Traffic Reset At"
    },
    "used_traffic_bytes": {
      "default": 0,
      "description": "Traffic since the period began.",
      "minimum": 0,
      "title": "Used Traffic Bytes",
      "type": "integer"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    },
    "username": {
      "title": "Username",
      "type": "string"
    },
    "uuid": {
      "title": "Uuid",
      "type": "string"
    }
  },
  "required": [
    "username",
    "user_id",
    "uuid",
    "sub_token",
    "status",
    "created_at"
  ],
  "title": "UserRecord",
  "type": "object"
}
