{
  "$defs": {
    "AccessIntent": {
      "additionalProperties": false,
      "description": "Meridian-owned access squad and human users.",
      "properties": {
        "squad_name": {
          "default": "Meridian Access",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Squad Name",
          "type": "string"
        },
        "users": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Users",
          "type": "array"
        }
      },
      "required": [
        "users"
      ],
      "title": "AccessIntent",
      "type": "object"
    },
    "DeliveryIntent": {
      "additionalProperties": false,
      "description": "Canonical Remnawave subscription presentation settings.",
      "properties": {
        "formats": {
          "items": {
            "enum": [
              "base64",
              "xray_json",
              "mihomo"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "profile_title": {
          "default": "Meridian",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Profile Title",
          "type": "string"
        },
        "template_name": {
          "default": "meridian",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
          "title": "Template Name",
          "type": "string"
        }
      },
      "title": "DeliveryIntent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Human access and canonical subscription delivery choices.",
  "properties": {
    "access": {
      "$ref": "#/$defs/AccessIntent"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryIntent"
    }
  },
  "required": [
    "access"
  ],
  "title": "SetupAccessSelection",
  "type": "object"
}
