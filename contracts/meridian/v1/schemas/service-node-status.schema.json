{
  "$defs": {
    "HealthCheck": {
      "additionalProperties": false,
      "description": "One local health probe (for example `xray`, `nginx`, `disk`).",
      "properties": {
        "message": {
          "description": "Operator-facing text. Never carries secrets, client addresses, or raw command lines.",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "HealthCheck",
      "type": "object"
    },
    "NodeHealth": {
      "additionalProperties": false,
      "description": "Aggregate node health. Resource figures are integers to keep the protocol float-free.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/HealthCheck"
          },
          "maxItems": 32,
          "title": "Checks",
          "type": "array"
        },
        "disk_free_bytes": {
          "description": "Free bytes on the filesystem holding the agent's state.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Disk Free Bytes",
          "type": "integer"
        },
        "load1_milli": {
          "description": "One-minute load average times 1000.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Load1 Milli",
          "type": "integer"
        },
        "memory_available_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Memory Available Bytes",
          "type": "integer"
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ],
          "title": "Status",
          "type": "string"
        },
        "uptime_seconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Uptime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "checks",
        "uptime_seconds",
        "load1_milli",
        "memory_available_bytes",
        "disk_free_bytes"
      ],
      "title": "NodeHealth",
      "type": "object"
    },
    "NodeRuntime": {
      "additionalProperties": false,
      "description": "Runtime evidence from one agent report; polls refresh reachability, never this evidence.",
      "properties": {
        "health": {
          "$ref": "#/$defs/NodeHealth"
        },
        "observed_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Observed At",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/NodeVersions"
        }
      },
      "required": [
        "health",
        "versions",
        "observed_at"
      ],
      "title": "NodeRuntime",
      "type": "object"
    },
    "NodeStateRef": {
      "additionalProperties": false,
      "description": "Points at one desired-state document by epoch, revision, and content hash.",
      "properties": {
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "revision": {
          "description": "Desired-state revision for one node. Ordering is (fleet_epoch, revision): within an epoch revisions only grow; a higher epoch wins even with a lower revision.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "description": "The document's `sha256` (hash of its `resources`).",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "fleet_epoch",
        "revision",
        "sha256"
      ],
      "title": "NodeStateRef",
      "type": "object"
    },
    "NodeVersions": {
      "additionalProperties": false,
      "description": "Versions of what runs on the node; `null` for software that is not installed.",
      "properties": {
        "agent": {
          "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "title": "Agent",
          "type": "string"
        },
        "kernel": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+~-]+$",
          "title": "Kernel",
          "type": "string"
        },
        "nginx": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nginx"
        },
        "os_id": {
          "description": "`ID` from /etc/os-release.",
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$",
          "title": "Os Id",
          "type": "string"
        },
        "os_version": {
          "description": "`VERSION_ID`.",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]*$",
          "title": "Os Version",
          "type": "string"
        },
        "realm": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Realm"
        },
        "xray": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Xray"
        }
      },
      "required": [
        "agent",
        "xray",
        "realm",
        "nginx",
        "os_id",
        "os_version",
        "kernel"
      ],
      "title": "NodeVersions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The service's view of one node.",
  "properties": {
    "active_report_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The last report's collection window time.",
      "title": "Active Report At"
    },
    "active_report_received_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "When the service accepted that report; duplicates leave it unchanged.",
      "title": "Active Report Received At"
    },
    "active_users": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "People with accepted growth in the last report; null before any report.",
      "title": "Active Users"
    },
    "agent_version": {
      "anyOf": [
        {
          "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Agent Version"
    },
    "applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeStateRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "errors": {
      "description": "Operator-facing messages of failed resources.",
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "failed": {
      "description": "Resource IDs the last report marked failed.",
      "items": {
        "type": "string"
      },
      "title": "Failed",
      "type": "array"
    },
    "fleet_epoch": {
      "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
      "maximum": 9007199254740991,
      "minimum": 1,
      "title": "Fleet Epoch",
      "type": "integer"
    },
    "last_seen_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Seen At"
    },
    "node_id": {
      "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Node Id",
      "type": "string"
    },
    "revision": {
      "anyOf": [
        {
          "description": "Desired-state revision for one node. Ordering is (fleet_epoch, revision): within an epoch revisions only grow; a higher epoch wins even with a lower revision.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Revision"
    },
    "runtime": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeRuntime"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The last report's health and version evidence."
    },
    "sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sha256"
    },
    "spec_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Hash of the last `NodeSpec` the deployer stored.",
      "title": "Spec Sha256"
    },
    "traffic_bytes": {
      "default": 0,
      "description": "Durable accepted upload plus download bytes across counter epochs, including retained backfill.",
      "minimum": 0,
      "title": "Traffic Bytes",
      "type": "integer"
    },
    "traffic_counting_since": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Complete durable node accounting starts here. Retained counters from before a migration may also be included; earlier pruned traffic cannot be reconstructed.",
      "title": "Traffic Counting Since"
    }
  },
  "required": [
    "node_id",
    "fleet_epoch",
    "revision",
    "sha256",
    "spec_sha256",
    "applied",
    "last_seen_at",
    "agent_version"
  ],
  "title": "NodeStatus",
  "type": "object"
}
