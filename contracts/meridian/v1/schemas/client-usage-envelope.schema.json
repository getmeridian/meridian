{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "UserTrafficDay": {
      "additionalProperties": false,
      "properties": {
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        },
        "downlink_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Downlink Bytes",
          "type": "integer"
        },
        "uplink_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Uplink Bytes",
          "type": "integer"
        }
      },
      "required": [
        "day",
        "uplink_bytes",
        "downlink_bytes"
      ],
      "title": "UserTrafficDay",
      "type": "object"
    },
    "UserUsage": {
      "additionalProperties": false,
      "description": "UTC days, oldest first, including zero-use days; never reconstructed from lifetime totals.",
      "properties": {
        "daily": {
          "items": {
            "$ref": "#/$defs/UserTrafficDay"
          },
          "title": "Daily",
          "type": "array"
        },
        "days": {
          "description": "Days returned, including today; at most the retention cap.",
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "history_days": {
          "maximum": 730,
          "minimum": 7,
          "title": "History Days",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "days",
        "history_days",
        "daily"
      ],
      "title": "UserUsage",
      "type": "object"
    },
    "_ClientUsageSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "client.usage",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/UserUsage"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ClientUsageSuccessEnvelope",
      "type": "object"
    },
    "_ClientUsageTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "client.usage",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ClientUsageTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian client usage --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_ClientUsageTerminalEnvelope",
      "ok": "#/$defs/_ClientUsageSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ClientUsageSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ClientUsageTerminalEnvelope"
    }
  ],
  "title": "ClientUsageOutputEnvelope"
}
