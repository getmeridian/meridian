{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "FleetStatusNode": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "is_panel_host": {
          "title": "Is Panel Host",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "exit",
          "enum": [
            "exit",
            "routing_gateway"
          ],
          "title": "Role",
          "type": "string"
        },
        "status": {
          "enum": [
            "connected",
            "disconnected",
            "disabled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "traffic_bytes": {
          "title": "Traffic Bytes",
          "type": "integer"
        },
        "uuid": {
          "title": "Uuid",
          "type": "string"
        },
        "xray_version": {
          "title": "Xray Version",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "name",
        "uuid",
        "is_panel_host",
        "status",
        "xray_version",
        "traffic_bytes"
      ],
      "title": "FleetStatusNode",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "NodeListResult": {
      "additionalProperties": false,
      "description": "Result for listing configured nodes with live panel status.",
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/FleetStatusNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "title": "NodeListResult",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_NodeListSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "node.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/NodeListResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_NodeListSuccessEnvelope",
      "type": "object"
    },
    "_NodeListTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "node.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_NodeListTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian --json node list`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_NodeListTerminalEnvelope",
      "ok": "#/$defs/_NodeListSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_NodeListSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_NodeListTerminalEnvelope"
    }
  ],
  "title": "NodeListOutputEnvelope"
}
