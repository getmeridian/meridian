{
  "$defs": {
    "ServerMetadataChange": {
      "additionalProperties": false,
      "description": "Only explicitly set fields change; null clears an allowance, payment date, or repeat.",
      "properties": {
        "allowance_bytes": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowance Bytes"
        },
        "pay_every": {
          "anyOf": [
            {
              "enum": [
                "month",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay Every"
        },
        "pay_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay On"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "reset_day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reset Day"
        }
      },
      "title": "ServerMetadataChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "change": {
      "$ref": "#/$defs/ServerMetadataChange"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "query": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Query",
      "type": "string"
    },
    "yes": {
      "default": false,
      "title": "Yes",
      "type": "boolean"
    }
  },
  "required": [
    "query",
    "change"
  ],
  "title": "ServerSetRequest",
  "type": "object"
}
