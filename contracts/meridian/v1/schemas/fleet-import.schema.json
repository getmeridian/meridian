{
  "$defs": {
    "AccessChange": {
      "additionalProperties": false,
      "properties": {
        "gained": {
          "items": {
            "type": "string"
          },
          "title": "Gained",
          "type": "array"
        },
        "lost": {
          "items": {
            "type": "string"
          },
          "title": "Lost",
          "type": "array"
        },
        "profiles": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "profiles",
        "gained",
        "lost"
      ],
      "title": "AccessChange",
      "type": "object"
    },
    "AccessProfileReview": {
      "additionalProperties": false,
      "properties": {
        "access_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Hash",
          "type": "string"
        },
        "access_profiles": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "items": {
                "pattern": "^inbound:[a-z0-9][a-z0-9:_.-]{0,191}$",
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 48,
            "minLength": 1
          },
          "title": "Access Profiles",
          "type": "object"
        },
        "cut_off": {
          "$ref": "#/$defs/CutOffPlan"
        },
        "gained_people": {
          "minimum": 0,
          "title": "Gained People",
          "type": "integer"
        },
        "lost_people": {
          "minimum": 0,
          "title": "Lost People",
          "type": "integer"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/AccessChange"
          },
          "title": "People",
          "type": "array"
        }
      },
      "required": [
        "access_hash",
        "access_profiles",
        "people",
        "gained_people",
        "lost_people",
        "cut_off"
      ],
      "title": "AccessProfileReview",
      "type": "object"
    },
    "ApplyCounts": {
      "additionalProperties": false,
      "description": "Aggregate counts for apply execution.",
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "actions",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "ApplyCounts",
      "type": "object"
    },
    "CompiledApplyActionResult": {
      "additionalProperties": false,
      "description": "Execution result for one V4 compiler resource.",
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "converged",
            "applied",
            "failed",
            "unknown",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "resource_id",
        "status",
        "success",
        "changed"
      ],
      "title": "CompiledApplyActionResult",
      "type": "object"
    },
    "CompiledApplyPreview": {
      "additionalProperties": false,
      "description": "Reviewed V4 compiler-plan metadata returned before confirmation.",
      "properties": {
        "access_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessProfileReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "people_adoption": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeopleAdoptionNotice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "resource_count": {
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        },
        "retiring_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retiring Resources",
          "type": "array"
        },
        "review_hash": {
          "default": "",
          "description": "Plan hash bound to the exact retirement set; equals plan_hash when nothing is removed.",
          "title": "Review Hash",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "resource_count"
      ],
      "title": "CompiledApplyPreview",
      "type": "object"
    },
    "CompiledApplyResult": {
      "additionalProperties": false,
      "description": "Apply result for one generation-scoped V4 compiler plan.",
      "properties": {
        "access_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessProfileReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/CompiledApplyActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "all_succeeded": {
          "title": "All Succeeded",
          "type": "boolean"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/ApplyCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "people_adoption": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeopleAdoptionNotice"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "retired_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retired Resources",
          "type": "array"
        },
        "retirement_errors": {
          "items": {
            "type": "string"
          },
          "title": "Retirement Errors",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "generation",
        "all_succeeded",
        "changed",
        "summary",
        "exit_code",
        "counts"
      ],
      "title": "CompiledApplyResult",
      "type": "object"
    },
    "CutOffNode": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "default": "inbound_reset",
          "description": "A core restart reconnects every Xray inbound and bridge on this node; an inbound reset reconnects the listed inbounds, with whole-core fallback on failure.",
          "enum": [
            "inbound_reset",
            "core_restart"
          ],
          "title": "Effect",
          "type": "string"
        },
        "inbound_tags": {
          "items": {
            "description": "Xray inbound tag.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Inbound Tags",
          "type": "array"
        },
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "inbound_tags"
      ],
      "title": "CutOffNode",
      "type": "object"
    },
    "CutOffPlan": {
      "additionalProperties": false,
      "description": "Every managed inbound that may hold the person's open sessions; contains no person or credential.",
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/CutOffNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "CutOffPlan",
      "type": "object"
    },
    "IntentChange": {
      "additionalProperties": false,
      "description": "One difference between the fleet and an imported document, in document terms.\n\n``subject`` is the kind of thing (client, exit, path, route, relay, gateway, pool,\nrule, control, access, delivery, fleet); ``target`` names it; a ``change`` also\nnames the ``field`` and its rendered ``before`` and ``after`` values.",
      "properties": {
        "action": {
          "enum": [
            "add",
            "change",
            "remove"
          ],
          "title": "Action",
          "type": "string"
        },
        "after": {
          "default": "",
          "title": "After",
          "type": "string"
        },
        "before": {
          "default": "",
          "title": "Before",
          "type": "string"
        },
        "field": {
          "default": "",
          "title": "Field",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "action",
        "subject",
        "target"
      ],
      "title": "IntentChange",
      "type": "object"
    },
    "PeopleAdoptionNotice": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "people": {
          "minimum": 0,
          "title": "People",
          "type": "integer"
        }
      },
      "required": [
        "people",
        "message"
      ],
      "title": "PeopleAdoptionNotice",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`meridian fleet import`: what the file changes, its review, and the apply when it ran.",
  "properties": {
    "access_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/AccessProfileReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompiledApplyResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/IntentChange"
      },
      "title": "Changes",
      "type": "array"
    },
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "review": {
      "anyOf": [
        {
          "$ref": "#/$defs/CompiledApplyPreview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "title": "FleetImportResult",
  "type": "object"
}
