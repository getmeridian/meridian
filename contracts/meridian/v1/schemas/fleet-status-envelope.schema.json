{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by failed or cancelled envelopes.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "FleetSources": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "not_requested",
            "unknown"
          ],
          "title": "Nodes",
          "type": "string"
        },
        "panel": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "not_requested",
            "unknown"
          ],
          "title": "Panel",
          "type": "string"
        },
        "relays": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "not_requested",
            "unknown"
          ],
          "title": "Relays",
          "type": "string"
        },
        "users": {
          "default": "unknown",
          "enum": [
            "available",
            "unavailable",
            "not_requested",
            "unknown"
          ],
          "title": "Users",
          "type": "string"
        }
      },
      "title": "FleetSources",
      "type": "object"
    },
    "FleetStatus": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/FleetStatusNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "panel": {
          "$ref": "#/$defs/PanelStatus"
        },
        "relays": {
          "items": {
            "$ref": "#/$defs/FleetStatusRelay"
          },
          "title": "Relays",
          "type": "array"
        },
        "servers": {
          "items": {
            "$ref": "#/$defs/ServerInventory"
          },
          "title": "Servers",
          "type": "array"
        },
        "sources": {
          "$ref": "#/$defs/FleetSources"
        },
        "summary": {
          "$ref": "#/$defs/FleetStatusSummary"
        }
      },
      "required": [
        "panel",
        "summary"
      ],
      "title": "FleetStatus",
      "type": "object"
    },
    "FleetStatusNode": {
      "additionalProperties": false,
      "properties": {
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "is_panel_host": {
          "title": "Is Panel Host",
          "type": "boolean"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "connected",
            "disconnected",
            "disabled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "traffic_bytes": {
          "title": "Traffic Bytes",
          "type": "integer"
        },
        "uuid": {
          "title": "Uuid",
          "type": "string"
        },
        "xray_version": {
          "title": "Xray Version",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "name",
        "uuid",
        "is_panel_host",
        "status",
        "xray_version",
        "traffic_bytes"
      ],
      "title": "FleetStatusNode",
      "type": "object"
    },
    "FleetStatusRelay": {
      "additionalProperties": false,
      "properties": {
        "exit_node_ip": {
          "title": "Exit Node Ip",
          "type": "string"
        },
        "exit_node_name": {
          "title": "Exit Node Name",
          "type": "string"
        },
        "health": {
          "enum": [
            "healthy",
            "unhealthy",
            "unknown"
          ],
          "title": "Health",
          "type": "string"
        },
        "healthy": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Healthy"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        }
      },
      "required": [
        "ip",
        "name",
        "port",
        "exit_node_ip",
        "exit_node_name",
        "health",
        "healthy"
      ],
      "title": "FleetStatusRelay",
      "type": "object"
    },
    "FleetStatusSummary": {
      "additionalProperties": false,
      "properties": {
        "active_users": {
          "title": "Active Users",
          "type": "integer"
        },
        "connected_nodes": {
          "title": "Connected Nodes",
          "type": "integer"
        },
        "disabled_nodes": {
          "title": "Disabled Nodes",
          "type": "integer"
        },
        "disabled_users": {
          "title": "Disabled Users",
          "type": "integer"
        },
        "disconnected_nodes": {
          "title": "Disconnected Nodes",
          "type": "integer"
        },
        "health": {
          "enum": [
            "healthy",
            "degraded",
            "unknown"
          ],
          "title": "Health",
          "type": "string"
        },
        "needs_attention": {
          "title": "Needs Attention",
          "type": "boolean"
        },
        "nodes": {
          "title": "Nodes",
          "type": "integer"
        },
        "other_users": {
          "title": "Other Users",
          "type": "integer"
        },
        "relays": {
          "title": "Relays",
          "type": "integer"
        },
        "unhealthy_relays": {
          "title": "Unhealthy Relays",
          "type": "integer"
        },
        "unknown_nodes": {
          "title": "Unknown Nodes",
          "type": "integer"
        },
        "users": {
          "title": "Users",
          "type": "integer"
        }
      },
      "required": [
        "health",
        "needs_attention",
        "nodes",
        "relays",
        "users",
        "active_users",
        "disabled_users",
        "other_users",
        "connected_nodes",
        "disconnected_nodes",
        "disabled_nodes",
        "unknown_nodes",
        "unhealthy_relays"
      ],
      "title": "FleetStatusSummary",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "PanelStatus": {
      "additionalProperties": false,
      "properties": {
        "healthy": {
          "title": "Healthy",
          "type": "boolean"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "healthy"
      ],
      "title": "PanelStatus",
      "type": "object"
    },
    "ServerInventory": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "roles": {
          "items": {
            "enum": [
              "panel",
              "exit",
              "relay"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "ssh_port": {
          "title": "Ssh Port",
          "type": "integer"
        },
        "ssh_user": {
          "title": "Ssh User",
          "type": "string"
        }
      },
      "required": [
        "id",
        "ip",
        "name",
        "roles",
        "ssh_user",
        "ssh_port"
      ],
      "title": "ServerInventory",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetStatusSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.status",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FleetStatus"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetStatusSuccessEnvelope",
      "type": "object"
    },
    "_FleetStatusTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.status",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetStatusTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet status --json`.",
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/_FleetStatusTerminalEnvelope",
      "failed": "#/$defs/_FleetStatusTerminalEnvelope",
      "ok": "#/$defs/_FleetStatusSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetStatusSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetStatusTerminalEnvelope"
    }
  ],
  "title": "FleetStatusOutputEnvelope"
}
