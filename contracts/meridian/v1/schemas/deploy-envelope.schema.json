{
  "$defs": {
    "DeployPlan": {
      "additionalProperties": false,
      "description": "Core-owned deploy plan consumed by provisioning and panel adapters.",
      "properties": {
        "info_page_path": {
          "title": "Info Page Path",
          "type": "string"
        },
        "mode": {
          "enum": [
            "first_deploy",
            "redeploy"
          ],
          "title": "Mode",
          "type": "string"
        },
        "node_count": {
          "title": "Node Count",
          "type": "integer"
        },
        "ports": {
          "$ref": "#/$defs/DeployPorts"
        },
        "relay_count": {
          "title": "Relay Count",
          "type": "integer"
        },
        "secret_path": {
          "title": "Secret Path",
          "type": "string"
        },
        "server_ip": {
          "title": "Server Ip",
          "type": "string"
        },
        "ws_path": {
          "title": "Ws Path",
          "type": "string"
        },
        "xhttp_path": {
          "title": "Xhttp Path",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "server_ip",
        "ports",
        "secret_path",
        "xhttp_path",
        "ws_path",
        "info_page_path",
        "node_count",
        "relay_count"
      ],
      "title": "DeployPlan",
      "type": "object"
    },
    "DeployPorts": {
      "additionalProperties": false,
      "description": "Deterministic per-node port layout.",
      "properties": {
        "reality_port": {
          "title": "Reality Port",
          "type": "integer"
        },
        "wss_port": {
          "title": "Wss Port",
          "type": "integer"
        },
        "xhttp_port": {
          "title": "Xhttp Port",
          "type": "integer"
        }
      },
      "required": [
        "xhttp_port",
        "reality_port",
        "wss_port"
      ],
      "title": "DeployPorts",
      "type": "object"
    },
    "DeployResult": {
      "additionalProperties": false,
      "description": "Result returned after a deploy/redeploy operation completes.",
      "properties": {
        "client_name": {
          "title": "Client Name",
          "type": "string"
        },
        "connection_page_path": {
          "title": "Connection Page Path",
          "type": "string"
        },
        "domain": {
          "title": "Domain",
          "type": "string"
        },
        "geo_block": {
          "title": "Geo Block",
          "type": "boolean"
        },
        "harden": {
          "title": "Harden",
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "first_deploy",
            "redeploy"
          ],
          "title": "Mode",
          "type": "string"
        },
        "node_count": {
          "title": "Node Count",
          "type": "integer"
        },
        "panel_secret_path": {
          "title": "Panel Secret Path",
          "type": "string"
        },
        "panel_url": {
          "title": "Panel Url",
          "type": "string"
        },
        "pq": {
          "title": "Pq",
          "type": "boolean"
        },
        "relay_count": {
          "title": "Relay Count",
          "type": "integer"
        },
        "server_ip": {
          "title": "Server Ip",
          "type": "string"
        },
        "sni": {
          "title": "Sni",
          "type": "string"
        },
        "ssh_port": {
          "title": "Ssh Port",
          "type": "integer"
        },
        "ssh_user": {
          "title": "Ssh User",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "warp": {
          "title": "Warp",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "server_ip",
        "ssh_user",
        "ssh_port",
        "domain",
        "sni",
        "client_name",
        "harden",
        "pq",
        "warp",
        "geo_block",
        "panel_url",
        "panel_secret_path",
        "connection_page_path",
        "node_count",
        "relay_count",
        "summary"
      ],
      "title": "DeployResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by failed or cancelled envelopes.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_DeployChangedEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "deploy",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DeployResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "changed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_DeployChangedEnvelope",
      "type": "object"
    },
    "_DeployPlanEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "deploy",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/DeployPlan"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_DeployPlanEnvelope",
      "type": "object"
    },
    "_DeployTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "deploy",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_DeployTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian deploy --json`.",
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/_DeployTerminalEnvelope",
      "changed": "#/$defs/_DeployChangedEnvelope",
      "failed": "#/$defs/_DeployTerminalEnvelope",
      "ok": "#/$defs/_DeployPlanEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_DeployChangedEnvelope"
    },
    {
      "$ref": "#/$defs/_DeployPlanEnvelope"
    },
    {
      "$ref": "#/$defs/_DeployTerminalEnvelope"
    }
  ],
  "title": "DeployOutputEnvelope"
}
