          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "inbound_tags"
      ],
      "title": "CutOffNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
