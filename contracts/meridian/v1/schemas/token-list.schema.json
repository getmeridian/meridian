{
  "$defs": {
    "TokenRecord": {
      "additionalProperties": false,
      "description": "One API token's metadata; never its secret, hash, or where it was used from.",
      "properties": {
        "created_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "id": {
          "pattern": "^[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "last_used_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Coarse: updated at most once a minute.",
          "title": "Last Used At"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "revoked_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revoked At"
        },
        "scope": {
          "enum": [
            "read",
            "propose",
            "approve",
            "people",
            "admin"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "scope",
        "created_at"
      ],
      "title": "TokenRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "tokens": {
      "items": {
        "$ref": "#/$defs/TokenRecord"
      },
      "title": "Tokens",
      "type": "array"
    }
  },
  "required": [
    "tokens"
  ],
  "title": "TokenList",
  "type": "object"
}
