{
  "$defs": {
    "ApplyCounts": {
      "additionalProperties": false,
      "description": "Aggregate counts for apply execution.",
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "actions",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "ApplyCounts",
      "type": "object"
    },
    "CompiledApplyActionResult": {
      "additionalProperties": false,
      "description": "Execution result for one V4 compiler resource.",
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "converged",
            "applied",
            "failed",
            "unknown",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "resource_id",
        "status",
        "success",
        "changed"
      ],
      "title": "CompiledApplyActionResult",
      "type": "object"
    },
    "CompiledApplyPreview": {
      "additionalProperties": false,
      "description": "Reviewed V4 compiler-plan metadata returned before confirmation.",
      "properties": {
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "resource_count": {
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        },
        "retiring_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retiring Resources",
          "type": "array"
        },
        "review_hash": {
          "default": "",
          "description": "Plan hash bound to the exact retirement set; equals plan_hash when nothing is removed.",
          "title": "Review Hash",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "resource_count"
      ],
      "title": "CompiledApplyPreview",
      "type": "object"
    },
    "CompiledApplyResult": {
      "additionalProperties": false,
      "description": "Apply result for one generation-scoped V4 compiler plan.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/CompiledApplyActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "all_succeeded": {
          "title": "All Succeeded",
          "type": "boolean"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/ApplyCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "retired_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retired Resources",
          "type": "array"
        },
        "retirement_errors": {
          "items": {
            "type": "string"
          },
          "title": "Retirement Errors",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "generation",
        "all_succeeded",
        "changed",
        "summary",
        "exit_code",
        "counts"
      ],
      "title": "CompiledApplyResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "FleetContactResult": {
      "additionalProperties": false,
      "properties": {
        "applied": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledApplyResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "owner_contact": {
          "$ref": "#/$defs/OwnerContact"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledApplyPreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "owner_contact"
      ],
      "title": "FleetContactResult",
      "type": "object"
    },
    "OwnerContact": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "default": "",
          "maxLength": 2048,
          "pattern": "^(?:|https://[^\\s]+|tg://[^\\s]+|mailto:[^\\s]+)$",
          "title": "Link",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "OwnerContact",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetContactSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.contact",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FleetContactResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "changed",
            "no_changes"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetContactSuccessEnvelope",
      "type": "object"
    },
    "_FleetContactTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.contact",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetContactTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet contact --json`.",
  "discriminator": {
    "mapping": {
      "changed": "#/$defs/_FleetContactSuccessEnvelope",
      "failed": "#/$defs/_FleetContactTerminalEnvelope",
      "no_changes": "#/$defs/_FleetContactSuccessEnvelope",
      "ok": "#/$defs/_FleetContactSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetContactSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetContactTerminalEnvelope"
    }
  ],
  "title": "FleetContactOutputEnvelope"
}
