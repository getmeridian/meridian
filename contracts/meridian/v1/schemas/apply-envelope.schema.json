{
  "$defs": {
    "ApplyActionResult": {
      "additionalProperties": false,
      "description": "Execution result for one plan action.",
      "properties": {
        "action": {
          "$ref": "#/$defs/PlanActionResult"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "status",
        "success"
      ],
      "title": "ApplyActionResult",
      "type": "object"
    },
    "ApplyCommandData": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplyResult"
        },
        {
          "$ref": "#/$defs/CompiledApplyResult"
        }
      ],
      "description": "Success data returned by legacy and V4 apply execution.",
      "title": "ApplyCommandData"
    },
    "ApplyCounts": {
      "additionalProperties": false,
      "description": "Aggregate counts for apply execution.",
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "actions",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "ApplyCounts",
      "type": "object"
    },
    "ApplyResult": {
      "additionalProperties": false,
      "description": "Final apply result for process/API clients.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/ApplyActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "all_succeeded": {
          "title": "All Succeeded",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/ApplyCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "plan": {
          "$ref": "#/$defs/PlanResult"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "all_succeeded",
        "summary",
        "exit_code",
        "plan",
        "counts"
      ],
      "title": "ApplyResult",
      "type": "object"
    },
    "CompiledApplyActionResult": {
      "additionalProperties": false,
      "description": "Execution result for one V4 compiler resource.",
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "converged",
            "applied",
            "failed",
            "unknown",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "resource_id",
        "status",
        "success",
        "changed"
      ],
      "title": "CompiledApplyActionResult",
      "type": "object"
    },
    "CompiledApplyPreview": {
      "additionalProperties": false,
      "description": "Reviewed V4 compiler-plan metadata returned before confirmation.",
      "properties": {
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "resource_count": {
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        }
      },
      "required": [
        "plan_hash",
        "resource_count"
      ],
      "title": "CompiledApplyPreview",
      "type": "object"
    },
    "CompiledApplyResult": {
      "additionalProperties": false,
      "description": "Apply result for one generation-scoped V4 compiler plan.",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/CompiledApplyActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "all_succeeded": {
          "title": "All Succeeded",
          "type": "boolean"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/ApplyCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "generation",
        "all_succeeded",
        "changed",
        "summary",
        "exit_code",
        "counts"
      ],
      "title": "CompiledApplyResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by failed or cancelled envelopes.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "PlanActionResult": {
      "additionalProperties": false,
      "properties": {
        "can_run_parallel": {
          "default": false,
          "title": "Can Run Parallel",
          "type": "boolean"
        },
        "change_set": {
          "items": {
            "$ref": "#/$defs/PlanChange"
          },
          "title": "Change Set",
          "type": "array"
        },
        "destructive": {
          "title": "Destructive",
          "type": "boolean"
        },
        "destructive_reason": {
          "title": "Destructive Reason",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "execution_order": {
          "title": "Execution Order",
          "type": "integer"
        },
        "from_extras": {
          "title": "From Extras",
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "add_node",
            "update_node",
            "remove_node",
            "add_client",
            "remove_client",
            "add_relay",
            "update_relay",
            "remove_relay",
            "add_subscription_page",
            "remove_subscription_page"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation": {
          "enum": [
            "add",
            "update",
            "remove",
            "replace"
          ],
          "title": "Operation",
          "type": "string"
        },
        "phase": {
          "enum": [
            "provision",
            "configure",
            "deprovision",
            "replace"
          ],
          "title": "Phase",
          "type": "string"
        },
        "plan_index": {
          "title": "Plan Index",
          "type": "integer"
        },
        "replacement": {
          "title": "Replacement",
          "type": "boolean"
        },
        "replacement_strategy": {
          "enum": [
            "none",
            "delete_then_create"
          ],
          "title": "Replacement Strategy",
          "type": "string"
        },
        "requires_confirmation": {
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "node",
            "client",
            "relay",
            "subscription_page"
          ],
          "title": "Resource Type",
          "type": "string"
        },
        "symbol": {
          "enum": [
            "+",
            "~",
            "-"
          ],
          "title": "Symbol",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "plan_index",
        "execution_order",
        "kind",
        "operation",
        "resource_type",
        "resource_id",
        "target",
        "detail",
        "destructive",
        "replacement",
        "replacement_strategy",
        "from_extras",
        "phase",
        "requires_confirmation",
        "destructive_reason",
        "symbol"
      ],
      "title": "PlanActionResult",
      "type": "object"
    },
    "PlanChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "title": "After",
          "type": "string"
        },
        "before": {
          "title": "Before",
          "type": "string"
        },
        "field": {
          "title": "Field",
          "type": "string"
        }
      },
      "required": [
        "field",
        "before",
        "after"
      ],
      "title": "PlanChange",
      "type": "object"
    },
    "PlanCounts": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "adds": {
          "title": "Adds",
          "type": "integer"
        },
        "destructive": {
          "title": "Destructive",
          "type": "integer"
        },
        "from_extras": {
          "title": "From Extras",
          "type": "integer"
        },
        "removes": {
          "title": "Removes",
          "type": "integer"
        },
        "replacements": {
          "title": "Replacements",
          "type": "integer"
        },
        "updates": {
          "title": "Updates",
          "type": "integer"
        }
      },
      "required": [
        "actions",
        "adds",
        "updates",
        "replacements",
        "removes",
        "destructive",
        "from_extras"
      ],
      "title": "PlanCounts",
      "type": "object"
    },
    "PlanResult": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/$defs/PlanActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "converged": {
          "title": "Converged",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/PlanCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "converged",
        "summary",
        "exit_code",
        "counts"
      ],
      "title": "PlanResult",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ApplySuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "apply",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ApplyCommandData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "changed",
            "no_changes"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApplySuccessEnvelope",
      "type": "object"
    },
    "_ApplyTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "apply",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApplyResult"
            },
            {
              "$ref": "#/$defs/CompiledApplyResult"
            },
            {
              "$ref": "#/$defs/CompiledApplyPreview"
            },
            {
              "$ref": "#/$defs/EmptyData"
            }
          ],
          "title": "Data"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApplyTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian apply --json`.",
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/_ApplyTerminalEnvelope",
      "changed": "#/$defs/_ApplySuccessEnvelope",
      "failed": "#/$defs/_ApplyTerminalEnvelope",
      "no_changes": "#/$defs/_ApplySuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ApplySuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ApplyTerminalEnvelope"
    }
  ],
  "title": "ApplyOutputEnvelope"
}
