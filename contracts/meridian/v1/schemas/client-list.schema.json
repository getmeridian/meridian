{
  "$defs": {
    "AccountSchedulePreview": {
      "additionalProperties": false,
      "description": "Effective dates after catch-up; calculating them never writes or activates an account.",
      "properties": {
        "activation_duration_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Activation Duration Days"
        },
        "activation_pending": {
          "title": "Activation Pending",
          "type": "boolean"
        },
        "expire_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expire At"
        },
        "next_renewal_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Renewal At"
        },
        "next_reset_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Reset At"
        },
        "renewal_enabled": {
          "title": "Renewal Enabled",
          "type": "boolean"
        },
        "renewals_completed": {
          "minimum": 0,
          "title": "Renewals Completed",
          "type": "integer"
        },
        "renewals_due": {
          "description": "Missed renewals applied together with one traffic reset.",
          "minimum": 0,
          "title": "Renewals Due",
          "type": "integer"
        },
        "renewals_left": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for unlimited renewals or when renewal is off.",
          "title": "Renewals Left"
        }
      },
      "required": [
        "activation_pending",
        "activation_duration_days",
        "expire_at",
        "next_reset_at",
        "renewal_enabled",
        "next_renewal_at",
        "renewals_left",
        "renewals_due",
        "renewals_completed"
      ],
      "title": "AccountSchedulePreview",
      "type": "object"
    },
    "ClientListSummary": {
      "additionalProperties": false,
      "description": "Aggregate client counts for dashboards.",
      "properties": {
        "active": {
          "title": "Active",
          "type": "integer"
        },
        "clients": {
          "title": "Clients",
          "type": "integer"
        },
        "disabled": {
          "title": "Disabled",
          "type": "integer"
        },
        "expired": {
          "title": "Expired",
          "type": "integer"
        },
        "limited": {
          "title": "Limited",
          "type": "integer"
        },
        "other": {
          "title": "Other",
          "type": "integer"
        }
      },
      "required": [
        "clients",
        "active",
        "disabled",
        "limited",
        "expired",
        "other"
      ],
      "title": "ClientListSummary",
      "type": "object"
    },
    "ClientRecord": {
      "additionalProperties": false,
      "description": "Redacted client metadata suitable for list views.",
      "properties": {
        "activation_duration_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whole UTC days from first traffic.",
          "title": "Activation Duration Days"
        },
        "attention_reasons": {
          "description": "Derived reasons when client list --attention was requested; never stored.",
          "items": {
            "enum": [
              "expiring",
              "quota",
              "unused",
              "stopped"
            ],
            "type": "string"
          },
          "title": "Attention Reasons",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "declared": {
          "default": true,
          "description": "False for a person added in the control service's web console rather than the fleet's reviewed intent; the CLI reads them, and the console manages them.",
          "title": "Declared",
          "type": "boolean"
        },
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Null uses the fleet's cap; 0 means unlimited.",
          "title": "Device Limit"
        },
        "expires_at": {
          "description": "UTC timestamp; empty means never.",
          "title": "Expires At",
          "type": "string"
        },
        "first_traffic_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the service first accepted traffic growth; unknown for historical use.",
          "title": "First Traffic At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "enum": [
                "en",
                "ru",
                "fa",
                "zh"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Subscription status language; null uses the fleet default.",
          "title": "Language"
        },
        "last_seen": {
          "title": "Last Seen",
          "type": "string"
        },
        "last_traffic_node": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The node whose latest accepted growth set the user's last traffic time.",
          "title": "Last Traffic Node"
        },
        "note": {
          "default": "",
          "description": "Private operator note; people/admin only.",
          "maxLength": 500,
          "title": "Note",
          "type": "string"
        },
        "renewal_anchor_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original expiry of the current renewal series.",
          "title": "Renewal Anchor At"
        },
        "renewal_interval_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Days"
        },
        "renewal_interval_months": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Months"
        },
        "renewal_limit": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Renewals in this series; null means unlimited.",
          "title": "Renewal Limit"
        },
        "renewals_completed": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Renewals Completed",
          "type": "integer"
        },
        "schedule": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountSchedulePreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tag": {
          "default": "",
          "description": "Private operator tag; people/admin only.",
          "pattern": "^[A-Z0-9_]{0,16}$",
          "title": "Tag",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "description": "0 means unlimited.",
          "title": "Traffic Limit Bytes",
          "type": "integer"
        },
        "traffic_reset": {
          "description": "When used traffic resets: never, day, week, month, or month_rolling on the stored UTC anchor day.",
          "title": "Traffic Reset",
          "type": "string"
        },
        "traffic_reset_anchor_day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC month day; null uses creation day.",
          "title": "Traffic Reset Anchor Day"
        },
        "traffic_used_bytes": {
          "title": "Traffic Used Bytes",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "id",
        "status",
        "traffic_used_bytes",
        "traffic_limit_bytes",
        "traffic_reset",
        "expires_at",
        "created_at",
        "last_seen"
      ],
      "title": "ClientRecord",
      "type": "object"
    },
    "PeopleFacets": {
      "additionalProperties": false,
      "properties": {
        "attention": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Attention",
          "type": "object"
        },
        "expires": {
          "default": 0,
          "title": "Expires",
          "type": "integer"
        },
        "lifecycle": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Lifecycle",
          "type": "object"
        },
        "never": {
          "default": 0,
          "title": "Never",
          "type": "integer"
        },
        "quota": {
          "default": 0,
          "title": "Quota",
          "type": "integer"
        },
        "status": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Status",
          "type": "object"
        },
        "tag": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tag",
          "type": "object"
        }
      },
      "title": "PeopleFacets",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Result for listing clients.",
  "properties": {
    "clients": {
      "items": {
        "$ref": "#/$defs/ClientRecord"
      },
      "title": "Clients",
      "type": "array"
    },
    "facets": {
      "anyOf": [
        {
          "$ref": "#/$defs/PeopleFacets"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "summary": {
      "$ref": "#/$defs/ClientListSummary"
    },
    "total": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total"
    }
  },
  "required": [
    "summary"
  ],
  "title": "ClientListResult",
  "type": "object"
}
