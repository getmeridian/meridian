{
  "$defs": {
    "OwnerContact": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "default": "",
          "maxLength": 2048,
          "pattern": "^(?:|https://[^\\s]+|tg://[^\\s]+|mailto:[^\\s]+)$",
          "title": "Link",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "OwnerContact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_routing": {
      "default": "ru-split",
      "enum": [
        "ru-split",
        "full"
      ],
      "title": "Client Routing",
      "type": "string"
    },
    "color": {
      "default": "",
      "enum": [
        "",
        "ocean",
        "sunset",
        "forest",
        "lavender",
        "rose",
        "slate"
      ],
      "title": "Color",
      "type": "string"
    },
    "exit_countries": {
      "items": {
        "maxLength": 2,
        "pattern": "^$|^[A-Za-z]{2}$",
        "type": "string"
      },
      "maxItems": 250,
      "title": "Exit Countries",
      "type": "array"
    },
    "owner_contact": {
      "$ref": "#/$defs/OwnerContact",
      "description": "Optional public owner contact, chosen through reviewed delivery intent."
    },
    "profile_title": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Profile Title",
      "type": "string"
    },
    "public_url": {
      "default": "",
      "description": "Public base of subscriptions and connection pages (scheme, host, connection-page path), without a trailing slash; empty leaves out the links built from it.",
      "maxLength": 512,
      "pattern": "^(?:https://[^\\s/]+(?:/[A-Za-z0-9._~-]+)*)?$",
      "title": "Public Url",
      "type": "string"
    },
    "server_icon": {
      "default": "",
      "maxLength": 409600,
      "title": "Server Icon",
      "type": "string"
    },
    "server_name": {
      "default": "",
      "maxLength": 100,
      "title": "Server Name",
      "type": "string"
    },
    "update_interval_hours": {
      "default": 6,
      "maximum": 168,
      "minimum": 1,
      "title": "Update Interval Hours",
      "type": "integer"
    }
  },
  "required": [
    "profile_title"
  ],
  "title": "ServiceSettings",
  "type": "object"
}
