{
  "$defs": {
    "CapacityCurrent": {
      "additionalProperties": false,
      "description": "Freshness uses the last accepted collection's service receipt, never a hello or replay.",
      "properties": {
        "age_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Seconds"
        },
        "received_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Received At"
        },
        "sample": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeCapacity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "default": "not_reported",
          "enum": [
            "not_reported",
            "unavailable",
            "current",
            "stale"
          ],
          "title": "Status",
          "type": "string"
        },
        "values": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityValues"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "CapacityCurrent",
      "type": "object"
    },
    "CapacityValues": {
      "additionalProperties": false,
      "description": "Integer figures; load is per CPU, memory pressure is per mille, and rates are bytes/s.",
      "properties": {
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Count"
        },
        "load15_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load15 Milli"
        },
        "load1_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load1 Milli"
        },
        "load5_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load5 Milli"
        },
        "load_per_cpu_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Per Cpu Milli"
        },
        "memory_available_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Available Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Total Bytes"
        },
        "memory_used_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Used Bytes"
        },
        "memory_used_per_mille": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Used Per Mille"
        },
        "rx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rx Bytes Per Second"
        },
        "tx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tx Bytes Per Second"
        },
        "xray_memory_resident_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xray Memory Resident Bytes"
        },
        "xray_uptime_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xray Uptime Seconds"
        }
      },
      "title": "CapacityValues",
      "type": "object"
    },
    "FleetStatusNode": {
      "additionalProperties": false,
      "properties": {
        "active_report_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The last report's collection window time.",
          "title": "Active Report At"
        },
        "active_report_received_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When the service accepted that report; duplicates leave it unchanged.",
          "title": "Active Report Received At"
        },
        "active_users": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "People with accepted growth in the last report; null before any report.",
          "title": "Active Users"
        },
        "capacity": {
          "anyOf": [
            {
              "$ref": "#/$defs/CapacityCurrent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "failed": {
          "items": {
            "type": "string"
          },
          "title": "Failed",
          "type": "array"
        },
        "in_sync": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Sync"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "is_panel_host": {
          "title": "Is Panel Host",
          "type": "boolean"
        },
        "live": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Live"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "default": "exit",
          "enum": [
            "exit",
            "routing_gateway"
          ],
          "title": "Role",
          "type": "string"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeRuntime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtime_available": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Available"
        },
        "status": {
          "enum": [
            "connected",
            "failed",
            "disconnected",
            "disabled",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "traffic_bytes": {
          "title": "Traffic Bytes",
          "type": "integer"
        },
        "traffic_counting_since": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Complete durable node accounting starts here. Retained counters from before a migration may also be included; earlier pruned traffic cannot be reconstructed.",
          "title": "Traffic Counting Since"
        },
        "uuid": {
          "title": "Uuid",
          "type": "string"
        },
        "xray_version": {
          "title": "Xray Version",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "name",
        "uuid",
        "is_panel_host",
        "status",
        "xray_version",
        "traffic_bytes"
      ],
      "title": "FleetStatusNode",
      "type": "object"
    },
    "HealthCheck": {
      "additionalProperties": false,
      "description": "One local health probe (for example `xray`, `nginx`, `disk`).",
      "properties": {
        "message": {
          "description": "Operator-facing text. Never carries secrets, client addresses, or raw command lines.",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "HealthCheck",
      "type": "object"
    },
    "InboundConnections": {
      "additionalProperties": false,
      "description": "Aggregate only; never derived by enumerating client addresses or identities.",
      "properties": {
        "connections": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Connections",
          "type": "integer"
        },
        "inbound_tag": {
          "description": "Xray inbound tag.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Inbound Tag",
          "type": "string"
        }
      },
      "required": [
        "inbound_tag",
        "connections"
      ],
      "title": "InboundConnections",
      "type": "object"
    },
    "NetworkCapacity": {
      "additionalProperties": false,
      "description": "Host traffic on the default-route interface; includes overhead and non-VPN traffic.\n\nNo interface name, address, or device identifier leaves the host. The first\nsample of an epoch has zero counters and null rates. A missing or overlong\ninterval also has null rates; it must not manufacture a current speed.",
      "properties": {
        "counter_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Counter Epoch",
          "type": "string"
        },
        "interval_millis": {
          "anyOf": [
            {
              "maximum": 180000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval Millis"
        },
        "rx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Rx Bytes",
          "type": "integer"
        },
        "rx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rx Bytes Per Second"
        },
        "tx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tx Bytes",
          "type": "integer"
        },
        "tx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tx Bytes Per Second"
        }
      },
      "required": [
        "counter_epoch",
        "rx_bytes",
        "tx_bytes",
        "rx_bytes_per_second",
        "tx_bytes_per_second",
        "interval_millis"
      ],
      "title": "NetworkCapacity",
      "type": "object"
    },
    "NodeCapacity": {
      "additionalProperties": false,
      "description": "One collection, identified independently of delivery retries and wall-clock skew.",
      "properties": {
        "collected_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Collected At",
          "type": "string"
        },
        "collection_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Collection Epoch",
          "type": "string"
        },
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cpu Count"
        },
        "inbound_connections": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InboundConnections"
              },
              "maxItems": 1024,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null on the pinned core, which has no address-free aggregate inbound connection counter.",
          "title": "Inbound Connections"
        },
        "load15_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load15 Milli"
        },
        "load1_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load1 Milli"
        },
        "load5_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load5 Milli"
        },
        "memory_available_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Available Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Total Bytes"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "xray": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessCapacity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "collection_epoch",
        "sequence",
        "collected_at",
        "cpu_count",
        "load1_milli",
        "load5_milli",
        "load15_milli",
        "memory_total_bytes",
        "memory_available_bytes",
        "network",
        "xray",
        "inbound_connections"
      ],
      "title": "NodeCapacity",
      "type": "object"
    },
    "NodeHealth": {
      "additionalProperties": false,
      "description": "Aggregate node health. Resource figures are integers to keep the protocol float-free.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/HealthCheck"
          },
          "maxItems": 32,
          "title": "Checks",
          "type": "array"
        },
        "disk_free_bytes": {
          "description": "Free bytes on the filesystem holding the agent's state.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Disk Free Bytes",
          "type": "integer"
        },
        "load1_milli": {
          "description": "One-minute load average times 1000.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Load1 Milli",
          "type": "integer"
        },
        "memory_available_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Memory Available Bytes",
          "type": "integer"
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ],
          "title": "Status",
          "type": "string"
        },
        "uptime_seconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Uptime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "checks",
        "uptime_seconds",
        "load1_milli",
        "memory_available_bytes",
        "disk_free_bytes"
      ],
      "title": "NodeHealth",
      "type": "object"
    },
    "NodeRuntime": {
      "additionalProperties": false,
      "description": "Runtime evidence from one agent report; polls refresh reachability, never this evidence.",
      "properties": {
        "health": {
          "$ref": "#/$defs/NodeHealth"
        },
        "observed_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Observed At",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/NodeVersions"
        }
      },
      "required": [
        "health",
        "versions",
        "observed_at"
      ],
      "title": "NodeRuntime",
      "type": "object"
    },
    "NodeVersions": {
      "additionalProperties": false,
      "description": "Versions of what runs on the node; `null` for software that is not installed.",
      "properties": {
        "agent": {
          "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "title": "Agent",
          "type": "string"
        },
        "kernel": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+~-]+$",
          "title": "Kernel",
          "type": "string"
        },
        "nginx": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nginx"
        },
        "os_id": {
          "description": "`ID` from /etc/os-release.",
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$",
          "title": "Os Id",
          "type": "string"
        },
        "os_version": {
          "description": "`VERSION_ID`.",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]*$",
          "title": "Os Version",
          "type": "string"
        },
        "realm": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Realm"
        },
        "xray": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Xray"
        }
      },
      "required": [
        "agent",
        "xray",
        "realm",
        "nginx",
        "os_id",
        "os_version",
        "kernel"
      ],
      "title": "NodeVersions",
      "type": "object"
    },
    "ProcessCapacity": {
      "additionalProperties": false,
      "description": "The managed Xray process; missing, changed, or unreadable evidence is null.",
      "properties": {
        "memory_resident_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Resident Bytes"
        },
        "uptime_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
