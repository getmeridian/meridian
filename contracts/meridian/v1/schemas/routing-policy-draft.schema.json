{
  "$defs": {
    "TopologyServerCapabilities": {
      "additionalProperties": false,
      "description": "Capabilities a saved server can provide to topology and routing plans.",
      "properties": {
        "capabilities": {
          "items": {
            "enum": [
              "panel",
              "exit",
              "relay",
              "routing_gateway"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Capabilities",
          "type": "array"
        },
        "region": {
          "default": "",
          "maxLength": 2,
          "pattern": "^$|^[A-Za-z]{2}$",
          "title": "Region",
          "type": "string"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        }
      },
      "required": [
        "server_ref",
        "capabilities"
      ],
      "title": "TopologyServerCapabilities",
      "type": "object"
    },
    "TrafficRouteRule": {
      "additionalProperties": false,
      "description": "One routing rule that maps traffic to an exit, optionally through a relay entry.",
      "properties": {
        "action": {
          "default": "route",
          "enum": [
            "route",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "country_codes": {
          "items": {
            "maxLength": 2,
            "minLength": 2,
            "pattern": "^[A-Za-z]{2}$",
            "type": "string"
          },
          "title": "Country Codes",
          "type": "array"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "entry_server_ref": {
          "default": "",
          "maxLength": 120,
          "pattern": "^$|^[^\\r\\n\\t]+$",
          "title": "Entry Server Ref",
          "type": "string"
        },
        "exit_server_ref": {
          "default": "",
          "maxLength": 120,
          "pattern": "^$|^[^\\r\\n\\t]+$",
          "title": "Exit Server Ref",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "traffic": {
          "default": "default",
          "enum": [
            "default",
            "country"
          ],
          "title": "Traffic",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "TrafficRouteRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Draft topology policy where capabilities and routing are separate concepts.",
  "properties": {
    "routes": {
      "items": {
        "$ref": "#/$defs/TrafficRouteRule"
      },
      "title": "Routes",
      "type": "array"
    },
    "servers": {
      "items": {
        "$ref": "#/$defs/TopologyServerCapabilities"
      },
      "title": "Servers",
      "type": "array"
    }
  },
  "title": "RoutingPolicyDraft",
  "type": "object"
}
