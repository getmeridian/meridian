{
  "additionalProperties": false,
  "description": "One server that owns the Remnawave control-plane workload.",
  "properties": {
    "public_hostname": {
      "anyOf": [
        {
          "const": "",
          "type": "string"
        },
        {
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
          "type": "string"
        }
      ],
      "default": "",
      "title": "Public Hostname"
    },
    "server_ref": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Server Ref",
      "type": "string"
    },
    "title": {
      "default": "Meridian",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "server_ref"
  ],
  "title": "ControlPlaneIntent",
  "type": "object"
}
