{
  "$defs": {
    "ContextListResult": {
      "additionalProperties": false,
      "description": "Every context in name order, default first.",
      "properties": {
        "contexts": {
          "items": {
            "$ref": "#/$defs/ContextSummary"
          },
          "title": "Contexts",
          "type": "array"
        },
        "pinned": {
          "default": false,
          "description": "MERIDIAN_HOME pins one fleet; contexts are unavailable",
          "title": "Pinned",
          "type": "boolean"
        }
      },
      "title": "ContextListResult",
      "type": "object"
    },
    "ContextSummary": {
      "additionalProperties": false,
      "description": "One context as local state describes it; nothing here comes from a server.",
      "properties": {
        "control": {
          "default": "",
          "description": "The control server's saved address; empty with no fleet yet",
          "title": "Control",
          "type": "string"
        },
        "current": {
          "description": "Whether commands without --context work on this fleet",
          "title": "Current",
          "type": "boolean"
        },
        "exits": {
          "default": 0,
          "title": "Exits",
          "type": "integer"
        },
        "gateways": {
          "default": 0,
          "title": "Gateways",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "description": "The directory holding this fleet's local files, ~ for the home directory",
          "title": "Path",
          "type": "string"
        },
        "relays": {
          "default": 0,
          "title": "Relays",
          "type": "integer"
        },
        "state": {
          "description": "ok: a deployed fleet; empty: nothing deployed yet; unreadable: local files need repair",
          "enum": [
            "ok",
            "empty",
            "unreadable"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "name",
        "current",
        "path",
        "state"
      ],
      "title": "ContextSummary",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ContextListSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "context.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ContextListResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ContextListSuccessEnvelope",
      "type": "object"
    },
    "_ContextListTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "context.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ContextListTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian context list --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_ContextListTerminalEnvelope",
      "ok": "#/$defs/_ContextListSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ContextListSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ContextListTerminalEnvelope"
    }
  ],
  "title": "ContextListOutputEnvelope"
}
