{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "RevisionActor": {
      "additionalProperties": false,
      "description": "Who proposed or approved a revision: an issued token, or the root config token (`token_id` null).",
      "properties": {
        "name": {
          "description": "The token's name; `root` for the configured admin token, the deployer's.",
          "title": "Name",
          "type": "string"
        },
        "token_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{12}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "RevisionActor",
      "type": "object"
    },
    "RevisionList": {
      "additionalProperties": false,
      "properties": {
        "revisions": {
          "description": "Newest first.",
          "items": {
            "$ref": "#/$defs/RevisionSummary"
          },
          "title": "Revisions",
          "type": "array"
        }
      },
      "required": [
        "revisions"
      ],
      "title": "RevisionList",
      "type": "object"
    },
    "RevisionSummary": {
      "additionalProperties": false,
      "description": "One reviewed apply: proposed, then approved, then applied or failed.",
      "properties": {
        "approved_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "approved_by": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionActor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "author": {
          "$ref": "#/$defs/RevisionActor"
        },
        "created_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Created At",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        },
        "finished_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "intent_sha256": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Intent Sha256",
          "type": "string"
        },
        "number": {
          "description": "Increases by one per proposal and is never reused.",
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "plan_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "review_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Hash",
          "type": "string"
        },
        "status": {
          "enum": [
            "proposed",
            "approved",
            "applied",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "number",
        "created_at",
        "author",
        "intent_sha256",
        "plan_hash",
        "review_hash",
        "status"
      ],
      "title": "RevisionSummary",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetHistorySuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.history",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/RevisionList"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetHistorySuccessEnvelope",
      "type": "object"
    },
    "_FleetHistoryTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.history",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetHistoryTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet history --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_FleetHistoryTerminalEnvelope",
      "ok": "#/$defs/_FleetHistorySuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetHistorySuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetHistoryTerminalEnvelope"
    }
  ],
  "title": "FleetHistoryOutputEnvelope"
}
