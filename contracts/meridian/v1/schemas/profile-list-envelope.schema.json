{
  "$defs": {
    "AccessProfileCatalog": {
      "additionalProperties": false,
      "properties": {
        "access_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Hash",
          "type": "string"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/AccessProfileSummary"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "required": [
        "profiles",
        "access_hash"
      ],
      "title": "AccessProfileCatalog",
      "type": "object"
    },
    "AccessProfileIntent": {
      "additionalProperties": false,
      "description": "A named set of reviewed exits, gateways, public endpoints, or authentication inbounds.",
      "properties": {
        "grants": {
          "items": {
            "pattern": "^(?:exit|gateway|inbound|endpoint):[a-z0-9][a-z0-9:_.-]{0,191}$",
            "type": "string"
          },
          "maxItems": 10000,
          "title": "Grants",
          "type": "array"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "grants"
      ],
      "title": "AccessProfileIntent",
      "type": "object"
    },
    "AccessProfileSummary": {
      "additionalProperties": false,
      "properties": {
        "built_in": {
          "default": false,
          "title": "Built In",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "inbound_refs": {
          "items": {
            "type": "string"
          },
          "title": "Inbound Refs",
          "type": "array"
        },
        "members": {
          "minimum": 0,
          "title": "Members",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "inbound_refs",
        "members"
      ],
      "title": "AccessProfileSummary",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "ProfileListResult": {
      "additionalProperties": false,
      "properties": {
        "catalog": {
          "$ref": "#/$defs/AccessProfileCatalog"
        },
        "profiles": {
          "items": {
            "$ref": "#/$defs/AccessProfileIntent"
          },
          "title": "Profiles",
          "type": "array"
        }
      },
      "required": [
        "profiles",
        "catalog"
      ],
      "title": "ProfileListResult",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ProfileListSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "profile.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ProfileListResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "changed",
            "no_changes"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ProfileListSuccessEnvelope",
      "type": "object"
    },
    "_ProfileListTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "profile.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ProfileListTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope for meridian profile list --json.",
  "discriminator": {
    "mapping": {
      "changed": "#/$defs/_ProfileListSuccessEnvelope",
      "failed": "#/$defs/_ProfileListTerminalEnvelope",
      "no_changes": "#/$defs/_ProfileListSuccessEnvelope",
      "ok": "#/$defs/_ProfileListSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ProfileListSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ProfileListTerminalEnvelope"
    }
  ],
  "title": "ProfileListOutputEnvelope"
}
