{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "RelayListEntry": {
      "additionalProperties": false,
      "description": "Configured relay metadata plus optional live host status.",
      "properties": {
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Enabled"
        },
        "exit_node_ip": {
          "title": "Exit Node Ip",
          "type": "string"
        },
        "ip": {
          "title": "Ip",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "port": {
          "title": "Port",
          "type": "integer"
        },
        "sni": {
          "title": "Sni",
          "type": "string"
        }
      },
      "required": [
        "ip",
        "name",
        "exit_node_ip",
        "port",
        "sni",
        "enabled"
      ],
      "title": "RelayListEntry",
      "type": "object"
    },
    "RelayListResult": {
      "additionalProperties": false,
      "description": "Result for listing configured relays.",
      "properties": {
        "relays": {
          "items": {
            "$ref": "#/$defs/RelayListEntry"
          },
          "title": "Relays",
          "type": "array"
        }
      },
      "title": "RelayListResult",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_RelayListSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "relay.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/RelayListResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_RelayListSuccessEnvelope",
      "type": "object"
    },
    "_RelayListTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "relay.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_RelayListTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian --json relay list`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_RelayListTerminalEnvelope",
      "ok": "#/$defs/_RelayListSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_RelayListSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_RelayListTerminalEnvelope"
    }
  ],
  "title": "RelayListOutputEnvelope"
}
