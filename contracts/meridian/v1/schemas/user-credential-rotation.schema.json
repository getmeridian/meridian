    "ResetInboundCommand": {
      "additionalProperties": false,
      "description": "Remove and re-add one managed inbound. Hysteria2 sessions close; accepted VLESS TCP flows may survive.\n\nAn urgent VLESS cut-off uses a revision-gated restart_unit of the core instead.",
      "properties": {
        "command_id": {
          "description": "Idempotency key of a command: a lowercase UUID chosen by the service, never reused.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Command Id",
          "type": "string"
        },
        "expires_at": {
          "description": "The agent answers `expired` instead of running it after this time.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Expires At",
          "type": "string"
        },
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "inbound_tag": {
          "description": "Xray inbound tag.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Inbound Tag",
          "type": "string"
        },
        "issued_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Issued At",
          "type": "string"
        },
        "kind": {
          "const": "reset_inbound",
          "default": "reset_inbound",
          "title": "Kind",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/ServiceSignature",
          "description": "Context line `meridian.agent/v1 command`."
        }
      },
      "required": [
        "command_id",
        "fleet_epoch",
        "issued_at",
        "expires_at",
        "signature",
        "kind",
        "inbound_tag"
      ],
      "title": "ResetInboundCommand",
      "type": "object"
    },
    "ResourceError": {
      "additionalProperties": false,
      "description": "Why a resource or command did not converge.",
      "properties": {
        "code": {
          "enum": [
            "download_failed",
            "hash_mismatch",
            "path_not_allowed",
            "write_failed",
            "disk_full",
            "validation_failed",
            "reload_failed",
            "service_failed",
            "xray_api_failed",
            "flow_guard_pending",
            "apply_pending",
            "document_not_applied",
            "config_not_installed",
            "config_mismatch",
            "rolled_back",
            "timeout",
            "unsupported",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Operator-facing text. Never carries secrets, client addresses, or raw command lines.",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "description": "True when retrying after the stated condition can succeed; resources retry automatically, while commands require a new ID.",
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ResourceError",
      "type": "object"
    },
    "RestartUnitCommand": {
      "additionalProperties": false,
      "description": "Restart a systemd unit the desired state manages, named by its resource ID.",
      "properties": {
        "command_id": {
          "description": "Idempotency key of a command: a lowercase UUID chosen by the service, never reused.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
