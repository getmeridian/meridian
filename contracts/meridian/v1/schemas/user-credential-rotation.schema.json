{
  "$defs": {
    "AccountSchedulePreview": {
      "additionalProperties": false,
      "description": "Effective dates after catch-up; calculating them never writes or activates an account.",
      "properties": {
        "activation_duration_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Activation Duration Days"
        },
        "activation_pending": {
          "title": "Activation Pending",
          "type": "boolean"
        },
        "expire_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expire At"
        },
        "next_renewal_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Renewal At"
        },
        "next_reset_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Reset At"
        },
        "renewal_enabled": {
          "title": "Renewal Enabled",
          "type": "boolean"
        },
        "renewals_completed": {
          "minimum": 0,
          "title": "Renewals Completed",
          "type": "integer"
        },
        "renewals_due": {
          "description": "Missed renewals applied together with one traffic reset.",
          "minimum": 0,
          "title": "Renewals Due",
          "type": "integer"
        },
        "renewals_left": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null for unlimited renewals or when renewal is off.",
          "title": "Renewals Left"
        }
      },
      "required": [
        "activation_pending",
        "activation_duration_days",
        "expire_at",
        "next_reset_at",
        "renewal_enabled",
        "next_renewal_at",
        "renewals_left",
        "renewals_due",
        "renewals_completed"
      ],
      "title": "AccountSchedulePreview",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "description": "Outcome of one command. Sending it again for the same `command_id` is harmless.",
      "properties": {
        "command_id": {
          "description": "Idempotency key of a command: a lowercase UUID chosen by the service, never reused.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Command Id",
          "type": "string"
        },
        "effect": {
          "anyOf": [
            {
              "enum": [
                "inbound_reset",
                "core_restart"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a successful reset_inbound: inbound_reset or core_restart. Null for other wire results. Admin records also mark a succeeded revision-gated core restart as core_restart. Sent only by sessions negotiating command kinds.",
          "title": "Effect"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when `status` is `failed` or `rejected`."
        },
        "finished_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Finished At",
          "type": "string"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "rejected",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "type": {
          "const": "command_result",
          "default": "command_result",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "command_id",
        "status",
        "error",
        "finished_at",
        "effect"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "NodeCommandRecord": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "discriminator": {
            "mapping": {
              "reconcile": "#/$defs/ReconcileCommand",
              "renew_credential": "#/$defs/RenewCredentialCommand",
              "report": "#/$defs/ReportCommand",
              "reset_inbound": "#/$defs/ResetInboundCommand",
              "restart_unit": "#/$defs/RestartUnitCommand"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ReconcileCommand"
            },
            {
              "$ref": "#/$defs/ReportCommand"
            },
            {
              "$ref": "#/$defs/ResetInboundCommand"
            },
            {
              "$ref": "#/$defs/RestartUnitCommand"
            },
            {
              "$ref": "#/$defs/RenewCredentialCommand"
            }
          ],
          "title": "Command"
        },
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "result": {
          "anyOf": [
            {
              "$ref": "#/$defs/CommandResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "waiting",
            "pending",
            "succeeded",
            "failed",
            "rejected",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "wait_for": {
          "anyOf": [
            {
              "$ref": "#/$defs/NodeStateRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "node_id",
        "command",
        "status",
        "wait_for",
        "result"
      ],
      "title": "NodeCommandRecord",
      "type": "object"
    },
    "NodeStateRef": {
      "additionalProperties": false,
      "description": "Points at one desired-state document by epoch, revision, and content hash.",
      "properties": {
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "revision": {
          "description": "Desired-state revision for one node. Ordering is (fleet_epoch, revision): within an epoch revisions only grow; a higher epoch wins even with a lower revision.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "description": "The document's `sha256` (hash of its `resources`).",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "fleet_epoch",
        "revision",
        "sha256"
      ],
      "title": "NodeStateRef",
      "type": "object"
    },
    "PeriodTraffic": {
      "additionalProperties": false,
      "description": "Period counters; legacy traffic with no known direction is included in download.",
      "properties": {
        "download_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Download Bytes",
          "type": "integer"
        },
        "unattributed_bytes": {
          "default": 0,
          "description": "Part of download whose direction an import or an older reset did not retain.",
          "minimum": 0,
          "title": "Unattributed Bytes",
          "type": "integer"
        },
        "upload_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Upload Bytes",
          "type": "integer"
        }
      },
      "title": "PeriodTraffic",
      "type": "object"
    },
    "ReconcileCommand": {
      "additionalProperties": false,
      "description": "Re-observe every resource now and repair drift.",
      "properties": {
        "command_id": {
          "description": "Idempotency key of a command: a lowercase UUID chosen by the service, never reused.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Command Id",
          "type": "string"
        },
        "expires_at": {
          "description": "The agent answers `expired` instead of running it after this time.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Expires At",
          "type": "string"
        },
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "issued_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Issued At",
          "type": "string"
        },
        "kind": {
          "const": "reconcile",
          "default": "reconcile",
          "title": "Kind",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/ServiceSignature",
          "description": "Context line `meridian.agent/v1 command`."
        }
      },
      "required": [
        "command_id",
        "fleet_epoch",
        "issued_at",
        "expires_at",
        "signature",
        "kind"
      ],
      "title": "ReconcileCommand",
      "type": "object"
    },
