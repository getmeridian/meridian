          "title": "Expires At",
          "type": "string"
        },
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "issued_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Issued At",
          "type": "string"
        },
        "kind": {
          "const": "restart_unit",
          "default": "restart_unit",
          "title": "Kind",
          "type": "string"
        },
        "resource_id": {
          "description": "Resource identifier, unique within one desired-state document and stable across revisions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Resource Id",
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/ServiceSignature",
          "description": "Context line `meridian.agent/v1 command`."
        }
      },
      "required": [
        "command_id",
        "fleet_epoch",
        "issued_at",
        "expires_at",
        "signature",
        "kind",
        "resource_id"
      ],
      "title": "RestartUnitCommand",
      "type": "object"
    },
    "ServiceSignature": {
      "additionalProperties": false,
      "description": "Ed25519 signature by the control service's signing key.\n\nThe key's certificate is issued by the fleet's pinned internal CA and reaches\nthe agent in `EnrollResponse` and `HelloResponse`. The agent verifies the\nsignature before acting, so a TLS interception or a self-signed fallback\ncertificate on 443 can never inject desired state or commands.",
      "properties": {
        "key_id": {
          "description": "SHA-256 of the DER signing certificate that made the signature.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Id",
          "type": "string"
        },
        "signature": {
          "description": "Ed25519 signature (64 bytes) in standard base64.",
          "maxLength": 88,
          "minLength": 88,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "title": "Signature",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "signature"
      ],
      "title": "ServiceSignature",
      "type": "object"
    },
    "UserFlowBlockNode": {
      "additionalProperties": false,
      "properties": {
        "credential_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Credential Generation",
          "type": "integer"
        },
        "inbound_tags": {
          "items": {
            "description": "Xray inbound tag.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Inbound Tags",
          "type": "array"
        },
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "reason": {
          "enum": [
            "disabled",
            "expired",
            "limited",
            "removed",
            "credentials",
            "access_changed"
          ],
          "title": "Reason",
          "type": "string"
        },
        "required": {
          "$ref": "#/$defs/NodeStateRef",
          "description": "The revocation revision; fresh applied revisions at or after it in the same epoch also cover it."
        },
        "status": {
          "enum": [
