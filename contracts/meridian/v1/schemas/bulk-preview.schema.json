{
  "$defs": {
    "BulkAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "extend",
            "expiry",
            "quota",
            "reset-traffic",
            "enable",
            "disable",
            "tag",
            "devices",
            "renewal",
            "delete"
          ],
          "title": "Action",
          "type": "string"
        },
        "days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Days"
        },
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Limit"
        },
        "expire_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expire At"
        },
        "months": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Months"
        },
        "renewal_interval_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Days"
        },
        "renewal_interval_months": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Months"
        },
        "renewal_limit": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Limit"
        },
        "tag": {
          "default": "",
          "pattern": "^[A-Z0-9_]{0,16}$",
          "title": "Tag",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic Limit Bytes"
        },
        "traffic_limit_strategy": {
          "anyOf": [
            {
              "enum": [
                "no_reset",
                "day",
                "week",
                "month",
                "month_rolling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic Limit Strategy"
        },
        "traffic_reset_anchor_day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Traffic Reset Anchor Day"
        }
      },
      "required": [
        "action"
      ],
      "title": "BulkAction",
      "type": "object"
    },
    "BulkCounts": {
      "additionalProperties": false,
      "properties": {
        "changed": {
          "minimum": 0,
          "title": "Changed",
          "type": "integer"
        },
        "cli_required": {
          "minimum": 0,
          "title": "Cli Required",
          "type": "integer"
        },
        "targeted": {
          "minimum": 0,
          "title": "Targeted",
          "type": "integer"
        },
        "unchanged": {
          "minimum": 0,
          "title": "Unchanged",
          "type": "integer"
        }
      },
      "required": [
        "targeted",
        "changed",
        "unchanged",
        "cli_required"
      ],
      "title": "BulkCounts",
      "type": "object"
    },
    "BulkFields": {
      "additionalProperties": false,
      "properties": {
        "activation_duration_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Whole UTC days from first traffic.",
          "title": "Activation Duration Days"
        },
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Limit"
        },
        "expire_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expire At"
        },
        "period_traffic": {
          "$ref": "#/$defs/PeriodTraffic"
        },
        "renewal_anchor_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original expiry of the current renewal series.",
          "title": "Renewal Anchor At"
        },
        "renewal_interval_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Days"
        },
        "renewal_interval_months": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renewal Interval Months"
        },
        "renewal_limit": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Renewals in this series; null means unlimited.",
          "title": "Renewal Limit"
        },
        "renewals_completed": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Renewals Completed",
          "type": "integer"
        },
        "status": {
          "enum": [
            "active",
            "disabled",
            "limited",
            "expired"
          ],
          "title": "Status",
          "type": "string"
        },
        "tag": {
          "pattern": "^[A-Z0-9_]{0,16}$",
          "title": "Tag",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "title": "Traffic Limit Bytes",
          "type": "integer"
        },
        "traffic_limit_strategy": {
          "enum": [
            "no_reset",
            "day",
            "week",
            "month",
            "month_rolling"
          ],
          "title": "Traffic Limit Strategy",
          "type": "string"
        },
        "traffic_reset_anchor_day": {
          "anyOf": [
            {
              "maximum": 31,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "UTC month day; null uses creation day.",
          "title": "Traffic Reset Anchor Day"
        },
        "traffic_reset_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Traffic Reset At"
        },
        "used_traffic_bytes": {
          "title": "Used Traffic Bytes",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "expire_at",
        "traffic_limit_bytes",
        "traffic_limit_strategy",
        "device_limit",
        "tag",
        "traffic_reset_at",
        "used_traffic_bytes",
        "period_traffic"
      ],
      "title": "BulkFields",
      "type": "object"
    },
    "BulkPersonChange": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/BulkFields"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "$ref": "#/$defs/BulkFields"
        },
        "changes": {
          "items": {
            "type": "string"
          },
          "title": "Changes",
          "type": "array"
        },
        "cli_command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cli Command"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "changed",
            "unchanged",
            "cli_required"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "row_version": {
          "minimum": 1,
          "title": "Row Version",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        },
        "warnings": {
          "items": {
            "enum": [
              "irreversible",
              "period_reset",
              "topology_delete",
              "disabled",
              "expiry_blocks_enable",
              "quota_blocks_enable",
              "no_change"
            ],
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "username",
        "display_name",
        "row_version",
        "before",
        "after",
        "changes",
        "outcome"
      ],
      "title": "BulkPersonChange",
      "type": "object"
    },
    "PeriodTraffic": {
      "additionalProperties": false,
      "description": "Period counters; legacy traffic with no known direction is included in download.",
      "properties": {
        "download_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Download Bytes",
          "type": "integer"
        },
        "unattributed_bytes": {
          "default": 0,
          "description": "Part of download whose direction an import or an older reset did not retain.",
          "minimum": 0,
          "title": "Unattributed Bytes",
          "type": "integer"
        },
        "upload_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Upload Bytes",
          "type": "integer"
        }
      },
      "title": "PeriodTraffic",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/BulkAction"
    },
    "changed_nodes": {
      "minimum": 0,
      "title": "Changed Nodes",
      "type": "integer"
    },
    "counts": {
      "$ref": "#/$defs/BulkCounts"
    },
    "created_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Expires At",
      "type": "string"
    },
    "id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Id",
      "type": "string"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/BulkPersonChange"
      },
      "title": "People",
      "type": "array"
    },
    "preview_hash": {
      "description": "Lowercase hex SHA-256 digest.",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Preview Hash",
      "type": "string"
    },
    "reversible": {
      "title": "Reversible",
      "type": "boolean"
    },
    "warnings": {
      "items": {
        "enum": [
          "irreversible",
          "period_reset",
          "topology_delete",
          "disabled",
          "expiry_blocks_enable",
          "quota_blocks_enable",
          "no_change"
        ],
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "id",
    "preview_hash",
    "created_at",
    "expires_at",
    "action",
    "people",
    "counts",
    "changed_nodes",
    "reversible"
  ],
  "title": "BulkPreview",
  "type": "object"
}
