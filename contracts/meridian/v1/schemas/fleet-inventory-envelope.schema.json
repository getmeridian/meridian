        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetInventoryTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet inventory --json`.",
  "discriminator": {
    "mapping": {
      "cancelled": "#/$defs/_FleetInventoryTerminalEnvelope",
      "failed": "#/$defs/_FleetInventoryTerminalEnvelope",
      "ok": "#/$defs/_FleetInventorySuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetInventorySuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetInventoryTerminalEnvelope"
    }
  ],
  "title": "FleetInventoryOutputEnvelope"
}
