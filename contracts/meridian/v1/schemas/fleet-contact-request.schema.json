{
  "additionalProperties": false,
  "properties": {
    "dry_run": {
      "default": false,
      "title": "Dry Run",
      "type": "boolean"
    },
    "link": {
      "anyOf": [
        {
          "maxLength": 2048,
          "pattern": "^(?:|https://[^\\s]+|tg://[^\\s]+|mailto:[^\\s]+)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Link"
    },
    "text": {
      "anyOf": [
        {
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "yes": {
      "default": false,
      "title": "Yes",
      "type": "boolean"
    }
  },
  "title": "FleetContactRequest",
  "type": "object"
}
