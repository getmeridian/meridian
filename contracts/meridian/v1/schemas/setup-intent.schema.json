{
  "$defs": {
    "AccessIntent": {
      "additionalProperties": false,
      "description": "Meridian-owned access squad and human users.\n\n`users` are panel usernames (Latin only, as Remnawave requires); `display_names`\nkeeps the name as typed, in any script, for users whose username differs from it.",
      "properties": {
        "creation_settings": {
          "description": "First account settings only; reviewed applies never replace an existing person's settings.",
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "$ref": "#/$defs/UserCreationSettings"
            }
          },
          "propertyNames": {
            "maxLength": 36,
            "minLength": 3
          },
          "title": "Creation Settings",
          "type": "object"
        },
        "display_names": {
          "patternProperties": {
            "^[A-Za-z0-9_-]+$": {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 36,
            "minLength": 3
          },
          "title": "Display Names",
          "type": "object"
        },
        "squad_name": {
          "default": "Meridian Access",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Squad Name",
          "type": "string"
        },
        "users": {
          "items": {
            "maxLength": 36,
            "minLength": 3,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Users",
          "type": "array"
        }
      },
      "required": [
        "users"
      ],
      "title": "AccessIntent",
      "type": "object"
    },
    "ControlPlaneIntent": {
      "additionalProperties": false,
      "description": "One server that owns the control-plane workload.",
      "properties": {
        "backend": {
          "default": "meridian",
          "enum": [
            "remnawave",
            "meridian"
          ],
          "title": "Backend",
          "type": "string"
        },
        "public_hostname": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Public Hostname"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        },
        "title": {
          "default": "Meridian",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "server_ref"
      ],
      "title": "ControlPlaneIntent",
      "type": "object"
    },
    "DeliveryIntent": {
      "additionalProperties": false,
      "description": "Canonical Remnawave subscription presentation settings.",
      "properties": {
        "client_routing": {
          "default": "ru-split",
          "description": "Client routing: ru-split bypasses Russian destinations; full tunnels them. Both bypass private/LAN ranges and retain Xray's best-effort BitTorrent bypass.",
          "enum": [
            "ru-split",
            "full"
          ],
          "title": "Client Routing",
          "type": "string"
        },
        "formats": {
          "items": {
            "enum": [
              "base64",
              "xray_json",
              "mihomo",
              "singbox"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Formats",
          "type": "array"
        },
        "owner_contact": {
          "$ref": "#/$defs/OwnerContact",
          "description": "Optional public owner contact, chosen through reviewed delivery intent."
        },
        "profile_title": {
          "default": "Meridian",
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Profile Title",
          "type": "string"
        },
        "template_name": {
          "default": "meridian",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Template Name",
          "type": "string"
        },
        "update_interval_hours": {
          "default": 6,
          "maximum": 168,
          "minimum": 1,
          "title": "Update Interval Hours",
          "type": "integer"
        }
      },
      "title": "DeliveryIntent",
      "type": "object"
    },
    "EgressOverrideIntent": {
      "additionalProperties": false,
      "description": "Send matching destinations through WARP, directly, or nowhere, ahead of the exit's default egress.",
      "properties": {
        "action": {
          "enum": [
            "warp",
            "direct",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "enum": [
            "domain",
            "geosite",
            "geoip"
          ],
          "title": "Match",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "match",
        "values",
        "action"
      ],
      "title": "EgressOverrideIntent",
      "type": "object"
    },
    "EgressPoolIntent": {
      "additionalProperties": false,
      "description": "An ordered set of exits used for server-side failover.",
      "properties": {
        "exit_refs": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Exit Refs",
          "type": "array"
        },
        "fail_closed": {
          "default": true,
          "title": "Fail Closed",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "probe_url": {
          "default": "https://www.apple.com/library/test/success.html",
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Probe Url",
          "type": "string"
        },
        "strategy": {
          "const": "least_ping",
          "default": "least_ping",
          "title": "Strategy",
          "type": "string"
        }
      },
      "required": [
        "id",
        "exit_refs"
      ],
      "title": "EgressPoolIntent",
      "type": "object"
    },
    "ExitIntent": {
      "additionalProperties": false,
      "description": "One independent Xray exit workload and its public protocol paths.",
      "properties": {
        "egress_overrides": {
          "items": {
            "$ref": "#/$defs/EgressOverrideIntent"
          },
          "title": "Egress Overrides",
          "type": "array"
        },
        "geo_block": {
          "default": false,
          "title": "Geo Block",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "paths": {
          "items": {
            "$ref": "#/$defs/ProtocolPathIntent"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "region": {
          "default": "",
          "maxLength": 2,
          "pattern": "^$|^[A-Za-z]{2}$",
          "title": "Region",
          "type": "string"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        },
        "warp": {
          "default": false,
          "title": "Warp",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "server_ref",
        "paths"
      ],
      "title": "ExitIntent",
      "type": "object"
    },
    "OrderedRouteIntent": {
      "additionalProperties": false,
      "description": "One explicit first-match routing rule.",
      "properties": {
        "action": {
          "default": "route",
          "enum": [
            "route",
            "direct",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "default": "all",
          "enum": [
            "all",
            "country",
            "domain",
            "geosite",
            "ip",
            "network"
          ],
          "title": "Match",
          "type": "string"
        },
        "match_values": {
          "items": {
            "type": "string"
          },
          "title": "Match Values",
          "type": "array"
        },
        "priority": {
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "source_gateway_ref": {
          "default": "",
          "maxLength": 48,
          "pattern": "^$|^[a-z0-9][a-z0-9_-]*$",
          "title": "Source Gateway Ref",
          "type": "string"
        },
        "target_ref": {
          "default": "",
          "maxLength": 48,
          "pattern": "^$|^[a-z0-9][a-z0-9_-]*$",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "priority"
      ],
      "title": "OrderedRouteIntent",
      "type": "object"
    },
    "OwnerContact": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "default": "",
          "maxLength": 2048,
          "pattern": "^(?:|https://[^\\s]+|tg://[^\\s]+|mailto:[^\\s]+)$",
          "title": "Link",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "OwnerContact",
      "type": "object"
    },
    "ProtocolPathIntent": {
      "additionalProperties": false,
      "description": "One protocol-specific public path backed by an exit workload.",
      "properties": {
        "fingerprint": {
          "default": "chrome",
          "enum": [
            "chrome",
            "firefox",
            "safari",
            "ios",
            "android",
            "edge",
            "random",
            "randomized"
          ],
          "title": "Fingerprint",
          "type": "string"
        },
        "host": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Host"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "listen_port": {
          "default": 0,
          "maximum": 65535,
          "minimum": 0,
          "title": "Listen Port",
          "type": "integer"
        },
        "path": {
          "default": "",
          "maxLength": 200,
          "pattern": "^$|^/?[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$",
          "title": "Path",
          "type": "string"
        },
        "protocol": {
          "enum": [
            "reality",
            "xhttp",
            "wss",
            "hysteria2"
          ],
          "title": "Protocol",
          "type": "string"
        },
        "public_port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Public Port",
          "type": "integer"
        },
        "reality_sni": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Reality Sni"
        },
        "self_steal": {
          "default": false,
          "title": "Self Steal",
          "type": "boolean"
        },
        "tls_sni": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Tls Sni"
        }
      },
      "required": [
        "id",
        "protocol"
      ],
      "title": "ProtocolPathIntent",
      "type": "object"
    },
    "RoutingGatewayIntent": {
      "additionalProperties": false,
      "description": "A smart entry workload using a reviewed Reality path as its public blueprint.",
      "properties": {
        "bridge_path_ref": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Bridge Path Ref",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        }
      },
      "required": [
        "id",
        "server_ref",
        "bridge_path_ref"
      ],
      "title": "RoutingGatewayIntent",
      "type": "object"
    },
    "TransparentRelayIntent": {
      "additionalProperties": false,
      "description": "A client-first Realm hop list whose first server is the advertised endpoint.",
      "properties": {
        "exit_ref": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Exit Ref",
          "type": "string"
        },
        "hop_server_refs": {
          "items": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[^\\r\\n\\t]+$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Hop Server Refs",
          "type": "array"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "listen_port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Listen Port",
          "type": "integer"
        },
        "protocol_path_ref": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Protocol Path Ref",
          "type": "string"
        },
        "reality_sni": {
          "anyOf": [
            {
              "const": "",
              "type": "string"
            },
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?=.{1,253}\\.?$)(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.?$",
              "type": "string"
            }
          ],
          "default": "",
          "title": "Reality Sni"
        }
      },
      "required": [
        "id",
        "hop_server_refs",
        "exit_ref",
        "protocol_path_ref"
      ],
      "title": "TransparentRelayIntent",
      "type": "object"
    },
    "UserCreationSettings": {
      "additionalProperties": false,
      "description": "First service-owned settings, applied only when an access account is created.",
      "properties": {
        "device_limit": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Limit"
        },
        "expire_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expire At"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "disabled"
          ],
          "title": "Status",
          "type": "string"
        },
        "traffic_limit_bytes": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Traffic Limit Bytes",
          "type": "integer"
        },
        "traffic_limit_strategy": {
          "default": "no_reset",
          "enum": [
            "no_reset",
            "day",
            "week",
            "month"
          ],
          "title": "Traffic Limit Strategy",
          "type": "string"
        }
      },
      "title": "UserCreationSettings",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Complete user intent consumed by the pure topology compiler.",
  "properties": {
    "access": {
      "$ref": "#/$defs/AccessIntent"
    },
    "control": {
      "$ref": "#/$defs/ControlPlaneIntent"
    },
    "default_egress_ref": {
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Default Egress Ref",
      "type": "string"
    },
    "delivery": {
      "$ref": "#/$defs/DeliveryIntent"
    },
    "egress_pools": {
      "items": {
        "$ref": "#/$defs/EgressPoolIntent"
      },
      "title": "Egress Pools",
      "type": "array"
    },
    "exits": {
      "items": {
        "$ref": "#/$defs/ExitIntent"
      },
      "minItems": 1,
      "title": "Exits",
      "type": "array"
    },
    "forward_client_ips": {
      "default": false,
      "title": "Forward Client Ips",
      "type": "boolean"
    },
    "harden": {
      "default": true,
      "title": "Harden",
      "type": "boolean"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/OrderedRouteIntent"
      },
      "title": "Routes",
      "type": "array"
    },
    "routing_gateways": {
      "items": {
        "$ref": "#/$defs/RoutingGatewayIntent"
      },
      "title": "Routing Gateways",
      "type": "array"
    },
    "transparent_relays": {
      "items": {
        "$ref": "#/$defs/TransparentRelayIntent"
      },
      "title": "Transparent Relays",
      "type": "array"
    }
  },
  "required": [
    "control",
    "exits",
    "default_egress_ref",
    "access"
  ],
  "title": "SetupIntent",
  "type": "object"
}
