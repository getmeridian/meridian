{
  "$defs": {
    "ApiWorkflowResult": {
      "additionalProperties": false,
      "description": "Result for `meridian api workflow NAME --json`.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "workflow": {
          "$ref": "#/$defs/WorkflowPlan"
        }
      },
      "required": [
        "name",
        "workflow"
      ],
      "title": "ApiWorkflowResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "InputField": {
      "additionalProperties": false,
      "description": "One UI-renderable input field requested by a workflow.",
      "properties": {
        "default": {
          "default": null,
          "title": "Default"
        },
        "help_text": {
          "default": "",
          "title": "Help Text",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "boolean",
            "choice",
            "confirmation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/InputOption"
          },
          "title": "Options",
          "type": "array"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "secret": {
          "default": false,
          "title": "Secret",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "InputField",
      "type": "object"
    },
    "InputOption": {
      "additionalProperties": false,
      "description": "One selectable value for a workflow field.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label"
      ],
      "title": "InputOption",
      "type": "object"
    },
    "InputSection": {
      "additionalProperties": false,
      "description": "Logical grouping for workflow fields.",
      "properties": {
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "field_ids": {
          "items": {
            "type": "string"
          },
          "title": "Field Ids",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "InputSection",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "WorkflowPlan": {
      "additionalProperties": false,
      "description": "Current workflow state for a CLI, UI, or process client.",
      "properties": {
        "fields": {
          "items": {
            "$ref": "#/$defs/InputField"
          },
          "title": "Fields",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "needs_input": {
          "title": "Needs Input",
          "type": "boolean"
        },
        "ready_request_schema": {
          "default": "",
          "title": "Ready Request Schema",
          "type": "string"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/InputSection"
          },
          "title": "Sections",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "summary",
        "needs_input"
      ],
      "title": "WorkflowPlan",
      "type": "object"
    },
    "_ApiWorkflowSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "api.workflow",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ApiWorkflowResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApiWorkflowSuccessEnvelope",
      "type": "object"
    },
    "_ApiWorkflowTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "api.workflow",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ApiWorkflowTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian api workflow NAME --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_ApiWorkflowTerminalEnvelope",
      "ok": "#/$defs/_ApiWorkflowSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ApiWorkflowSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ApiWorkflowTerminalEnvelope"
    }
  ],
  "title": "ApiWorkflowOutputEnvelope"
}
