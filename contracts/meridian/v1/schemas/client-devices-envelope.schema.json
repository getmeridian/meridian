{
  "$defs": {
    "ClientDevice": {
      "additionalProperties": false,
      "description": "An ID that can be removed; private mode exposes no metadata.",
      "properties": {
        "device_key": {
          "maxLength": 64,
          "minLength": 10,
          "pattern": "^[A-Za-z0-9=-]{10,64}$",
          "title": "Device Key",
          "type": "string"
        }
      },
      "required": [
        "device_key"
      ],
      "title": "ClientDevice",
      "type": "object"
    },
    "ClientDeviceDetails": {
      "additionalProperties": false,
      "description": "Details collected only with full device limits.",
      "properties": {
        "device_key": {
          "maxLength": 64,
          "minLength": 10,
          "pattern": "^[A-Za-z0-9=-]{10,64}$",
          "title": "Device Key",
          "type": "string"
        },
        "first_seen_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "First Seen At"
        },
        "last_seen_at": {
          "anyOf": [
            {
              "description": "RFC 3339 timestamp in UTC, ending in Z.",
              "maxLength": 40,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Seen At"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model"
        },
        "os_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Os Version"
        },
        "platform": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Platform"
        },
        "user_agent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "User Agent"
        }
      },
      "required": [
        "device_key",
        "platform",
        "os_version",
        "model",
        "user_agent",
        "first_seen_at",
        "last_seen_at"
      ],
      "title": "ClientDeviceDetails",
      "type": "object"
    },
    "ClientDevicesResult": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "minimum": 0,
          "title": "Count",
          "type": "integer"
        },
        "devices": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/ClientDeviceDetails"
              },
              {
                "$ref": "#/$defs/ClientDevice"
              }
            ]
          },
          "title": "Devices",
          "type": "array"
        },
        "level": {
          "description": "off, private, or full; the service's device privacy level.",
          "title": "Level",
          "type": "string"
        },
        "limit": {
          "description": "The effective device cap; 0 means unlimited.",
          "maximum": 100,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "removed": {
          "default": 0,
          "description": "Rows removed by this command; zero on a read.",
          "minimum": 0,
          "title": "Removed",
          "type": "integer"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "level",
        "count",
        "limit"
      ],
      "title": "ClientDevicesResult",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ClientDevicesSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "client.devices",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ClientDevicesResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ClientDevicesSuccessEnvelope",
      "type": "object"
    },
    "_ClientDevicesTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "client.devices",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ClientDevicesTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian client devices --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_ClientDevicesTerminalEnvelope",
      "ok": "#/$defs/_ClientDevicesSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ClientDevicesSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ClientDevicesTerminalEnvelope"
    }
  ],
  "title": "ClientDevicesOutputEnvelope"
}
