{
  "$defs": {
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One-shot JSON result envelope for command/process APIs.",
  "properties": {
    "command": {
      "title": "Command",
      "type": "string"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    },
    "duration_ms": {
      "title": "Duration Ms",
      "type": "integer"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/MeridianError"
      },
      "title": "Errors",
      "type": "array"
    },
    "exit_code": {
      "title": "Exit Code",
      "type": "integer"
    },
    "meridian_version": {
      "title": "Meridian Version",
      "type": "string"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "schema": {
      "const": "meridian.output/v1",
      "default": "meridian.output/v1",
      "title": "Schema",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "changed",
        "no_changes",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/Summary"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/MeridianError"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "meridian_version",
    "command",
    "operation_id",
    "started_at",
    "duration_ms",
    "status",
    "exit_code",
    "summary"
  ],
  "title": "OutputEnvelope",
  "type": "object"
}
