{
  "additionalProperties": false,
  "description": "Meridian-owned access squad and human users.",
  "properties": {
    "squad_name": {
      "default": "Meridian Access",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Squad Name",
      "type": "string"
    },
    "users": {
      "items": {
        "maxLength": 36,
        "minLength": 3,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Users",
      "type": "array"
    }
  },
  "required": [
    "users"
  ],
  "title": "AccessIntent",
  "type": "object"
}
