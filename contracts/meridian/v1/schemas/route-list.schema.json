{
  "$defs": {
    "EgressOverrideIntent": {
      "additionalProperties": false,
      "description": "Send matching destinations through WARP, directly, or nowhere, ahead of the exit's default egress.",
      "properties": {
        "action": {
          "enum": [
            "warp",
            "direct",
            "block"
          ],
          "title": "Action",
          "type": "string"
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "match": {
          "enum": [
            "domain",
            "geosite",
            "geoip"
          ],
          "title": "Match",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "id",
        "match",
        "values",
        "action"
      ],
      "title": "EgressOverrideIntent",
      "type": "object"
    },
    "ExitEgressOverrides": {
      "additionalProperties": false,
      "description": "One exit's default egress and its overrides in first-match order.",
      "properties": {
        "exit": {
          "title": "Exit",
          "type": "string"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/EgressOverrideIntent"
          },
          "title": "Overrides",
          "type": "array"
        },
        "warp": {
          "title": "Warp",
          "type": "boolean"
        }
      },
      "required": [
        "exit",
        "warp"
      ],
      "title": "ExitEgressOverrides",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Every exit's egress overrides.",
  "properties": {
    "exits": {
      "items": {
        "$ref": "#/$defs/ExitEgressOverrides"
      },
      "title": "Exits",
      "type": "array"
    }
  },
  "title": "RouteListResult",
  "type": "object"
}
