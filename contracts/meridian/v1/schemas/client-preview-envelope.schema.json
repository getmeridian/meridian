{
  "$defs": {
    "CidrMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cidr",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 49,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "CidrMatch",
      "type": "object"
    },
    "DeliveryAction": {
      "additionalProperties": false,
      "properties": {
        "exit": {
          "anyOf": [
            {
              "maxLength": 48,
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "kind": {
          "enum": [
            "proxy",
            "direct",
            "block",
            "exit"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DeliveryAction",
      "type": "object"
    },
    "DeliveryDestination": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Host",
          "type": "string"
        },
        "network": {
          "default": "tcp",
          "enum": [
            "tcp",
            "udp"
          ],
          "title": "Network",
          "type": "string"
        },
        "port": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Port"
        },
        "protocol": {
          "default": "other",
          "enum": [
            "other",
            "bittorrent"
          ],
          "title": "Protocol",
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "title": "DeliveryDestination",
      "type": "object"
    },
    "DeliveryDns": {
      "additionalProperties": false,
      "properties": {
        "fake_ip": {
          "default": false,
          "title": "Fake Ip",
          "type": "boolean"
        },
        "resolvers": {
          "items": {
            "discriminator": {
              "mapping": {
                "doh": "#/$defs/DohResolver",
                "dot": "#/$defs/DotResolver",
                "plain": "#/$defs/PlainResolver"
              },
              "propertyName": "transport"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DohResolver"
              },
              {
                "$ref": "#/$defs/DotResolver"
              },
              {
                "$ref": "#/$defs/PlainResolver"
              }
            ]
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Resolvers",
          "type": "array"
        }
      },
      "required": [
        "resolvers"
      ],
      "title": "DeliveryDns",
      "type": "object"
    },
    "DeliveryExplanation": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "destination": {
          "$ref": "#/$defs/DeliveryDestination"
        },
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "geodata_available": {
          "title": "Geodata Available",
          "type": "boolean"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/DeliveryPolicyOmission"
          },
          "maxItems": 512,
          "title": "Omitted",
          "type": "array"
        },
        "policy": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Policy",
          "type": "string"
        },
        "reason": {
          "enum": [
            "rule_matched",
            "default_proxy",
            "geodata_unavailable",
            "port_required",
            "ip_required",
            "rules_not_carried",
            "no_connections",
            "inactive_person"
          ],
          "title": "Reason",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "maximum": 133,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "status": {
          "enum": [
            "matched",
            "default",
            "unknown",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "destination",
        "format",
        "policy",
        "status",
        "action",
        "reason",
        "geodata_available"
      ],
      "title": "DeliveryExplanation",
      "type": "object"
    },
    "DeliveryFormatCapabilities": {
      "additionalProperties": false,
      "properties": {
        "bittorrent": {
          "title": "Bittorrent",
          "type": "boolean"
        },
        "dns_transports": {
          "items": {
            "enum": [
              "doh",
              "dot",
              "plain"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "title": "Dns Transports",
          "type": "array"
        },
        "fake_ip": {
          "title": "Fake Ip",
          "type": "boolean"
        },
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "local_geodata": {
          "title": "Local Geodata",
          "type": "boolean"
        },
        "matches": {
          "items": {
            "enum": [
              "domain_suffix",
              "domain_keyword",
              "domain_full",
              "geosite",
              "geoip",
              "cidr",
              "port",
              "network"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "title": "Matches",
          "type": "array"
        },
        "via_exit": {
          "title": "Via Exit",
          "type": "boolean"
        }
      },
      "required": [
        "format",
        "matches",
        "dns_transports",
        "fake_ip",
        "via_exit",
        "bittorrent",
        "local_geodata"
      ],
      "title": "DeliveryFormatCapabilities",
      "type": "object"
    },
    "DeliveryPolicy": {
      "additionalProperties": false,
      "description": "LAN always precedes custom rules; the preset's remaining rules follow them.",
      "properties": {
        "dns": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryDns"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "preset": {
          "default": "full",
          "enum": [
            "ru-split",
            "full"
          ],
          "title": "Preset",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/DeliveryRule"
          },
          "maxItems": 128,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "id"
      ],
      "title": "DeliveryPolicy",
      "type": "object"
    },
    "DeliveryPolicyOmission": {
      "additionalProperties": false,
      "properties": {
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "context": {
          "anyOf": [
            {
              "enum": [
                "xray_individual_profiles",
                "xray_fingerprint_profiles"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "exit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit"
        },
        "profile_count": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile Count"
        },
        "reason": {
          "enum": [
            "rules_not_carried",
            "dns_not_carried",
            "geosite_not_supported",
            "geoip_not_supported",
            "bittorrent_not_supported",
            "dns_transport_not_supported",
            "fake_ip_not_supported",
            "exit_unavailable"
          ],
          "title": "Reason",
          "type": "string"
        },
        "resolver": {
          "anyOf": [
            {
              "maximum": 4,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolver"
        },
        "rule": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "reason"
      ],
      "title": "DeliveryPolicyOmission",
      "type": "object"
    },
    "DeliveryPolicyPreview": {
      "additionalProperties": false,
      "properties": {
        "effective": {
          "$ref": "#/$defs/ResolvedDeliveryPolicy"
        },
        "formats": {
          "items": {
            "$ref": "#/$defs/FormatDeliveryPolicy"
          },
          "maxItems": 5,
          "title": "Formats",
          "type": "array"
        },
        "geodata_source": {
          "title": "Geodata Source",
          "type": "string"
        }
      },
      "required": [
        "effective",
        "formats",
        "geodata_source"
      ],
      "title": "DeliveryPolicyPreview",
      "type": "object"
    },
    "DeliveryPortRange": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "anyOf": [
            {
              "maximum": 65535,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End"
        },
        "start": {
          "maximum": 65535,
          "minimum": 1,
          "title": "Start",
          "type": "integer"
        }
      },
      "required": [
        "start"
      ],
      "title": "DeliveryPortRange",
      "type": "object"
    },
    "DeliveryRoutePreview": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/DeliveryAction"
        },
        "domains": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Domains",
          "type": "array"
        },
        "ips": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Ips",
          "type": "array"
        },
        "networks": {
          "items": {
            "enum": [
              "tcp",
              "udp"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "title": "Networks",
          "type": "array"
        },
        "number": {
          "maximum": 133,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "origin": {
          "enum": [
            "lan",
            "preset",
            "rule"
          ],
          "title": "Origin",
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/DeliveryPortRange"
          },
          "maxItems": 16,
          "title": "Ports",
          "type": "array"
        },
        "protocols": {
          "items": {
            "const": "bittorrent",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Protocols",
          "type": "array"
        },
        "source_rule": {
          "anyOf": [
            {
              "maximum": 128,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Rule"
        }
      },
      "required": [
        "number",
        "origin",
        "action"
      ],
      "title": "DeliveryRoutePreview",
      "type": "object"
    },
    "DeliveryRule": {
      "additionalProperties": false,
      "description": "Values are alternatives; network and ports narrow the whole match with AND.",
      "properties": {
        "action": {
          "$ref": "#/$defs/DeliveryAction"
        },
        "match": {
          "discriminator": {
            "mapping": {
              "cidr": "#/$defs/CidrMatch",
              "domain_full": "#/$defs/DomainFullMatch",
              "domain_keyword": "#/$defs/DomainKeywordMatch",
              "domain_suffix": "#/$defs/DomainSuffixMatch",
              "geoip": "#/$defs/GeoipMatch",
              "geosite": "#/$defs/GeositeMatch",
              "network": "#/$defs/NetworkMatch",
              "port": "#/$defs/PortMatch"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/DomainSuffixMatch"
            },
            {
              "$ref": "#/$defs/DomainKeywordMatch"
            },
            {
              "$ref": "#/$defs/DomainFullMatch"
            },
            {
              "$ref": "#/$defs/GeositeMatch"
            },
            {
              "$ref": "#/$defs/GeoipMatch"
            },
            {
              "$ref": "#/$defs/CidrMatch"
            },
            {
              "$ref": "#/$defs/PortMatch"
            },
            {
              "$ref": "#/$defs/NetworkMatch"
            }
          ],
          "title": "Match"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "tcp",
                "udp"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/DeliveryPortRange"
          },
          "maxItems": 16,
          "title": "Ports",
          "type": "array"
        }
      },
      "required": [
        "match",
        "action"
      ],
      "title": "DeliveryRule",
      "type": "object"
    },
    "DohResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "path": {
          "default": "/dns-query",
          "maxLength": 200,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "port": {
          "default": 443,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "doh",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DohResolver",
      "type": "object"
    },
    "DomainFullMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_full",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainFullMatch",
      "type": "object"
    },
    "DomainKeywordMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_keyword",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9._-]+$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainKeywordMatch",
      "type": "object"
    },
    "DomainSuffixMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "domain_suffix",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 253,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "DomainSuffixMatch",
      "type": "object"
    },
    "DotResolver": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 3,
          "title": "Address",
          "type": "string"
        },
        "port": {
          "default": 853,
          "maximum": 65535,
          "minimum": 1,
          "title": "Port",
          "type": "integer"
        },
        "transport": {
          "const": "dot",
          "title": "Transport",
          "type": "string"
        }
      },
      "required": [
        "transport",
        "address"
      ],
      "title": "DotResolver",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "FormatDeliveryPolicy": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "$ref": "#/$defs/DeliveryFormatCapabilities"
        },
        "dns": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryDns"
            },
            {
              "type": "null"
            }
          ]
        },
        "dns_source": {
          "enum": [
            "preset",
            "custom",
            "omitted"
          ],
          "title": "Dns Source",
          "type": "string"
        },
        "final_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeliveryAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "format": {
          "enum": [
            "browser",
            "mihomo",
            "stash",
            "singbox",
            "xray-json",
            "base64"
          ],
          "title": "Format",
          "type": "string"
        },
        "omitted": {
          "items": {
            "$ref": "#/$defs/DeliveryPolicyOmission"
          },
          "maxItems": 512,
          "title": "Omitted",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/DeliveryRoutePreview"
          },
          "maxItems": 133,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "format",
        "capabilities",
        "rules",
        "final_action",
        "dns",
        "dns_source",
        "omitted"
      ],
      "title": "FormatDeliveryPolicy",
      "type": "object"
    },
    "FormatRule": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "anyOf": [
            {
              "enum": [
                "mihomo",
                "stash",
                "singbox",
                "clash",
                "xray-json"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Family"
        },
        "match": {
          "default": "",
          "enum": [
            "",
            "text/html"
          ],
          "title": "Match",
          "type": "string"
        },
        "rule": {
          "enum": [
            "suffix",
            "user_agent",
            "accept",
            "default"
          ],
          "title": "Rule",
          "type": "string"
        },
        "suffix": {
          "default": "",
          "enum": [
            "",
            "info",
            "json",
            "v2ray-json",
            "mihomo",
            "clash",
            "stash",
            "singbox"
          ],
          "title": "Suffix",
          "type": "string"
        }
      },
      "required": [
        "rule"
      ],
      "title": "FormatRule",
      "type": "object"
    },
    "GeoipMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "geoip",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "values"
      ],
      "title": "GeoipMatch",
      "type": "object"
    },
    "GeositeMatch": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "geosite",
          "title": "Kind",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 64,
