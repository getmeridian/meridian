{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "NodeDailyUsage": {
      "additionalProperties": false,
      "properties": {
        "daily": {
          "items": {
            "$ref": "#/$defs/NodeTrafficDay"
          },
          "title": "Daily",
          "type": "array"
        },
        "node_id": {
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "daily"
      ],
      "title": "NodeDailyUsage",
      "type": "object"
    },
    "NodeTrafficDay": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        },
        "day": {
          "format": "date",
          "title": "Day",
          "type": "string"
        }
      },
      "required": [
        "day",
        "bytes"
      ],
      "title": "NodeTrafficDay",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "TrafficDailySummary": {
      "additionalProperties": false,
      "description": "Daily bytes across the fleet and by node, oldest first; includes retained use of removed nodes.",
      "properties": {
        "daily": {
          "items": {
            "$ref": "#/$defs/NodeTrafficDay"
          },
          "title": "Daily",
          "type": "array"
        },
        "days": {
          "maximum": 730,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "history_days": {
          "maximum": 730,
          "minimum": 7,
          "title": "History Days",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeDailyUsage"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "days",
        "history_days",
        "daily",
        "nodes"
      ],
      "title": "TrafficDailySummary",
      "type": "object"
    },
    "_FleetUsageSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.usage",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TrafficDailySummary"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetUsageSuccessEnvelope",
      "type": "object"
    },
    "_FleetUsageTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.usage",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetUsageTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian fleet usage --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_FleetUsageTerminalEnvelope",
      "ok": "#/$defs/_FleetUsageSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetUsageSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetUsageTerminalEnvelope"
    }
  ],
  "title": "FleetUsageOutputEnvelope"
}
