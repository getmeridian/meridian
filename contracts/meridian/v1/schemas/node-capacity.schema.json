{
  "$defs": {
    "CapacityDay": {
      "additionalProperties": false,
      "description": "The current UTC hour and its preceding 23 buckets; partial coverage is explicit.",
      "properties": {
        "covered_seconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Covered Seconds",
          "type": "integer"
        },
        "ends_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Ends At",
          "type": "string"
        },
        "mean": {
          "$ref": "#/$defs/CapacityValues"
        },
        "peak": {
          "$ref": "#/$defs/CapacityValues"
        },
        "rx_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rx Bytes"
        },
        "samples": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "starts_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Starts At",
          "type": "string"
        },
        "tx_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tx Bytes"
        }
      },
      "required": [
        "starts_at",
        "ends_at",
        "samples",
        "mean",
        "peak",
        "rx_bytes",
        "tx_bytes",
        "covered_seconds"
      ],
      "title": "CapacityDay",
      "type": "object"
    },
    "CapacityHour": {
      "additionalProperties": false,
      "properties": {
        "covered_seconds": {
          "description": "Adjacent received network samples only; gaps stay unmeasured.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Covered Seconds",
          "type": "integer"
        },
        "mean": {
          "$ref": "#/$defs/CapacityValues"
        },
        "peak": {
          "$ref": "#/$defs/CapacityValues"
        },
        "rx_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rx Bytes"
        },
        "samples": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Samples",
          "type": "integer"
        },
        "starts_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Starts At",
          "type": "string"
        },
        "tx_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tx Bytes"
        }
      },
      "required": [
        "starts_at",
        "samples",
        "mean",
        "peak",
        "rx_bytes",
        "tx_bytes",
        "covered_seconds"
      ],
      "title": "CapacityHour",
      "type": "object"
    },
    "CapacityPoint": {
      "additionalProperties": false,
      "properties": {
        "received_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Received At",
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/CapacityValues"
        }
      },
      "required": [
        "received_at",
        "values"
      ],
      "title": "CapacityPoint",
      "type": "object"
    },
    "CapacityValues": {
      "additionalProperties": false,
      "description": "Integer figures; load is per CPU, memory pressure is per mille, and rates are bytes/s.",
      "properties": {
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cpu Count"
        },
        "load15_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load15 Milli"
        },
        "load1_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load1 Milli"
        },
        "load5_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load5 Milli"
        },
        "load_per_cpu_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Load Per Cpu Milli"
        },
        "memory_available_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Available Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Total Bytes"
        },
        "memory_used_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Used Bytes"
        },
        "memory_used_per_mille": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Memory Used Per Mille"
        },
        "rx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rx Bytes Per Second"
        },
        "tx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tx Bytes Per Second"
        },
        "xray_memory_resident_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xray Memory Resident Bytes"
        },
        "xray_uptime_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xray Uptime Seconds"
        }
      },
      "title": "CapacityValues",
      "type": "object"
    },
    "InboundConnections": {
      "additionalProperties": false,
      "description": "Aggregate only; never derived by enumerating client addresses or identities.",
      "properties": {
        "connections": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Connections",
          "type": "integer"
        },
        "inbound_tag": {
          "description": "Xray inbound tag.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Inbound Tag",
          "type": "string"
        }
      },
      "required": [
        "inbound_tag",
        "connections"
      ],
      "title": "InboundConnections",
      "type": "object"
    },
    "NetworkCapacity": {
      "additionalProperties": false,
      "description": "Host traffic on the default-route interface; includes overhead and non-VPN traffic.\n\nNo interface name, address, or device identifier leaves the host. The first\nsample of an epoch has zero counters and null rates. A missing or overlong\ninterval also has null rates; it must not manufacture a current speed.",
      "properties": {
        "counter_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Counter Epoch",
          "type": "string"
        },
        "interval_millis": {
          "anyOf": [
            {
              "maximum": 180000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval Millis"
        },
        "rx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Rx Bytes",
          "type": "integer"
        },
        "rx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rx Bytes Per Second"
        },
        "tx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tx Bytes",
          "type": "integer"
        },
        "tx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tx Bytes Per Second"
        }
      },
      "required": [
        "counter_epoch",
        "rx_bytes",
        "tx_bytes",
        "rx_bytes_per_second",
        "tx_bytes_per_second",
        "interval_millis"
      ],
      "title": "NetworkCapacity",
      "type": "object"
    },
    "NodeCapacity": {
      "additionalProperties": false,
      "description": "One collection, identified independently of delivery retries and wall-clock skew.",
      "properties": {
        "collected_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Collected At",
          "type": "string"
        },
        "collection_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Collection Epoch",
          "type": "string"
        },
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cpu Count"
        },
        "inbound_connections": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InboundConnections"
              },
              "maxItems": 1024,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null on the pinned core, which has no address-free aggregate inbound connection counter.",
          "title": "Inbound Connections"
        },
        "load15_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load15 Milli"
        },
        "load1_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load1 Milli"
        },
        "load5_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load5 Milli"
        },
        "memory_available_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Available Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Total Bytes"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "xray": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessCapacity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "collection_epoch",
        "sequence",
        "collected_at",
        "cpu_count",
        "load1_milli",
        "load5_milli",
        "load15_milli",
        "memory_total_bytes",
        "memory_available_bytes",
        "network",
        "xray",
        "inbound_connections"
      ],
      "title": "NodeCapacity",
      "type": "object"
    },
    "ProcessCapacity": {
      "additionalProperties": false,
      "description": "The managed Xray process; missing, changed, or unreadable evidence is null.",
      "properties": {
        "memory_resident_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Resident Bytes"
        },
        "uptime_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uptime Seconds"
        }
      },
      "required": [
        "uptime_seconds",
        "memory_resident_bytes"
      ],
      "title": "ProcessCapacity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "age_seconds": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Age Seconds"
    },
    "hourly": {
      "items": {
        "$ref": "#/$defs/CapacityHour"
      },
      "maxItems": 168,
      "title": "Hourly",
      "type": "array"
    },
    "last_day": {
      "$ref": "#/$defs/CapacityDay"
    },
    "node_id": {
      "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Node Id",
      "type": "string"
    },
    "received_at": {
      "anyOf": [
        {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Received At"
    },
    "recent": {
      "items": {
        "$ref": "#/$defs/CapacityPoint"
      },
      "maxItems": 360,
      "title": "Recent",
      "type": "array"
    },
    "recent_resolution_seconds": {
      "default": 10,
      "title": "Recent Resolution Seconds",
      "type": "integer"
    },
    "recent_window_seconds": {
      "default": 3600,
      "title": "Recent Window Seconds",
      "type": "integer"
    },
    "retention_hours": {
      "default": 168,
      "title": "Retention Hours",
      "type": "integer"
    },
    "sample": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeCapacity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "default": "not_reported",
      "enum": [
        "not_reported",
        "unavailable",
        "current",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "values": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapacityValues"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "node_id",
    "recent",
    "hourly",
    "last_day"
  ],
  "title": "NodeCapacityView",
  "type": "object"
}
