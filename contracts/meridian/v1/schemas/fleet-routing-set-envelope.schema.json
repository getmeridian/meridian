{
  "$defs": {
    "AccessChange": {
      "additionalProperties": false,
      "properties": {
        "gained": {
          "items": {
            "type": "string"
          },
          "title": "Gained",
          "type": "array"
        },
        "lost": {
          "items": {
            "type": "string"
          },
          "title": "Lost",
          "type": "array"
        },
        "profiles": {
          "items": {
            "maxLength": 48,
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Profiles",
          "type": "array"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "profiles",
        "gained",
        "lost"
      ],
      "title": "AccessChange",
      "type": "object"
    },
    "AccessProfileReview": {
      "additionalProperties": false,
      "properties": {
        "access_hash": {
          "description": "Lowercase hex SHA-256 digest.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Access Hash",
          "type": "string"
        },
        "access_profiles": {
          "maxProperties": 64,
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "items": {
                "pattern": "^inbound:[a-z0-9][a-z0-9:_.-]{0,191}$",
                "type": "string"
              },
              "maxItems": 10000,
              "type": "array"
            }
          },
          "propertyNames": {
            "maxLength": 48,
            "minLength": 1
          },
          "title": "Access Profiles",
          "type": "object"
        },
        "cut_off": {
          "$ref": "#/$defs/CutOffPlan"
        },
        "gained_people": {
          "minimum": 0,
          "title": "Gained People",
          "type": "integer"
        },
        "lost_people": {
          "minimum": 0,
          "title": "Lost People",
          "type": "integer"
        },
        "people": {
          "items": {
            "$ref": "#/$defs/AccessChange"
          },
          "title": "People",
          "type": "array"
        }
      },
      "required": [
        "access_hash",
        "access_profiles",
        "people",
        "gained_people",
        "lost_people",
        "cut_off"
      ],
      "title": "AccessProfileReview",
      "type": "object"
    },
    "ApplyCounts": {
      "additionalProperties": false,
      "description": "Aggregate counts for apply execution.",
      "properties": {
        "actions": {
          "title": "Actions",
          "type": "integer"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "skipped": {
          "title": "Skipped",
          "type": "integer"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "actions",
        "succeeded",
        "failed",
        "skipped"
      ],
      "title": "ApplyCounts",
      "type": "object"
    },
    "ClientRoutingChoice": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "policy": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Policy",
          "type": "string"
        },
        "preset": {
          "anyOf": [
            {
              "enum": [
                "ru-split",
                "full"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "rules": {
          "anyOf": [
            {
              "maximum": 128,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rules"
        }
      },
      "required": [
        "policy",
        "description"
      ],
      "title": "ClientRoutingChoice",
      "type": "object"
    },
    "CompiledApplyActionResult": {
      "additionalProperties": false,
      "description": "Execution result for one V4 compiler resource.",
      "properties": {
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "error": {
          "default": "",
          "title": "Error",
          "type": "string"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "converged",
            "applied",
            "failed",
            "unknown",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        }
      },
      "required": [
        "resource_id",
        "status",
        "success",
        "changed"
      ],
      "title": "CompiledApplyActionResult",
      "type": "object"
    },
    "CompiledApplyPreview": {
      "additionalProperties": false,
      "description": "Reviewed V4 compiler-plan metadata returned before confirmation.",
      "properties": {
        "access_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessProfileReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "resource_count": {
          "minimum": 0,
          "title": "Resource Count",
          "type": "integer"
        },
        "retiring_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retiring Resources",
          "type": "array"
        },
        "review_hash": {
          "default": "",
          "description": "Plan hash bound to the exact retirement set; equals plan_hash when nothing is removed.",
          "title": "Review Hash",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "resource_count"
      ],
      "title": "CompiledApplyPreview",
      "type": "object"
    },
    "CompiledApplyResult": {
      "additionalProperties": false,
      "description": "Apply result for one generation-scoped V4 compiler plan.",
      "properties": {
        "access_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccessProfileReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/CompiledApplyActionResult"
          },
          "title": "Actions",
          "type": "array"
        },
        "all_succeeded": {
          "title": "All Succeeded",
          "type": "boolean"
        },
        "changed": {
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "$ref": "#/$defs/ApplyCounts"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "plan_hash": {
          "title": "Plan Hash",
          "type": "string"
        },
        "retired_resources": {
          "items": {
            "type": "string"
          },
          "title": "Retired Resources",
          "type": "array"
        },
        "retirement_errors": {
          "items": {
            "type": "string"
          },
          "title": "Retirement Errors",
          "type": "array"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "plan_hash",
        "generation",
        "all_succeeded",
        "changed",
        "summary",
        "exit_code",
        "counts"
      ],
      "title": "CompiledApplyResult",
      "type": "object"
    },
    "CutOffNode": {
      "additionalProperties": false,
      "properties": {
        "effect": {
          "default": "inbound_reset",
          "description": "A core restart reconnects every Xray inbound and bridge on this node; an inbound reset reconnects the listed inbounds, with whole-core fallback on failure.",
          "enum": [
            "inbound_reset",
            "core_restart"
          ],
          "title": "Effect",
          "type": "string"
        },
        "inbound_tags": {
          "items": {
            "description": "Xray inbound tag.",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
            "type": "string"
          },
          "title": "Inbound Tags",
          "type": "array"
        },
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "inbound_tags"
      ],
      "title": "CutOffNode",
      "type": "object"
    },
    "CutOffPlan": {
      "additionalProperties": false,
      "description": "Every managed inbound that may hold the person's open sessions; contains no person or credential.",
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/CutOffNode"
          },
          "title": "Nodes",
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "title": "CutOffPlan",
      "type": "object"
    },
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "FleetRoutingResult": {
      "additionalProperties": false,
      "description": "Current or reviewed client policy, its meaning, and the apply when it ran.",
      "properties": {
        "applied": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledApplyResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/ClientRoutingChoice"
          },
          "maxItems": 66,
          "title": "Choices",
          "type": "array"
        },
        "client_routing": {
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Client Routing",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompiledApplyPreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "client_routing"
      ],
      "title": "FleetRoutingResult",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_FleetRoutingSetSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.routing.set",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/FleetRoutingResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "changed",
            "no_changes"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetRoutingSetSuccessEnvelope",
      "type": "object"
    },
    "_FleetRoutingSetTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "fleet.routing.set",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_FleetRoutingSetTerminalEnvelope",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "changed": "#/$defs/_FleetRoutingSetSuccessEnvelope",
      "failed": "#/$defs/_FleetRoutingSetTerminalEnvelope",
      "no_changes": "#/$defs/_FleetRoutingSetSuccessEnvelope",
      "ok": "#/$defs/_FleetRoutingSetSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_FleetRoutingSetSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_FleetRoutingSetTerminalEnvelope"
    }
  ],
  "title": "FleetRoutingSetOutputEnvelope"
}
