{
  "$defs": {
    "AttentionThresholds": {
      "additionalProperties": false,
      "properties": {
        "expiry_days": {
          "default": 7,
          "maximum": 30,
          "minimum": 1,
          "title": "Expiry Days",
          "type": "integer"
        },
        "quota_percent": {
          "default": 80,
          "maximum": 100,
          "minimum": 1,
          "title": "Quota Percent",
          "type": "integer"
        },
        "unused_days": {
          "default": 3,
          "maximum": 365,
          "minimum": 1,
          "title": "Unused Days",
          "type": "integer"
        }
      },
      "title": "AttentionThresholds",
      "type": "object"
    },
    "NodeAttention": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
          "maxLength": 48,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Node Id",
          "type": "string"
        },
        "reasons": {
          "description": "unhealthy includes degraded health or non-passing checks from a fresh report.",
          "items": {
            "enum": [
              "offline",
              "apply_failed",
              "unhealthy"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "reasons"
      ],
      "title": "NodeAttention",
      "type": "object"
    },
    "PersonAttention": {
      "additionalProperties": false,
      "properties": {
        "reasons": {
          "items": {
            "enum": [
              "expiring",
              "quota",
              "unused"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "username": {
          "title": "Username",
          "type": "string"
        }
      },
      "required": [
        "username",
        "reasons"
      ],
      "title": "PersonAttention",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Read-only warnings derived at observed_at; no attention state is stored.",
  "properties": {
    "nodes": {
      "items": {
        "$ref": "#/$defs/NodeAttention"
      },
      "title": "Nodes",
      "type": "array"
    },
    "observed_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Observed At",
      "type": "string"
    },
    "people": {
      "items": {
        "$ref": "#/$defs/PersonAttention"
      },
      "title": "People",
      "type": "array"
    },
    "thresholds": {
      "$ref": "#/$defs/AttentionThresholds"
    }
  },
  "required": [
    "observed_at",
    "thresholds",
    "people",
    "nodes"
  ],
  "title": "AttentionList",
  "type": "object"
}
