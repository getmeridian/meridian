{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "MeridianError": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "TestResult": {
      "additionalProperties": false,
      "description": "End-to-end proxy connection verification result.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/VerificationCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "client": {
          "default": "",
          "title": "Client",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/VerificationContext"
        },
        "counts": {
          "$ref": "#/$defs/VerificationCounts"
        },
        "exit_code": {
          "enum": [
            0,
            3,
            4
          ],
          "title": "Exit Code",
          "type": "integer"
        },
        "scope": {
          "default": "full",
          "enum": [
            "basic",
            "full"
          ],
          "title": "Scope",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/VerificationTarget"
        },
        "verdict": {
          "enum": [
            "passed",
            "findings",
            "inconclusive"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "target",
        "verdict",
        "exit_code",
        "counts"
      ],
      "title": "TestResult",
      "type": "object"
    },
    "VerificationCheck": {
      "additionalProperties": false,
      "description": "One independently reportable verification check.",
      "properties": {
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/VerificationFinding"
          },
          "title": "Findings",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "status"
      ],
      "title": "VerificationCheck",
      "type": "object"
    },
    "VerificationContext": {
      "additionalProperties": false,
      "description": "Secret-free Meridian metadata available while verifying a target.",
      "properties": {
        "domain": {
          "default": "",
          "title": "Domain",
          "type": "string"
        },
        "mode": {
          "default": "generic",
          "enum": [
            "generic",
            "meridian"
          ],
          "title": "Mode",
          "type": "string"
        },
        "protocols": {
          "items": {
            "enum": [
              "reality",
              "xhttp",
              "wss",
              "hysteria2"
            ],
            "type": "string"
          },
          "title": "Protocols",
          "type": "array"
        },
        "roles": {
          "items": {
            "enum": [
              "panel",
              "exit",
              "relay",
              "routing_gateway"
            ],
            "type": "string"
          },
          "title": "Roles",
          "type": "array"
        },
        "sni": {
          "default": "",
          "title": "Sni",
          "type": "string"
        }
      },
      "title": "VerificationContext",
      "type": "object"
    },
    "VerificationCounts": {
      "additionalProperties": false,
      "description": "Aggregate check counts by terminal status.",
      "properties": {
        "checks": {
          "minimum": 0,
          "title": "Checks",
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "title": "Failed",
          "type": "integer"
        },
        "passed": {
          "minimum": 0,
          "title": "Passed",
          "type": "integer"
        },
        "skipped": {
          "minimum": 0,
          "title": "Skipped",
          "type": "integer"
        },
        "warnings": {
          "minimum": 0,
          "title": "Warnings",
          "type": "integer"
        }
      },
      "required": [
        "checks",
        "passed",
        "failed",
        "warnings",
        "skipped"
      ],
      "title": "VerificationCounts",
      "type": "object"
    },
    "VerificationFinding": {
      "additionalProperties": false,
      "description": "One structured observation produced by a verification check.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "remediation": {
          "default": "",
          "title": "Remediation",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning",
            "skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "code",
        "status",
        "message"
      ],
      "title": "VerificationFinding",
      "type": "object"
    },
    "VerificationTarget": {
      "additionalProperties": false,
      "description": "Requested and resolved identity of one verification target.",
      "properties": {
        "requested": {
          "title": "Requested",
          "type": "string"
        },
        "resolved_ip": {
          "default": "",
          "title": "Resolved Ip",
          "type": "string"
        },
        "server_ref": {
          "default": "",
          "title": "Server Ref",
          "type": "string"
        }
      },
      "required": [
        "requested"
      ],
      "title": "VerificationTarget",
      "type": "object"
    },
    "_TestSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "test",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/TestResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_TestSuccessEnvelope",
      "type": "object"
    },
    "_TestTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "test",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestResult"
            },
            {
              "$ref": "#/$defs/EmptyData"
            }
          ],
          "title": "Data"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/MeridianError"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_TestTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for test JSON output.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_TestTerminalEnvelope",
      "ok": "#/$defs/_TestSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_TestSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_TestTerminalEnvelope"
    }
  ],
  "title": "TestOutputEnvelope"
}
