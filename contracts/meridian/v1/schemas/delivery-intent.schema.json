{
  "$defs": {
    "OwnerContact": {
      "additionalProperties": false,
      "properties": {
        "link": {
          "default": "",
          "maxLength": 2048,
          "pattern": "^(?:|https://[^\\s]+|tg://[^\\s]+|mailto:[^\\s]+)$",
          "title": "Link",
          "type": "string"
        },
        "text": {
          "default": "",
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Text",
          "type": "string"
        }
      },
      "title": "OwnerContact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical Remnawave subscription presentation settings.",
  "properties": {
    "client_routing": {
      "default": "ru-split",
      "description": "Client routing: ru-split bypasses Russian destinations; full tunnels them. Both bypass private/LAN ranges and retain Xray's best-effort BitTorrent bypass.",
      "enum": [
        "ru-split",
        "full"
      ],
      "title": "Client Routing",
      "type": "string"
    },
    "formats": {
      "items": {
        "enum": [
          "base64",
          "xray_json",
          "mihomo",
          "singbox"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Formats",
      "type": "array"
    },
    "owner_contact": {
      "$ref": "#/$defs/OwnerContact",
      "description": "Optional public owner contact, chosen through reviewed delivery intent."
    },
    "profile_title": {
      "default": "Meridian",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Profile Title",
      "type": "string"
    },
    "template_name": {
      "default": "meridian",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Template Name",
      "type": "string"
    },
    "update_interval_hours": {
      "default": 6,
      "maximum": 168,
      "minimum": 1,
      "title": "Update Interval Hours",
      "type": "integer"
    }
  },
  "title": "DeliveryIntent",
  "type": "object"
}
