{
  "additionalProperties": false,
  "description": "Canonical Remnawave subscription presentation settings.",
  "properties": {
    "client_routing": {
      "default": "ru-split",
      "description": "Client routing: ru-split bypasses Russian destinations; full tunnels them. Both bypass private/LAN ranges and retain Xray's best-effort BitTorrent bypass.",
      "enum": [
        "ru-split",
        "full"
      ],
      "title": "Client Routing",
      "type": "string"
    },
    "formats": {
      "items": {
        "enum": [
          "base64",
          "xray_json",
          "mihomo",
          "singbox"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Formats",
      "type": "array"
    },
    "profile_title": {
      "default": "Meridian",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[^\\r\\n\\t]+$",
      "title": "Profile Title",
      "type": "string"
    },
    "template_name": {
      "default": "meridian",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Template Name",
      "type": "string"
    },
    "update_interval_hours": {
      "default": 6,
      "maximum": 168,
      "minimum": 1,
      "title": "Update Interval Hours",
      "type": "integer"
    }
  },
  "title": "DeliveryIntent",
  "type": "object"
}
