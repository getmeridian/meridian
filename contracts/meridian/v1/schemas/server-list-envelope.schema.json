{
  "$defs": {
    "EmptyData": {
      "additionalProperties": false,
      "description": "Empty data object used by envelopes without command-specific failure data.",
      "properties": {},
      "title": "EmptyData",
      "type": "object"
    },
    "ErrorModel": {
      "additionalProperties": false,
      "description": "Structured error safe for JSON/API clients.",
      "properties": {
        "category": {
          "enum": [
            "user",
            "system",
            "bug",
            "cancelled"
          ],
          "title": "Category",
          "type": "string"
        },
        "cause": {
          "additionalProperties": true,
          "title": "Cause",
          "type": "object"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "exit_code": {
          "default": 1,
          "title": "Exit Code",
          "type": "integer"
        },
        "hint": {
          "default": "",
          "title": "Hint",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "category",
        "message"
      ],
      "title": "MeridianError",
      "type": "object"
    },
    "ServerListEntry": {
      "additionalProperties": false,
      "properties": {
        "declared": {
          "title": "Declared",
          "type": "boolean"
        },
        "host": {
          "title": "Host",
          "type": "string"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ServerMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "next_payment_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Payment On"
        },
        "server_ref": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\t]+$",
          "title": "Server Ref",
          "type": "string"
        },
        "ssh_port": {
          "title": "Ssh Port",
          "type": "integer"
        },
        "ssh_user": {
          "title": "Ssh User",
          "type": "string"
        }
      },
      "required": [
        "server_ref",
        "name",
        "host",
        "ssh_user",
        "ssh_port",
        "declared",
        "metadata"
      ],
      "title": "ServerListEntry",
      "type": "object"
    },
    "ServerListResult": {
      "additionalProperties": false,
      "description": "Saved server profiles with their topology-owned metadata; no credentials or guessed usage.",
      "properties": {
        "servers": {
          "items": {
            "$ref": "#/$defs/ServerListEntry"
          },
          "title": "Servers",
          "type": "array"
        }
      },
      "required": [
        "servers"
      ],
      "title": "ServerListResult",
      "type": "object"
    },
    "ServerMetadata": {
      "additionalProperties": false,
      "description": "Deployer-owned metadata keyed to a server declared in the topology.",
      "properties": {
        "allowance_bytes": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowance Bytes"
        },
        "pay_every": {
          "anyOf": [
            {
              "enum": [
                "month",
                "year"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay Every"
        },
        "pay_on": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pay On"
        },
        "provider": {
          "default": "",
          "maxLength": 80,
          "title": "Provider",
          "type": "string"
        },
        "reset_day": {
          "default": 1,
          "maximum": 31,
          "minimum": 1,
          "title": "Reset Day",
          "type": "integer"
        }
      },
      "title": "ServerMetadata",
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "Structured summary shown in JSON envelopes and UI dashboards.",
      "properties": {
        "changed": {
          "default": false,
          "title": "Changed",
          "type": "boolean"
        },
        "counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Counts",
          "type": "object"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "Summary",
      "type": "object"
    },
    "_ServerListSuccessEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "server.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/ServerListResult"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "maxItems": 0,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ServerListSuccessEnvelope",
      "type": "object"
    },
    "_ServerListTerminalEnvelope": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "const": "server.list",
          "title": "Command",
          "type": "string"
        },
        "data": {
          "$ref": "#/$defs/EmptyData"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "minItems": 1,
          "title": "Errors",
          "type": "array"
        },
        "exit_code": {
          "title": "Exit Code",
          "type": "integer"
        },
        "meridian_version": {
          "title": "Meridian Version",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "schema": {
          "const": "meridian.output/v1",
          "title": "Schema",
          "type": "string"
        },
        "started_at": {
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/Summary"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/ErrorModel"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "meridian_version",
        "command",
        "operation_id",
        "started_at",
        "duration_ms",
        "status",
        "exit_code",
        "summary",
        "warnings",
        "errors",
        "data"
      ],
      "title": "_ServerListTerminalEnvelope",
      "type": "object"
    }
  },
  "description": "Envelope schema for `meridian server list --json`.",
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/_ServerListTerminalEnvelope",
      "ok": "#/$defs/_ServerListSuccessEnvelope"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/_ServerListSuccessEnvelope"
    },
    {
      "$ref": "#/$defs/_ServerListTerminalEnvelope"
    }
  ],
  "title": "ServerListOutputEnvelope"
}
