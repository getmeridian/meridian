{
  "$defs": {
    "HealthCheck": {
      "additionalProperties": false,
      "description": "One local health probe (for example `xray`, `nginx`, `disk`).",
      "properties": {
        "message": {
          "description": "Operator-facing text. Never carries secrets, client addresses, or raw command lines.",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_.-]*$",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "message"
      ],
      "title": "HealthCheck",
      "type": "object"
    },
    "InboundConnections": {
      "additionalProperties": false,
      "description": "Aggregate only; never derived by enumerating client addresses or identities.",
      "properties": {
        "connections": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Connections",
          "type": "integer"
        },
        "inbound_tag": {
          "description": "Xray inbound tag.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Inbound Tag",
          "type": "string"
        }
      },
      "required": [
        "inbound_tag",
        "connections"
      ],
      "title": "InboundConnections",
      "type": "object"
    },
    "NetworkCapacity": {
      "additionalProperties": false,
      "description": "Host traffic on the default-route interface; includes overhead and non-VPN traffic.\n\nNo interface name, address, or device identifier leaves the host. The first\nsample of an epoch has zero counters and null rates. A missing or overlong\ninterval also has null rates; it must not manufacture a current speed.",
      "properties": {
        "counter_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Counter Epoch",
          "type": "string"
        },
        "interval_millis": {
          "anyOf": [
            {
              "maximum": 180000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Interval Millis"
        },
        "rx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Rx Bytes",
          "type": "integer"
        },
        "rx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rx Bytes Per Second"
        },
        "tx_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Tx Bytes",
          "type": "integer"
        },
        "tx_bytes_per_second": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tx Bytes Per Second"
        }
      },
      "required": [
        "counter_epoch",
        "rx_bytes",
        "tx_bytes",
        "rx_bytes_per_second",
        "tx_bytes_per_second",
        "interval_millis"
      ],
      "title": "NetworkCapacity",
      "type": "object"
    },
    "NodeCapacity": {
      "additionalProperties": false,
      "description": "One collection, identified independently of delivery retries and wall-clock skew.",
      "properties": {
        "collected_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Collected At",
          "type": "string"
        },
        "collection_epoch": {
          "description": "Identity of the agent's traffic counter store: a lowercase UUID the agent draws when it creates the store. It changes only when the store is lost, which restarts every cumulative counter from zero.",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Collection Epoch",
          "type": "string"
        },
        "cpu_count": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cpu Count"
        },
        "inbound_connections": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/InboundConnections"
              },
              "maxItems": 1024,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null on the pinned core, which has no address-free aggregate inbound connection counter.",
          "title": "Inbound Connections"
        },
        "load15_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load15 Milli"
        },
        "load1_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load1 Milli"
        },
        "load5_milli": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Load5 Milli"
        },
        "memory_available_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Available Bytes"
        },
        "memory_total_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Total Bytes"
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkCapacity"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "xray": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessCapacity"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "collection_epoch",
        "sequence",
        "collected_at",
        "cpu_count",
        "load1_milli",
        "load5_milli",
        "load15_milli",
        "memory_total_bytes",
        "memory_available_bytes",
        "network",
        "xray",
        "inbound_connections"
      ],
      "title": "NodeCapacity",
      "type": "object"
    },
    "NodeHealth": {
      "additionalProperties": false,
      "description": "Aggregate node health. Resource figures are integers to keep the protocol float-free.",
      "properties": {
        "checks": {
          "items": {
            "$ref": "#/$defs/HealthCheck"
          },
          "maxItems": 32,
          "title": "Checks",
          "type": "array"
        },
        "disk_free_bytes": {
          "description": "Free bytes on the filesystem holding the agent's state.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Disk Free Bytes",
          "type": "integer"
        },
        "load1_milli": {
          "description": "One-minute load average times 1000.",
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Load1 Milli",
          "type": "integer"
        },
        "memory_available_bytes": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Memory Available Bytes",
          "type": "integer"
        },
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "unhealthy"
          ],
          "title": "Status",
          "type": "string"
        },
        "uptime_seconds": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Uptime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "status",
        "checks",
        "uptime_seconds",
        "load1_milli",
        "memory_available_bytes",
        "disk_free_bytes"
      ],
      "title": "NodeHealth",
      "type": "object"
    },
    "NodeStateRef": {
      "additionalProperties": false,
      "description": "Points at one desired-state document by epoch, revision, and content hash.",
      "properties": {
        "fleet_epoch": {
          "description": "Fleet epoch. A restore of the control service bumps it. An agent remembers the highest epoch it accepted and refuses desired state and commands from an older one (a resurrected old control server).",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Fleet Epoch",
          "type": "integer"
        },
        "revision": {
          "description": "Desired-state revision for one node. Ordering is (fleet_epoch, revision): within an epoch revisions only grow; a higher epoch wins even with a lower revision.",
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "sha256": {
          "description": "The document's `sha256` (hash of its `resources`).",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "fleet_epoch",
        "revision",
        "sha256"
      ],
      "title": "NodeStateRef",
      "type": "object"
    },
    "NodeVersions": {
      "additionalProperties": false,
      "description": "Versions of what runs on the node; `null` for software that is not installed.",
      "properties": {
        "agent": {
          "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
          "title": "Agent",
          "type": "string"
        },
        "kernel": {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._+~-]+$",
          "title": "Kernel",
          "type": "string"
        },
        "nginx": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Nginx"
        },
        "os_id": {
          "description": "`ID` from /etc/os-release.",
          "maxLength": 32,
          "pattern": "^[a-z0-9._-]+$",
          "title": "Os Id",
          "type": "string"
        },
        "os_version": {
          "description": "`VERSION_ID`.",
          "maxLength": 32,
          "pattern": "^[A-Za-z0-9._-]*$",
          "title": "Os Version",
          "type": "string"
        },
        "realm": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Realm"
        },
        "xray": {
          "anyOf": [
            {
              "description": "Version string as its upstream publishes it, for example 26.7.11 or v2.9.6.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Xray"
        }
      },
      "required": [
        "agent",
        "xray",
        "realm",
        "nginx",
        "os_id",
        "os_version",
        "kernel"
      ],
      "title": "NodeVersions",
      "type": "object"
    },
    "ProcessCapacity": {
      "additionalProperties": false,
      "description": "The managed Xray process; missing, changed, or unreadable evidence is null.",
      "properties": {
        "memory_resident_bytes": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Memory Resident Bytes"
        },
        "uptime_seconds": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uptime Seconds"
        }
      },
      "required": [
        "uptime_seconds",
        "memory_resident_bytes"
      ],
      "title": "ProcessCapacity",
      "type": "object"
    },
    "ResourceError": {
      "additionalProperties": false,
      "description": "Why a resource or command did not converge.",
      "properties": {
        "code": {
          "enum": [
            "download_failed",
            "hash_mismatch",
            "path_not_allowed",
            "write_failed",
            "disk_full",
            "validation_failed",
            "reload_failed",
            "service_failed",
            "xray_api_failed",
            "flow_guard_pending",
            "apply_pending",
            "document_not_applied",
            "config_not_installed",
            "config_mismatch",
            "rolled_back",
            "timeout",
            "unsupported",
            "internal"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "description": "Operator-facing text. Never carries secrets, client addresses, or raw command lines.",
          "maxLength": 1000,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "description": "True when retrying after the stated condition can succeed; resources retry automatically, while commands require a new ID.",
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "ResourceError",
      "type": "object"
    },
    "ResourceObservation": {
      "additionalProperties": false,
      "description": "Observed state of one resource of the held document.\n\n`pending` is not yet applied, `applied` matches the desired spec, `failed`\ncarries an error, `drifted` was applied but no longer matches on the node,\nand `blocked` waits on a failed dependency.",
      "properties": {
        "applied_sha256": {
          "anyOf": [
            {
              "description": "Lowercase hex SHA-256 digest.",
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Protocol hash of the resource object last applied successfully; `null` if never applied.",
          "title": "Applied Sha256"
        },
        "changed_at": {
          "description": "RFC 3339 timestamp in UTC, ending in Z.",
          "maxLength": 40,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
          "title": "Changed At",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceError"
            },
            {
              "type": "null"
            }
          ],
          "description": "Set when `status` is `failed`, otherwise `null`."
        },
        "id": {
          "description": "Resource identifier, unique within one desired-state document and stable across revisions.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "file",
            "systemd_unit",
            "nginx_artifact",
            "xray_config",
            "xray_users",
            "hysteria2_users",
            "realm_forwarder",
            "firewall_rule",
            "binary_pin",
            "agent_upgrade"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "applied",
            "failed",
            "drifted",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "applied_sha256",
        "error",
        "changed_at"
      ],
      "title": "ResourceObservation",
      "type": "object"
    },
    "UserFlowBlocking": {
      "additionalProperties": false,
      "description": "Revoked identities cannot dispatch new flows, or their sessions ended in a core restart.\n\nCovers newly dispatched TCP streams and UDP associations, including an\nauthenticated QUIC or mux connection. Already dispatched flows and XUDP\nassociations may continue. Sent only with `user_flow_blocking` negotiated.\nAuthentication still applies if routing fails; the agent reports pending\nand retries the guard without requesting an inbound reset. Revocation rules\nlive only in the running core; restarting it clears their need.",
      "properties": {
        "document": {
          "$ref": "#/$defs/NodeStateRef",
          "description": "The applied document covered by fresh runtime evidence, which may precede unrelated service revisions."
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResourceError"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ready",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "document",
        "status",
        "error"
      ],
      "title": "UserFlowBlocking",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the node actually runs, sent after every apply and every `report_interval_seconds`.",
  "properties": {
    "applied": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeStateRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Last document fully applied; `null` before the first."
    },
    "capacity": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeCapacity"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Address-free capacity; omitted unless capacity_telemetry was negotiated."
    },
    "fleet_id": {
      "description": "Fleet identifier: a lowercase UUID fixed when the fleet is created.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Fleet Id",
      "type": "string"
    },
    "health": {
      "$ref": "#/$defs/NodeHealth"
    },
    "node_id": {
      "description": "Node identifier: the server's lowercase topology ID, unique within the fleet.",
      "maxLength": 48,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Node Id",
      "type": "string"
    },
    "observed_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Observed At",
      "type": "string"
    },
    "resources": {
      "description": "One entry per resource of `target`.",
      "items": {
        "$ref": "#/$defs/ResourceObservation"
      },
      "maxItems": 1024,
      "title": "Resources",
      "type": "array"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeStateRef"
        },
        {
          "type": "null"
        }
      ],
      "description": "Document being applied now, or `null` when idle."
    },
    "type": {
      "const": "report",
      "default": "report",
      "title": "Type",
      "type": "string"
    },
    "user_flow_blocking": {
      "anyOf": [
        {
          "$ref": "#/$defs/UserFlowBlocking"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Runtime user flow guard; omitted unless its capability was negotiated."
    },
    "versions": {
      "$ref": "#/$defs/NodeVersions"
    }
  },
  "required": [
    "type",
    "fleet_id",
    "node_id",
    "applied",
    "target",
    "resources",
    "health",
    "versions",
    "observed_at",
    "user_flow_blocking"
  ],
  "title": "ObservedStateReport",
  "type": "object"
}
