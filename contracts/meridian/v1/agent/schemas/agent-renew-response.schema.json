{
  "additionalProperties": false,
  "description": "The new node certificate; the old one stays valid until its own expiry or revocation.",
  "properties": {
    "certificate_expires_at": {
      "description": "RFC 3339 timestamp in UTC, ending in Z.",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "title": "Certificate Expires At",
      "type": "string"
    },
    "certificate_pem": {
      "description": "One X.509 certificate in PEM.",
      "maxLength": 8192,
      "minLength": 64,
      "pattern": "^-----BEGIN CERTIFICATE-----\\n[A-Za-z0-9+/=\\n]+-----END CERTIFICATE-----\\n?$",
      "title": "Certificate Pem",
      "type": "string"
    },
    "type": {
      "const": "renewed",
      "default": "renewed",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
    "type",
    "certificate_pem",
    "certificate_expires_at"
  ],
  "title": "RenewResponse",
  "type": "object"
}
