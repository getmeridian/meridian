<!DOCTYPE html>
<html lang="{{ lang }}" dir="{{ 'rtl' if lang == 'fa' else 'ltr' }}" data-language="{{ language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="{{ asset_path }}/language.js"></script>
<meta name="referrer" content="no-referrer">
<meta name="robots" content="noindex, nofollow, noarchive">
<meta name="theme-color" content="#0E1014" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#F3F4F6" media="(prefers-color-scheme: light)">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>{% if server_name %}{{ server_name }}{% elif client_name and client_name != 'default' %}Connection Setup — {{ client_name|capitalize }}{% else %}Connection Setup{% endif %}</title>
<meta property="og:title" content="{% if server_name %}{{ server_name }}{% else %}Connection Setup{% endif %}">
<meta property="og:description" content="Secure connection setup page">
<meta property="og:type" content="website">
<link rel="stylesheet" href="{{ asset_path }}/styles.css">
<link rel="manifest" href="{{ manifest_path }}">
<link rel="icon" type="image/svg+xml" href="{{ asset_path }}/icon.svg">
<link rel="apple-touch-icon" href="{{ asset_path }}/icon.svg">
</head>
<body>
<main class="wrap" id="app">
  {% if notice %}<section class="notice owner-notice" dir="auto" role="status"><p>{{ notice.text }}</p></section>{% endif %}
  <div class="skeleton" aria-hidden="true">
    <div class="skel skel-title"></div>
    <div class="skel skel-sub"></div>
    <div class="skel skel-card"></div>
  </div>
<noscript>
  {% set copy = {
    'en': ('Your subscription link', 'Copy this link into your VPN app as a subscription.', 'Use the personal link you received as the subscription URL in your VPN app.'),
    'ru': ('Ваша ссылка на подписку', 'Скопируйте ссылку и добавьте её как подписку в VPN-приложение.', 'Добавьте полученную личную ссылку в VPN-приложение как подписку.'),
    'fa': ('پیوند اشتراک شما', 'این پیوند را کپی کنید و به‌عنوان اشتراک در برنامهٔ VPN خود وارد کنید.', 'پیوند شخصی‌ای را که دریافت کردید به‌عنوان اشتراک در برنامهٔ VPN خود وارد کنید.'),
    'zh': ('你的订阅链接', '复制此链接，在 VPN 应用中添加订阅。', '在 VPN 应用中添加订阅时，粘贴你收到的个人链接。')
  }[lang] %}
  <section aria-labelledby="manual-setup-title">
    <h1 id="manual-setup-title">{{ copy[0] }}</h1>
    {% if subscription_url %}
    <p id="manual-setup-help">{{ copy[1] }}</p>
    <input class="manual-url" type="text" readonly dir="ltr" aria-labelledby="manual-setup-title" aria-describedby="manual-setup-help" value="{{ subscription_url }}">
    {% else %}
    <p>{{ copy[2] }}</p>
    {% endif %}
  </section>
</noscript>
</main>
<div class="toast" id="toast" role="alert" aria-live="polite"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><span data-t="copied">Copied</span></div>
<script src="{{ asset_path }}/contact.js"></script>
<script src="{{ asset_path }}/notice.js"></script>
<script src="{{ asset_path }}/app.js" data-config="{{ config_path }}" data-worker="{{ worker_path }}" data-scope="{{ worker_scope }}"></script>
</body>
</html>
