    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.2",
    "jsdom": "^29.0.1",
    "starlight-links-validator": "^0.26.0",
    "typescript": "^5.9.3"
  }
