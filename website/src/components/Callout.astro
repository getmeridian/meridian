---
interface Props {
  variant?: 'note' | 'warning' | 'tip' | 'danger';
  icon?: string;
}

const { variant = 'note', icon } = Astro.props;

const icons: Record<string, string> = {
  note: '→',
  warning: '!',
  tip: '✓',
  danger: '✕',
};
---

<div class:list={['callout', `callout--${variant}`]}>
  <span class="callout__icon" aria-hidden="true">{icon ?? icons[variant]}</span>
  <div class="callout__content"><slot /></div>
</div>

<style>
  .callout {
    --tone: var(--ac);
    --tone-bg: var(--ac3);
    display: flex;
    gap: 12px;
    margin: 20px 0;
    padding: 14px 18px;
    border-radius: var(--r);
    border-inline-start: 3px solid var(--tone);
    background: var(--tone-bg);
    color: var(--t1);
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .callout--warning {
    --tone: var(--warn);
    --tone-bg: var(--warn2);
  }
  .callout--tip {
    --tone: var(--ok);
    --tone-bg: var(--ok2);
  }
  .callout--danger {
    --tone: var(--err);
    --tone-bg: var(--err2);
  }
  .callout__icon {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--t2);
  }
  .callout__content {
    flex: 1;
  }
</style>
