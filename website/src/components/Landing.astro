---
/**
 * Landing — the home page, rendered once per locale to static HTML (`/`, `/ru/`,
 * `/fa/`, `/zh/`). Every string comes from src/i18n/landing/<locale>.ts; no
 * translation happens in the browser. Works fully without JavaScript.
 */
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import AtlasIcon from './AtlasIcon.astro';
import '../styles/landing.css';
import SectionHead from './SectionHead.astro';
import CodeBlock from './CodeBlock.astro';
import Timeline from './Timeline.astro';
import AppGrid from './AppGrid.astro';
import Accordion from './Accordion.astro';
import Callout from './Callout.astro';
import CommandBuilder from './CommandBuilder.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import Showcase from './Showcase.astro';
import { LOCALES, LOCALE_INFO, homeOf, landingT, type LandingKey, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = landingT(locale);
const site = Astro.site!;

const steps = ([1, 2, 3, 4, 5, 6] as const).map((n) => ({
  title: t(`step.${n}.title`),
  text: t(`step.${n}.text`),
}));
const accordion = (key: string) => ({ title: t(key as LandingKey), body: t(`${key}.body` as LandingKey) });
const tech = ['tech.dpi', 'tech.probe', 'tech.fp'].map(accordion);
const arch = ['arch.standalone', 'arch.domain', 'arch.relay'].map(accordion);

const alternates = [
  ...LOCALES.map((l) => ({ hreflang: LOCALE_INFO[l].hreflang, href: new URL(homeOf(l), site).href })),
  { hreflang: 'x-default', href: new URL('/', site).href },
];
// The walkthrough video has an English and a Russian cut (video/scripts/export.mjs); other locales get English.
const videoCut = locale === 'ru' ? '.ru' : '';
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: LOCALE_INFO[locale].lang,
  mainEntity: tech.map((item) => ({
    '@type': 'Question',
    name: item.title,
    acceptedAnswer: { '@type': 'Answer', text: plain(item.body.replace(/<\/p><p>/g, ' ')) },
  })),
};
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Meridian',
  url: site.href.replace(/\/$/, ''),
  logo: new URL('/img/logo-512.png', site).href,
  sameAs: ['https://github.com/getmeridian/meridian'],
};
---

<Base
  title={t('page.title')}
  description={t('page.description')}
  ogImageAlt={t('page.ogAlt')}
  locale={locale}
  alternates={alternates}
>
  {locale === 'en' && (
    <script slot="early" is:inline>
      // `/` opens the saved language, else the browser's, unless the reader chose English.
      try {
        var saved = localStorage.getItem('meridian-lang');
        var lang = saved || (navigator.language || '').slice(0, 2).toLowerCase();
        if (['ru', 'fa', 'zh'].indexOf(lang) !== -1) location.replace('/' + lang + '/' + location.hash);
      } catch (e) {}
    </script>
  )}
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    <script type="application/ld+json" set:html={JSON.stringify(faq)} />
  </Fragment>

  <main id="main">
    <Hero locale={locale} />

    <section id="demo" class="section" aria-labelledby="tour-title">
      <div class="container">
        <SectionHead index="01" id="tour-title" eyebrow={t('showcase.label')} title={t('showcase.title')} desc={t('showcase.desc')} />
        <Showcase locale={locale} />
        <div class="landing__extra">
          <Accordion title={t('connect.title')}>
            <div id="connect"><AppGrid note={t('connect.apps.more')} /></div>
            <Callout variant="tip">{t('connect.clock')}</Callout>
          </Accordion>
        </div>
      </div>
    </section>

    <section id="setup" class="section landing__band" aria-labelledby="setup-title">
      <div class="container">
        <SectionHead index="02" id="setup-title" eyebrow={t('setup.label')} title={t('setup.title')} desc={t('setup.desc')} />
        <div class="setup__grid">
          <div class="setup__commands">
            <CodeBlock code="curl -sSf https://getmeridian.org/install.sh | bash" label={t('setup.step1.label')} copyLabel={t('builder.copy')} copiedLabel={t('builder.copied')} />
            <CodeBlock code="meridian setup" label={t('setup.step2.label')} copyLabel={t('builder.copy')} copiedLabel={t('builder.copied')} />
            <p class="setup__hint" set:html={t('setup.hint')} />
          </div>
          <figure id="video" class="setup__video">
            <video controls preload="none" playsinline poster={`/video/meridian-setup${videoCut}-poster.jpg`} width="1280" height="720" aria-label={t('setup.videoLabel')}>
              <source src={`/video/meridian-setup${videoCut}.mp4`} type="video/mp4" />
            </video>
            <figcaption set:html={t('setup.video')} />
          </figure>
        </div>
        <div class="landing__extra">
          <Accordion title={t('setup.details')}>
            <Timeline steps={steps} />
            <Callout variant="tip">{t('setup.idempotent')}</Callout>
          </Accordion>
          <Accordion title={t('builder.title')}>
            <p id="builder-section" class="setup__builder-intro">{t('builder.desc')}</p>
            <CommandBuilder locale={locale} />
          </Accordion>
        </div>
      </div>
    </section>

    <section id="technology" class="section" aria-labelledby="notes-title">
      <div class="container">
        <SectionHead index="03" id="notes-title" eyebrow={t('tech.label')} title={t('tech.title')} desc={t('tech.desc')} />
        <div class="notes__grid">
          <div>
            <h3 class="notes__label">{t('tech.group')}</h3>
            {tech.map(item => <Accordion title={item.title}><Fragment set:html={item.body} /></Accordion>)}
          </div>
          <div id="architecture">
            <h3 class="notes__label">{t('arch.title')}</h3>
            {arch.map(item => <Accordion title={item.title}><Fragment set:html={item.body} /></Accordion>)}
            <Accordion title={t('arch.figure')}><ArchitectureDiagram label={t('arch.alt')} /></Accordion>
          </div>
        </div>
        <a class="atlas-link notes__link" href={`/${locale}/architecture/`}>{t('arch.docs')} <span class="atlas-forward"><AtlasIcon name="arrow" size={16} /></span></a>
      </div>
    </section>

    <section id="cta" class="closing" aria-labelledby="closing-title">
      <div class="container closing__inner">
        <div class="closing__text">
          <h2 id="closing-title">{t('cta.title')}</h2>
          <p>{t('cta.desc')}</p>
        </div>
        <div class="btn-row closing__actions">
          <a href="#setup" class="btn btn--primary">{t('hero.cta')} <span class="atlas-forward"><AtlasIcon name="arrow" /></span></a>
          <a href={`/${locale}/getting-started/`} class="atlas-link">{t('hero.docs')}</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .landing__band { background: var(--band); }
  .setup__grid, .notes__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 4vw, 60px); }
  .setup__commands :global(.code-block) { margin: 0 0 14px; background: var(--s1); }
  .setup__commands :global(.code-block__label) { color: var(--ac-text); padding-block: 9px; }
  .setup__hint, .setup__video figcaption { font-size: .96rem; line-height: 1.5; color: var(--t2); }
  .setup__hint :global(a), .setup__video :global(a) { text-decoration: underline; text-underline-offset: .2em; }
  .setup__video { margin: 0; }
  .setup__video video { display: block; width: 100%; height: auto; border-radius: var(--r); background: var(--atlas-night); }
  .setup__video figcaption { margin-top: 10px; }
  .setup__builder-intro { margin: 0 0 16px; }
  .landing__extra { margin-top: clamp(22px, 3vw, 40px); border-top: 1px solid var(--b2); }
  .landing__extra :global(.accordion), .notes__grid :global(.accordion) {
    background: transparent; border: 0; border-bottom: 1px solid var(--b1);
    border-radius: 0; box-shadow: none; overflow: visible;
  }
  .landing__extra :global(.accordion + .accordion), .notes__grid :global(.accordion + .accordion) { margin-top: 0; }
  .landing__extra :global(.accordion__trigger), .notes__grid :global(.accordion__trigger) { padding: 16px 4px; }
  .landing__extra :global(.accordion__content), .notes__grid :global(.accordion__content) { padding: 0 4px 20px; }
  .notes__label { padding-bottom: 14px; border-bottom: 1px solid var(--b2); font-size: 1.35rem; }
  .notes__link { margin-top: 18px; }
  .closing {
    background: var(--atlas-night); color: var(--atlas-paper); border-block-start: 2px solid var(--atlas-brass);
  }
  .container.closing__inner { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 26px 64px; padding-block: clamp(44px, 5.5vw, 76px); }
  .closing h2 { color: var(--atlas-paper); }
  .closing__text { max-width: 57ch; }
  .closing__text p { margin-top: 14px; color: var(--atlas-silver); font-size: 1.05rem; }
  .closing__actions { align-items: center; gap: 12px 24px; }
  .closing__actions .btn { background: var(--atlas-brass); color: var(--atlas-night); }
  .closing__actions .btn:hover { background: var(--atlas-paper); }
  .closing__actions .atlas-link { color: var(--atlas-paper); text-decoration-color: var(--atlas-silver); }
  @media (max-width: 760px) {
    .setup__grid, .notes__grid { grid-template-columns: minmax(0, 1fr); gap: 28px; }
  }
</style>
