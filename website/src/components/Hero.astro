---
/**
 * Hero — benefits first: "share secure internet" before "deploy VLESS+Reality".
 */
import { landingT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = landingT(locale);
---

<section class="hero">
  <div class="container">
    <div class="hero__content">
      <p class="eyebrow">{t('hero.kicker')}</p>
      <h1 class="hero__title" set:html={t('hero.title')} />
      <p class="hero__sub">{t('hero.sub')}</p>
      <div class="btn-row">
        <a href="#setup" class="btn btn--primary">{t('hero.cta')}</a>
        <a href={`/${locale}/getting-started/`} class="btn btn--secondary">{t('hero.docs')}</a>
      </div>
    </div>

    <figure class="hero__preview">
      <a href="/demo/" class="hero__frame">
        <img src="/img/connection-page.png" alt={t('hero.previewAlt')} width="1200" height="855" fetchpriority="high" />
      </a>
      <figcaption set:html={t('hero.caption')} />
    </figure>
  </div>
</section>

<style>
  .hero {
    padding: clamp(40px, 7vw, 80px) 0 var(--section-y);
    background:
      radial-gradient(60% 50% at 50% 100%, var(--ac3), transparent 70%),
      linear-gradient(var(--bg), var(--band));
    border-bottom: 1px solid var(--b1);
  }
  .hero__content {
    max-width: 680px;
    margin-bottom: clamp(36px, 6vw, 56px);
  }
  .hero__title {
    margin-bottom: 20px;
  }
  .hero__title :global(em) {
    font-style: italic;
    font-weight: 500;
    color: var(--ac-text);
  }
  /* The italic face covers Latin only; other scripts keep upright accent words. */
  :global(:is(:lang(ru), :lang(fa), :lang(zh))) .hero__title :global(em) {
    font-style: normal;
  }
  .hero__sub {
    font-size: clamp(1.06rem, 1.6vw, 1.18rem);
    color: var(--t2);
    max-width: 580px;
    margin-bottom: 32px;
    line-height: 1.7;
  }
  .hero__preview {
    max-width: 820px;
    margin: 0 auto;
  }
  .hero__frame {
    display: block;
    border-radius: var(--r2);
    overflow: hidden;
    border: 1px solid var(--b1);
    box-shadow: var(--shadow-lg);
    transition: border-color 0.2s, transform 0.2s;
  }
  .hero__frame:hover {
    border-color: var(--b2);
    transform: translateY(-2px);
  }
  .hero__frame img {
    display: block;
    width: 100%;
    height: auto;
  }
  .hero__preview figcaption {
    text-align: center;
    font-size: 0.88rem;
    color: var(--t2);
    margin-top: 14px;
  }
</style>
