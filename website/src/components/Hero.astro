---
import globe from '../assets/network-globe.svg?url';
import { landingT, type Locale } from '../i18n';
import AtlasIcon from './AtlasIcon.astro';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = landingT(locale);
const specs = [
  { icon: 'server', label: t('spec.server'), value: t('spec.serverValue') },
  { icon: 'protocol', label: t('spec.protocols'), value: 'Reality / XHTTP / Hysteria2' },
  { icon: 'source', label: t('spec.license'), value: t('spec.licenseValue') },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__spread">
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title" set:html={t('hero.title')} />
      <p class="hero__sub">{t('hero.sub')}</p>
      <div class="hero__actions btn-row">
        <a href="#setup" class="btn btn--primary">{t('hero.cta')} <span class="atlas-forward"><AtlasIcon name="arrow" /></span></a>
        <a href="#demo" class="atlas-link">{t('hero.demo')} <AtlasIcon name="down" size={16} /></a>
      </div>
    </div>
    <figure class="hero__plate" data-atlas data-state="still">
      <div class="hero__globe">
        <img src={globe} width="534" height="424" alt={t('hero.mapAlt')} draggable="false" fetchpriority="high" decoding="async" />
        <canvas width="534" height="424" aria-hidden="true"></canvas>
        <button class="hero__grab" data-atlas-grab type="button" hidden aria-label={t('hero.grab')}
          aria-describedby="atlas-gesture-help" aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown Home"></button>
        <span class="hero__sr" id="atlas-gesture-help">{t('hero.keys')}</span>
        <button class="hero__motion" data-atlas-motion type="button" hidden aria-label={t('hero.pause')}
          data-pause={t('hero.pause')} data-resume={t('hero.resume')}>
          <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path class="hero__pause" d="M7 5v10m6-10v10" />
            <path class="hero__play" d="m6 4 9 6-9 6z" />
          </svg>
        </button>
      </div>
    </figure>
  </div>
  <div class="hero__specs">
    <dl class="container hero__spec-list">
      {specs.map(({ icon, label, value }) => (
        <div class="hero__spec">
          <dt><span class="hero__spec-icon"><AtlasIcon name={icon} size={21} /></span><span class="atlas-label">{label}</span></dt>
          <dd>{icon === 'protocol' ? <bdi dir="ltr">{value}</bdi> : value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  import { mountAtlas } from './atlas-motion';
  document.querySelectorAll<HTMLElement>('[data-atlas]').forEach(figure => mountAtlas(figure));
</script>

<style>
  .container.hero__spread {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 3vw, 55px);
    padding-block: clamp(24px, 2.15vw, 36px);
  }
  .hero__copy { padding-block: 12px; }
  .hero__title {
    font-size: clamp(3.25rem, 5.65vw, 5.55rem);
    line-height: 1.01;
    letter-spacing: -.038em;
    font-weight: 500;
    text-wrap: initial;
  }
  .hero__title :global(em) {
    display: block;
    font-style: italic;
    color: var(--ac-text);
    letter-spacing: -.034em;
  }
  .hero__title:lang(ru) { font-size: clamp(3rem, 5.1vw, 5.15rem); }
  .hero__title:is(:lang(ru), :lang(fa), :lang(zh)) :global(em) { font-style: normal; letter-spacing: inherit; }
  .hero__sub {
    margin: clamp(18px, 2vw, 27px) 0;
    max-width: 43ch;
    font-size: clamp(1.1rem, 1.45vw, 1.31rem);
    line-height: 1.53;
    color: var(--t2);
  }
  .hero__actions.btn-row { align-items: center; gap: 12px 26px; }
  .hero__plate { min-width: 0; max-width: 610px; width: 100%; justify-self: center; }
  .hero__globe { position: relative; }
  .hero__globe canvas { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__globe canvas { transition: opacity .24s ease; }
  }
  [data-painted] .hero__globe canvas { opacity: 1; }
  .hero__grab { position: absolute; left: 19.66%; top: 11.09%; width: 62.17%; height: 78.30%;
    border: 0; padding: 0; border-radius: 50%; background: transparent; touch-action: pan-y pinch-zoom;
    cursor: grab; user-select: none; -webkit-tap-highlight-color: transparent; }
  .hero__grab:active, [data-state="dragging"] .hero__grab { cursor: grabbing; }
  .hero__grab:focus-visible { border-radius: 50%; outline: 2px solid var(--ac-text); outline-offset: 5px; }
  .hero__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .hero__motion {
    position: absolute; inset-inline-end: 5%; bottom: 3%; display: grid; place-items: center;
    width: 28px; height: 28px; padding: 0; border-radius: 50%; border: 1px solid var(--b2);
    background: var(--bg); color: var(--t2); cursor: pointer;
  }
  .hero__motion::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; }
  .hero__motion:hover { color: var(--ac-text); border-color: var(--ac-text); }
  .hero__motion:focus-visible { border-radius: 50%; outline: 2px solid var(--ac-text); outline-offset: 3px; }
  .hero__motion[hidden], .hero__grab[hidden], .hero__play { display: none; }
  .hero__motion[data-paused] .hero__play { display: block; }
  .hero__motion[data-paused] .hero__pause { display: none; }
  .hero__plate img { display: block; width: 100%; height: auto; }
  .hero__specs { background: var(--band); border-block: 1px solid var(--b1); }
  .container.hero__spec-list { display: grid; grid-template-columns: 1fr 1.2fr .9fr; padding-block: 21px; }
  .hero__spec { position: relative; min-width: 0; padding-inline-start: 44px; }
  .hero__spec + .hero__spec { border-inline-start: 1px solid var(--b2); padding-inline-start: clamp(58px, 6vw, 94px); }
  .hero__spec dt { line-height: 1; margin-bottom: 5px; }
  .hero__spec dt .atlas-label { color: var(--t3); font-size: .64rem; }
  .hero__spec-icon { position: absolute; inset-inline-start: 0; top: 50%; transform: translateY(-50%); color: var(--ac-text); display: flex; }
  .hero__spec + .hero__spec .hero__spec-icon { inset-inline-start: clamp(19px, 3vw, 50px); }
  .hero__spec dd { font-size: 1.04rem; font-weight: 600; line-height: 1.35; }
  @media (max-width: 850px) and (min-width: 721px) {
    .hero__spec { padding-inline-start: 32px; }
    .hero__spec + .hero__spec { padding-inline-start: 45px; }
    .hero__spec + .hero__spec .hero__spec-icon { inset-inline-start: 14px; }
    .hero__spec dd { font-size: .94rem; }
  }
  @media (max-width: 720px) {
    .container.hero__spread { grid-template-columns: minmax(0, 1fr); gap: 20px; padding-block: 36px 22px; }
    .hero__copy { padding: 0; }
    .hero__title, .hero__title:lang(ru) { font-size: clamp(3rem, 10.5vw, 4.7rem); }
    .hero__sub { margin-block: 16px 20px; }
    .hero__actions.btn-row { column-gap: 18px; }
    .hero__actions .btn { padding-inline: 16px; gap: 8px; }
    .hero__plate { max-width: 395px; }
    .container.hero__spec-list { grid-template-columns: 1fr 1.4fr .85fr; padding-block: 14px; gap: 10px; }
    .hero__spec, .hero__spec + .hero__spec { padding-inline-start: 0; border: none; }
    .hero__spec dd { font-size: .87rem; }
    .hero__spec-icon { display: none; }
  }
  @media (max-width: 370px) {
    .hero__actions.btn-row { column-gap: 16px; }
    .hero__actions .btn { padding-inline: 16px; }
    .container.hero__spec-list { grid-template-columns: 1fr 1.2fr .85fr; }
    .hero__spec dd { font-size: .8rem; }
  }
</style>
