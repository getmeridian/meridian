---
/**
 * Footer — one footer for every non-docs page. The version comes from the repo's
 * VERSION file at build time (Base.astro), so no request is made to show it.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { shellT, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  version: string;
}

const { locale, version } = Astro.props;
const t = shellT(locale);
---

<footer class="footer" data-i18n-scope>
  <div class="footer__inner">
    <div class="footer__brand">
      <Image src={logo} alt="" width={40} height={40} />
      <p class="footer__tagline" data-t="footer.tagline">{t('footer.tagline')}</p>
    </div>
    <nav class="footer__links" aria-label="Footer">
      <a href={`/${locale}/getting-started/`} data-docs-link data-t="nav.docs">{t('nav.docs')}</a>
      <a href="/blog/" data-t="nav.blog">{t('nav.blog')}</a>
      <a href="/demo/" data-t="nav.demo">{t('nav.demo')}</a>
      <a href="https://github.com/getmeridian/meridian">GitHub</a>
      <a href="https://github.com/getmeridian/meridian/issues" data-t="footer.issues">{t('footer.issues')}</a>
      <a href="/blog/rss.xml" data-t="footer.rss">{t('footer.rss')}</a>
    </nav>
    <p class="footer__version"><a href="https://github.com/getmeridian/meridian/blob/main/CHANGELOG.md">v{version}</a></p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 48px;
    border-top: 1px solid var(--b1);
  }
  .footer__inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 32px var(--gutter) 40px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 16px 32px;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .footer__brand img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }
  .footer__tagline {
    font-size: 0.9rem;
    color: var(--t2);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 0.9rem;
  }
  .footer__links a {
    color: var(--t2);
  }
  .footer__links a:hover {
    color: var(--t1);
  }
  .footer__version {
    grid-column: 1 / -1;
    font-family: var(--mono);
    font-size: 0.74rem;
  }
  .footer__version a {
    color: var(--t3);
  }
  .footer__version a:hover {
    color: var(--t1);
  }
  @media (max-width: 720px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
