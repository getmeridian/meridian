---
/**
 * Layout for diagrams rendered at authoring time (src/lib/diagrams.mjs). The SVGs carry their
 * own theme colors; this only places them. No script: nothing renders in the browser.
 */
---

<style is:global>
  figure.diagram {
    margin: 1.5rem 0;
    overflow-x: auto;
    text-align: center;
  }
  figure.diagram svg {
    display: inline-block;
    height: auto;
  }
</style>
