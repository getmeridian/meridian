---
/**
 * CopyButton — copies `text`. The click handling lives in copy.ts; styles are global
 * so the command builder's copy button shares them.
 */
interface Props {
  text: string;
  label?: string;
  copiedLabel?: string;
  class?: string;
}

const { text, label = 'Copy', copiedLabel = 'Copied', class: className = '' } = Astro.props;
---

<button type="button" class:list={['copy-btn', className]} data-copy={text} data-copied-label={copiedLabel} aria-label={`${label}: ${text}`}>
  <span class="copy-btn__label">{label}</span>
  <svg class="copy-btn__icon" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="9" y="9" width="13" height="13" rx="2"></rect>
    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
  </svg>
  <svg class="copy-btn__check" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="20 6 9 17 4 12"></polyline>
  </svg>
</button>

<script>
  import { wireCopyButtons } from './copy';
  wireCopyButtons();
</script>

<style is:global>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--s1);
    border: 1px solid var(--b1);
    color: var(--t2);
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 500;
    padding: 5px 10px;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.12s, border-color 0.12s;
  }
  .copy-btn:hover {
    color: var(--t1);
    border-color: var(--b2);
  }
  .copy-btn[data-copied] {
    color: var(--ok);
    border-color: var(--ok);
  }
  .copy-btn__check,
  .copy-btn[data-copied] .copy-btn__icon {
    display: none;
  }
  .copy-btn[data-copied] .copy-btn__check {
    display: block;
  }
</style>
