---
/**
 * AppGrid — the recommended apps from the shared data file (single source of truth).
 * Connection pages list the same apps first and link the rest per platform.
 * CI validates these links match the PWA app metadata in render.py.
 */
import appsData from '../data/apps.json';

interface Props {
  /** Trusted HTML shown under the grid. */
  note: string;
}

interface App {
  name: string;
  platform: string;
  url: string;
  recommended?: string[];
}

const { note } = Astro.props;
const apps: App[] = (appsData as App[]).filter((app) => (app.recommended ?? []).length > 0);
---

<div class="app-grid">
  {apps.map((app) => (
    <a class="app-grid__item card" href={app.url} rel="noopener">
      <span class="app-grid__name">{app.name}</span>
      <span class="app-grid__platform">{app.platform}</span>
    </a>
  ))}
</div>
<p class="app-grid__note" set:html={note} />

<style>
  .app-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin: 0 0 14px;
  }
  .app-grid__item {
    padding: 18px 12px;
    text-align: center;
    color: var(--t1);
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-radius: var(--r);
  }
  .app-grid__item:hover {
    color: var(--t1);
  }
  .app-grid__name {
    font-size: 0.97rem;
    font-weight: 600;
  }
  .app-grid__platform {
    font-size: 0.74rem;
    color: var(--t3);
    font-family: var(--mono);
  }
  .app-grid__note {
    font-size: 0.92rem;
    color: var(--t2);
  }

  @media (max-width: 560px) {
    .app-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
