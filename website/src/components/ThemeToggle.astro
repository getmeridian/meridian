---
/**
 * ThemeToggle — a "dark theme" switch (aria-pressed). Follows the OS until clicked;
 * only a click saves the choice, in both `meridian-theme` and Starlight's
 * `starlight-theme`, so landing, blog, and docs agree. Hidden without JavaScript.
 */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button class="theme-toggle" type="button" aria-label={label} title={label} aria-pressed="false" data-t-label="nav.theme" hidden>
  <svg class="theme-toggle__moon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <svg class="theme-toggle__sun" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4.5"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
  </svg>
</button>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var media = window.matchMedia('(prefers-color-scheme: dark)');
    var buttons = document.querySelectorAll('.theme-toggle');
    function isDark() {
      var forced = root.dataset.theme;
      return forced ? forced === 'dark' : media.matches;
    }
    function sync() {
      buttons.forEach(function (b) {
        b.setAttribute('aria-pressed', String(isDark()));
      });
    }
    buttons.forEach(function (b) {
      b.hidden = false;
      b.addEventListener('click', function () {
        var theme = isDark() ? 'light' : 'dark';
        root.dataset.theme = theme;
        try {
          localStorage.setItem('meridian-theme', theme);
          localStorage.setItem('starlight-theme', theme);
        } catch (e) {}
        sync();
      });
    });
    // Without a saved choice, keep following the OS.
    media.addEventListener('change', function () {
      var saved;
      try {
        saved = localStorage.getItem('starlight-theme') || localStorage.getItem('meridian-theme');
      } catch (e) {}
      if (saved !== 'dark' && saved !== 'light') root.dataset.theme = media.matches ? 'dark' : 'light';
      sync();
    });
    sync();
  })();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: none;
    border: none;
    border-radius: var(--r);
    color: var(--t2);
    cursor: pointer;
  }
  .theme-toggle[hidden] {
    display: none;
  }
  .theme-toggle:hover {
    color: var(--t1);
    background: var(--s2);
  }
  /* Show the theme a click switches to. */
  .theme-toggle__sun,
  .theme-toggle[aria-pressed='true'] .theme-toggle__moon {
    display: none;
  }
  .theme-toggle[aria-pressed='true'] .theme-toggle__sun {
    display: block;
  }
</style>
