---
interface Step {
  title: string;
  /** Trusted HTML that continues the sentence after the bold title. */
  text: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="timeline">
  {steps.map((step, i) => (
    <li class="timeline__item">
      <span class="timeline__number" aria-hidden="true">{i + 1}</span>
      <p class="timeline__content">
        <strong>{step.title}</strong><span set:html={step.text} />
      </p>
    </li>
  ))}
</ol>

<style>
  .timeline {
    list-style: none;
    margin: 20px 0;
  }
  .timeline__item {
    position: relative;
    display: flex;
    gap: 16px;
    padding-bottom: 18px;
    font-size: 0.97rem;
    line-height: 1.6;
  }
  /* The connecting line runs from one number to the next. */
  .timeline__item:not(:last-child)::before {
    content: '';
    position: absolute;
    inset-inline-start: 13px;
    top: 30px;
    bottom: 2px;
    width: 1px;
    background: var(--b1);
  }
  .timeline__number {
    flex-shrink: 0;
    width: 27px;
    height: 27px;
    border-radius: 50%;
    background: var(--ac2);
    border: 1px solid var(--ac);
    color: var(--ac-text);
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .timeline__content {
    color: var(--t2);
    padding-top: 2px;
  }
  .timeline__content strong {
    color: var(--t1);
    font-weight: 600;
  }
</style>
