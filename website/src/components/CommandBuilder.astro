---
/**
 * CommandBuilder — pick options, copy a meridian command.
 *
 * Commands and flags come from src/data/command-builder.json, which
 * tests/test_website_command_builder.py checks against the live CLI. Text is rendered
 * per locale at build time; the script receives only the current locale's strings.
 */
import config from '../data/command-builder.json';
import { landingT, type LandingKey, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

type FieldId = keyof typeof config.fields;
interface FieldText {
  label: LandingKey;
  hint: LandingKey;
  placeholder?: LandingKey;
}

const { locale } = Astro.props;
const t = landingT(locale);

const TAB_TEXT: Record<string, { label: LandingKey; desc: LandingKey }> = {
  deploy: { label: 'builder.tab.deploy', desc: 'builder.desc.deploy' },
  relay: { label: 'builder.tab.relay', desc: 'builder.desc.relay' },
  check: { label: 'builder.tab.check', desc: 'builder.desc.check' },
  scan: { label: 'builder.tab.scan', desc: 'builder.desc.scan' },
  doctor: { label: 'builder.tab.doctor', desc: 'builder.desc.doctor' },
  teardown: { label: 'builder.tab.teardown', desc: 'builder.desc.teardown' },
};
const FIELD_TEXT: Record<FieldId, FieldText> = {
  user: { label: 'builder.field.user', hint: 'builder.field.user.hint' },
  sshPort: { label: 'builder.field.sshPort', hint: 'builder.field.sshPort.hint' },
  exit: { label: 'builder.field.exit', hint: 'builder.field.exit.hint', placeholder: 'builder.field.exit.placeholder' },
  domain: { label: 'builder.field.domain', hint: 'builder.field.domain.hint' },
  sni: { label: 'builder.field.sni', hint: 'builder.field.sni.hint', placeholder: 'builder.field.sni.placeholder' },
  relaySni: { label: 'builder.field.sni', hint: 'builder.field.relaySni.hint', placeholder: 'builder.field.sni.placeholder' },
  clientName: { label: 'builder.field.clientName', hint: 'builder.field.clientName.hint' },
  displayName: { label: 'builder.field.displayName', hint: 'builder.field.displayName.hint', placeholder: 'builder.field.displayName.placeholder' },
  icon: { label: 'builder.field.icon', hint: 'builder.field.icon.hint' },
  color: { label: 'builder.field.color', hint: 'builder.field.color.hint' },
  relayName: { label: 'builder.field.relayName', hint: 'builder.field.relayName.hint' },
  port: { label: 'builder.field.port', hint: 'builder.field.port.hint' },
  harden: { label: 'builder.field.harden', hint: 'builder.field.harden.hint' },
  ai: { label: 'builder.field.ai', hint: 'builder.field.ai.hint' },
  yes: { label: 'builder.field.yes', hint: 'builder.field.yes.hint' },
};
const PALETTE_TEXT: Record<string, LandingKey> = {
  ocean: 'builder.palette.ocean',
  sunset: 'builder.palette.sunset',
  forest: 'builder.palette.forest',
  lavender: 'builder.palette.lavender',
  rose: 'builder.palette.rose',
  slate: 'builder.palette.slate',
};
const STATUS_KEYS = [
  'invalid', 'local', 'domainMissing', 'deploy', 'deployDomain', 'relayNeed', 'relayOk', 'checkNeed', 'checkOk',
  'scanNeed', 'scanOk', 'doctorNeed', 'doctorOk', 'doctorAi', 'teardownNeed', 'teardownOk',
] as const;

const first = config.tabs[0];
const fieldIds = Object.keys(config.fields) as FieldId[];
const textFields = fieldIds.filter((id) => config.fields[id].kind !== 'check');
const checkFields = fieldIds.filter((id) => config.fields[id].kind === 'check');
const clientConfig = {
  tabs: config.tabs,
  fields: config.fields,
  strings: {
    ...Object.fromEntries(STATUS_KEYS.map((k) => [k, t(`builder.status.${k}` as LandingKey)])),
    copy: t('builder.copy'),
    copied: t('builder.copied'),
    server: t('builder.field.server'),
    serverHint: t('builder.field.server.hint'),
    relayServer: t('builder.field.relayServer'),
    relayServerHint: t('builder.field.relayServer.hint'),
    desc: Object.fromEntries(config.tabs.map((tab) => [tab.id, t(TAB_TEXT[tab.id].desc)])),
  },
};
const fieldText = (id: FieldId) => FIELD_TEXT[id];
const shown = (id: FieldId) => first.fields.includes(id);
---

<div class="builder card" id="builder">
  <div class="builder__tabs" role="tablist" aria-label={t('builder.title')}>
    {config.tabs.map((tab, i) => (
      <button
        type="button"
        class="builder__tab"
        role="tab"
        id={`builder-tab-${tab.id}`}
        aria-controls="builder-panel"
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={tab.id}
      >
        {t(TAB_TEXT[tab.id].label)}
      </button>
    ))}
  </div>

  <div class="builder__body" role="tabpanel" id="builder-panel" aria-labelledby={`builder-tab-${first.id}`}>
    <p class="builder__desc" id="builder-desc">{t(TAB_TEXT[first.id].desc)}</p>

    <div class="builder__fields">
      <div class="builder__field builder__field--wide">
        <label class="builder__label" for="builder-server" id="builder-server-label">{t('builder.field.server')}</label>
        <input id="builder-server" class="builder__input" type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder={t('builder.field.server.placeholder')} aria-describedby="builder-server-hint" />
        <span class="builder__hint" id="builder-server-hint">{t('builder.field.server.hint')}</span>
      </div>

      {textFields.map((id) => {
        const field = config.fields[id] as { kind: string; placeholder?: string; short?: boolean; palettes?: string[] };
        const text = fieldText(id);
        const placeholder = text.placeholder ? t(text.placeholder) : (field.placeholder ?? '');
        return (
          <div class:list={['builder__field', { 'builder__field--short': field.short }]} data-field-row={id} hidden={!shown(id)}>
            <label class="builder__label" for={`builder-${id}`}>{t(text.label)}</label>
            {field.kind === 'palette' ? (
              <select id={`builder-${id}`} class="builder__input" data-field={id} aria-describedby={`builder-${id}-hint`}>
                <option value="">{t('builder.field.color.default')}</option>
                {(field.palettes ?? []).filter((p) => p !== 'ocean').map((p) => <option value={p}>{t(PALETTE_TEXT[p])}</option>)}
              </select>
            ) : (
              <input id={`builder-${id}`} class="builder__input" type="text" autocomplete="off" spellcheck="false" data-field={id} placeholder={placeholder} aria-describedby={`builder-${id}-hint`} />
            )}
            <span class="builder__hint" id={`builder-${id}-hint`}>{t(text.hint)}</span>
          </div>
        );
      })}

      <div class="builder__checks">
        {checkFields.map((id) => (
          <label class="builder__check" data-field-row={id} hidden={!shown(id)}>
            <input type="checkbox" data-field={id} />
            <span>
              <span class="builder__check-label">{t(fieldText(id).label)}</span>
              <span class="builder__hint">{t(fieldText(id).hint)}</span>
            </span>
          </label>
        ))}
      </div>
    </div>

    <div class="builder__output">
      <span class="sr-only" id="builder-cmd-label">{t('builder.command')}</span>
      <pre aria-labelledby="builder-cmd-label" aria-live="polite"><code id="builder-cmd">meridian {first.command}</code></pre>
      <button type="button" class="copy-btn builder__copy" id="builder-copy">
        <span class="copy-btn__label">{t('builder.copy')}</span>
      </button>
    </div>
    <p class="builder__status" id="builder-status" aria-live="polite"></p>
    <p class="builder__wizard" id="builder-wizard" set:html={t('builder.wizard')} />
  </div>
</div>

<script type="application/json" id="builder-config" set:html={JSON.stringify(clientConfig)} />

<script>
  import { copyText, flashCopied } from './copy';

  interface Field { flag: string; kind: string; default?: string; target?: string; required?: boolean }
  interface Tab { id: string; command: string; server: string; fields: string[] }
  interface Config { tabs: Tab[]; fields: Record<string, Field>; strings: Record<string, string> & { desc: Record<string, string> } }

  const STORAGE_KEY = 'meridian-builder-v2';
  const config: Config = JSON.parse(document.getElementById('builder-config')!.textContent!);
  const root = document.getElementById('builder')!;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const server = $<HTMLInputElement>('builder-server');
  const inputs = new Map<string, HTMLInputElement | HTMLSelectElement>();
  root.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-field]').forEach((el) => inputs.set(el.dataset.field!, el));
  const S = config.strings;
  let tab = config.tabs[0];
  let restored = false; // write storage only after the reader changes something

  const quote = (v: string) => (/^[\w.:/@%+=,-]+$/.test(v) ? v : `'${v.replace(/'/g, `'\\''`)}'`);
  const value = (id: string) => {
    const el = inputs.get(id);
    if (!el) return '';
    return el instanceof HTMLInputElement && el.type === 'checkbox' ? (el.checked ? 'on' : '') : el.value.trim();
  };

  function setStatus(text: string, tone: '' | 'ok' | 'error' = '') {
    const el = $('builder-status');
    el.textContent = text;
    el.dataset.tone = tone;
  }

  function build() {
    const target = server.value.trim();
    const local = /^local$/i.test(target);
    const invalid = target !== '' && !/^[\w.:[\]@-]+$/.test(target);

    $('builder-server-label').textContent = tab.server === 'required' ? S.relayServer : S.server;
    $('builder-server-hint').textContent = tab.server === 'required' ? S.relayServerHint : S.serverHint;
    $('builder-desc').textContent = S.desc[tab.id];
    root.querySelectorAll<HTMLElement>('[data-field-row]').forEach((row) => {
      const id = row.dataset.fieldRow!;
      row.hidden = !tab.fields.includes(id) || (local && Boolean(config.fields[id].target));
    });

    const args: string[] = [];
    let host = invalid ? '' : target;
    for (const id of tab.fields) {
      const field = config.fields[id];
      const v = value(id);
      if (!v || v === field.default) continue;
      if (field.target) {
        if (local) continue;
        if (host && field.target === 'user' && !host.includes('@')) host = `${v}@${host}`;
        else if (host && field.target === 'port' && !/:\d+$/.test(host)) host = `${host}:${v}`;
        else if (!host) args.push(`${field.flag} ${quote(v)}`);
        continue;
      }
      args.push(field.kind === 'check' ? field.flag : `${field.flag} ${quote(v)}`);
    }
    if (host) args.unshift(quote(host));
    $('builder-cmd').textContent = ['meridian', tab.command, ...args].join(' ');
    $('builder-wizard').hidden = !(tab.id === 'deploy' && !target);

    const has = target !== '' && !invalid;
    if (invalid) setStatus(S.invalid, 'error');
    else if (tab.id === 'deploy') {
      if (!has) setStatus('');
      else if (local) setStatus(S.local, 'ok');
      else setStatus(value('domain') ? S.deployDomain : S.deploy, 'ok');
    } else if (tab.id === 'relay') setStatus(has && value('exit') ? S.relayOk : S.relayNeed, has && value('exit') ? 'ok' : '');
    else if (tab.id === 'doctor') setStatus(has ? (value('ai') ? S.doctorAi : S.doctorOk) : S.doctorNeed, has ? 'ok' : '');
    else setStatus(S[`${tab.id}${has ? 'Ok' : 'Need'}`], has ? 'ok' : '');
    save();
  }

  function selectTab(id: string, focus = false) {
    tab = config.tabs.find((t) => t.id === id) ?? config.tabs[0];
    root.querySelectorAll<HTMLButtonElement>('[role="tab"]').forEach((b) => {
      const active = b.dataset.tab === tab.id;
      b.setAttribute('aria-selected', String(active));
      b.tabIndex = active ? 0 : -1;
      if (active && focus) b.focus();
    });
    $('builder-panel').setAttribute('aria-labelledby', `builder-tab-${tab.id}`);
    build();
  }

  function save() {
    if (!restored) return;
    try {
      const values: Record<string, string> = { server: server.value };
      inputs.forEach((_, id) => (values[id] = value(id)));
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ tab: tab.id, values }));
    } catch {
      // Storage unavailable: the builder still works for this visit.
    }
  }

  function restore() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      const values: Record<string, string> = saved.values ?? {};
      server.value = values.server ?? '';
      inputs.forEach((el, id) => {
        if (el instanceof HTMLInputElement && el.type === 'checkbox') el.checked = values[id] === 'on';
        else el.value = values[id] ?? '';
      });
      return typeof saved.tab === 'string' ? saved.tab : config.tabs[0].id;
    } catch {
      return config.tabs[0].id;
    }
  }

  const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  tabs.forEach((b, i) => {
    b.addEventListener('click', () => selectTab(b.dataset.tab!));
    b.addEventListener('keydown', (e) => {
      const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
      if (!step) return;
      const rtl = getComputedStyle(root).direction === 'rtl' ? -1 : 1;
      selectTab(tabs[(i + step * rtl + tabs.length) % tabs.length].dataset.tab!, true);
    });
  });
  root.addEventListener('input', build);
  root.addEventListener('change', build);

  $('builder-copy').addEventListener('click', async () => {
    const button = $('builder-copy');
    if (await copyText($('builder-cmd').textContent ?? '')) flashCopied(button, button.querySelector('span'), S.copied);
  });

  selectTab(restore());
  restored = true;
</script>

<style>
  .builder {
    overflow: hidden;
  }

  .builder__tabs {
    display: flex;
    gap: 4px;
    padding: 6px;
    background: var(--s2);
    border-bottom: 1px solid var(--b1);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .builder__tab {
    flex: 1 0 auto;
    padding: 8px 14px;
    background: none;
    border: 1px solid transparent;
    border-radius: var(--r);
    color: var(--t2);
    font-family: var(--body);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
  }
  .builder__tab:hover {
    color: var(--t1);
  }
  .builder__tab[aria-selected='true'] {
    background: var(--s1);
    border-color: var(--b1);
    color: var(--t1);
    box-shadow: var(--shadow-sm);
  }

  .builder__body {
    padding: 24px;
  }
  .builder__desc {
    color: var(--t2);
    font-size: 0.97rem;
    margin-bottom: 20px;
    max-width: 640px;
  }

  .builder__fields {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 18px 20px;
  }
  .builder__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .builder__field--wide,
  .builder__checks {
    grid-column: 1 / -1;
  }
  .builder__field[hidden],
  .builder__check[hidden] {
    display: none;
  }
  .builder__label,
  .builder__check-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--t1);
  }
  .builder__input {
    width: 100%;
    min-height: 42px;
    padding: 9px 12px;
    background: var(--bg);
    border: 1px solid var(--b2);
    border-radius: var(--r);
    color: var(--t1);
    font-family: var(--mono);
    font-size: 0.88rem;
  }
  .builder__input::placeholder {
    color: var(--t3);
    opacity: 1;
  }
  .builder__input:focus {
    outline: 2px solid var(--ac);
    outline-offset: 0;
    border-color: transparent;
  }
  .builder__field--wide .builder__input {
    max-width: 420px;
  }
  .builder__hint {
    display: block;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--t3);
  }

  .builder__checks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
  }
  .builder__check {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    max-width: 320px;
    cursor: pointer;
  }
  .builder__check input {
    margin-top: 4px;
    width: 16px;
    height: 16px;
    accent-color: var(--ac);
    flex-shrink: 0;
  }

  .builder__output {
    direction: ltr;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    padding: 14px 12px 14px 18px;
    background: var(--code-bg);
    border: 1px solid var(--code-br);
    border-radius: var(--r);
  }
  .builder__output pre {
    flex: 1;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.9rem;
    color: var(--t1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .builder__output pre::before {
    content: '$ ';
    color: var(--t3);
  }
  .builder__copy {
    flex-shrink: 0;
  }

  .builder__status {
    min-height: 1.5em;
    margin-top: 10px;
    font-size: 0.9rem;
    color: var(--t2);
  }
  .builder__status[data-tone='ok'] {
    color: var(--ok);
  }
  .builder__status[data-tone='error'] {
    color: var(--err);
  }
  .builder__wizard {
    margin-top: 8px;
    padding: 12px 16px;
    font-size: 0.92rem;
    color: var(--t2);
    background: var(--ac3);
    border-inline-start: 3px solid var(--ac);
    border-radius: var(--r);
  }
  .builder__wizard[hidden] {
    display: none;
  }
  .builder__wizard :global(strong) {
    color: var(--t1);
  }

  @media (max-width: 560px) {
    .builder__body {
      padding: 18px;
    }
  }
</style>
