---
import CopyButton from './CopyButton.astro';

interface Props {
  code: string;
  label?: string;
  copyLabel?: string;
  copiedLabel?: string;
}

const { code, label, copyLabel, copiedLabel } = Astro.props;
---

<figure class="code-block">
  {label && <figcaption class="code-block__label">{label}</figcaption>}
  <div class="code-block__inner">
    <pre><code>{code}</code></pre>
    <CopyButton text={code} label={copyLabel} copiedLabel={copiedLabel} class="code-block__copy" />
  </div>
</figure>

<style>
  .code-block {
    margin: 16px 0;
    background: var(--code-bg);
    border: 1px solid var(--code-br);
    border-radius: var(--r);
    overflow: hidden;
  }
  .code-block__label {
    font-family: var(--label-font);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--t3);
    padding: 8px 16px;
    border-bottom: 1px solid var(--code-br);
  }
  :global(:is(:lang(fa), :lang(zh))) .code-block__label {
    font-size: 0.8rem;
    letter-spacing: normal;
    text-transform: none;
  }
  .code-block__inner {
    direction: ltr;
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 12px 14px 16px;
  }
  pre {
    flex: 1;
    min-width: 0;
    font-family: var(--mono);
    font-size: 0.86rem;
    line-height: 1.65;
    color: var(--t1);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  pre::before {
    content: '$ ';
    color: var(--t3);
    user-select: none;
  }
  .code-block__copy {
    flex-shrink: 0;
  }
</style>
