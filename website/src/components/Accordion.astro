---
interface Props {
  title: string;
  open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="accordion card" open={open || undefined}>
  <summary class="accordion__trigger">
    <span>{title}</span>
    <svg class="accordion__chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </summary>
  <div class="accordion__content">
    <slot />
  </div>
</details>

<style>
  .accordion {
    border-radius: var(--r);
    overflow: hidden;
  }
  .accordion + .accordion {
    margin-top: 10px;
  }
  .accordion__trigger {
    padding: 16px 20px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    color: var(--t1);
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    user-select: none;
  }
  .accordion__trigger::-webkit-details-marker {
    display: none;
  }
  .accordion__trigger:hover {
    background: var(--s2);
  }
  .accordion__chevron {
    color: var(--t3);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }
  .accordion[open] .accordion__chevron {
    transform: rotate(180deg);
  }
  .accordion__content {
    padding: 0 20px 20px;
    font-size: 0.97rem;
    color: var(--t2);
    line-height: 1.75;
  }
  .accordion__content :global(p + p) {
    margin-top: 12px;
  }
  .accordion__content :global(strong) {
    color: var(--t1);
    font-weight: 600;
  }
</style>
