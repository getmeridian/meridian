---
/**
 * Page title plus actions for readers who work with AI: copy the page as Markdown,
 * open the Markdown, or hand the page to an assistant. Everything is served from
 * this site; the assistant links are plain links that send nothing until clicked.
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { starlightRoute, t } = Astro.locals;
const markdownPath = `/${starlightRoute.id}.md`;
const markdownUrl = new URL(markdownPath, Astro.site).href;
const prompt = t('meridian.page.prompt', { url: markdownUrl });
const assistants = [
  { label: 'ChatGPT', href: `https://chatgpt.com/?q=${encodeURIComponent(prompt)}` },
  { label: 'Claude', href: `https://claude.ai/new?q=${encodeURIComponent(prompt)}` },
];
---

<Default />
<div class="page-actions not-content">
  <button type="button" class="page-action" data-copy-markdown={markdownPath} data-copied={t('meridian.page.copied')}>
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
      ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg
    >
    <span>{t('meridian.page.copy')}</span>
  </button>
  <a class="page-action" href={markdownPath}>{t('meridian.page.view')}</a>
  {
    assistants.map(({ label, href }) => (
      <a class="page-action" href={href} target="_blank" rel="noopener noreferrer">
        {t('meridian.page.open', { assistant: label })}
      </a>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('span');
      if (!label) return;
      const original = label.textContent;
      try {
        const response = await fetch(button.dataset.copyMarkdown!);
        await navigator.clipboard.writeText(await response.text());
        label.textContent = button.dataset.copied ?? original;
      } catch {
        window.location.href = button.dataset.copyMarkdown!;
        return;
      }
      setTimeout(() => (label.textContent = original), 2000);
    });
  });
</script>

<style>
  .page-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }
  .page-action {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    text-decoration: none;
    cursor: pointer;
  }
  .page-action:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
</style>
