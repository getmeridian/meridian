---
// Markup only: behaviour lives in src/studio/app.js, wording in the presenters,
// labels/help/defaults in the generated workflow contracts.
import StudioLayout from '../studio/StudioLayout.astro';
import StudioHelp from '../studio/components/StudioHelp.astro';
import { contractFieldText, workflowOptions } from '../studio/contractDefaults.js';
import { deployWorkflow, serverOnboardingWorkflow } from '../studio/generated/index.js';
import { studioFaqs, studioHelp, studioJourneySteps } from '../studio/helpCatalog.js';

type FieldText = { label: string; help: string; placeholder: string };
const serverField = (id: string): FieldText => contractFieldText(serverOnboardingWorkflow, id, studioHelp);
const deployField = (id: string): FieldText => contractFieldText(deployWorkflow, id, studioHelp);

const firstContext = studioJourneySteps[0];
const colorOptions: Array<{ label: string; value: string }> = workflowOptions(deployWorkflow, 'color');
const title = serverField('title');
const host = serverField('host');
const sshUser = serverField('ssh_user');
const sshPort = serverField('ssh_port');
const serverName = deployField('server_name');
const clientName = deployField('client_name');
const harden = deployField('harden');
const geoBlock = deployField('geo_block');
const sni = deployField('sni');
const domain = deployField('domain');
const color = deployField('color');
const icon = deployField('icon');
const warp = deployField('warp');
---

<StudioLayout title="Meridian Studio" description="Guided Meridian server setup and deploy assistant.">
  <main id="main" class="studio">
    <header class="studio__topbar" aria-labelledby="studio-title">
      <div class="studio__brand">
        <p class="studio__eyebrow">Meridian Studio</p>
        <h1 id="studio-title">Set up your VPN server</h1>
      </div>
      <div class="studio__top-status" aria-label="Studio status">
        <div class="studio__mode" id="studio-mode" data-state="unknown" aria-live="polite">
          <span class="studio__dot" aria-hidden="true"></span>
          <span id="studio-mode-label">Checking for Studio</span>
        </div>
        <span class="studio__draft" id="studio-draft-status">Draft saved locally</span>
        <button class="studio__ghost studio__ghost--small" type="button" id="open-command-sheet">Commands</button>
        <button class="studio__ghost studio__ghost--small" type="button" id="studio-reset">Reset</button>
      </div>
      <div class="studio__trust-strip" aria-label="Safety facts">
        <span>Local actions run on this computer</span>
        <span>SSH password is never saved</span>
        <span>Deploy changes wait for review</span>
      </div>
    </header>

    <section class="studio__cockpit" aria-label="Guided Studio cockpit">
      <aside class="studio__journey" aria-label="Setup journey">
        <ol class="studio__steps" id="studio-steps">
          {studioJourneySteps.map((step, index) => (
            <li>
              <button type="button" data-step-target={step.id}>
                <span class="studio__step-index">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{step.label}</strong>
                  <small class="studio__step-status" data-step-status>Ready</small>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </aside>

      <section class="studio__task">
        <div class="studio__task-meta">
          <span id="studio-current-step">{firstContext.label}: {firstContext.short}</span>
          <span>Guided setup</span>
        </div>

        <div class="studio__task-status" id="studio-task-status" role="status" aria-live="polite">
          <span>Status</span>
          <strong id="status-title">Ready</strong>
          <small id="status-detail">Studio is checking whether meridian studio is running on this computer.</small>
        </div>

        <details class="studio__step-help">
          <summary>
            <span>Need help with this step?</span>
            <strong id="studio-context-title">{firstContext.contextTitle}</strong>
          </summary>
          <p id="studio-context-body">{firstContext.contextBody}</p>
          <ul class="studio__context-list" id="studio-context-list">
            {firstContext.contextItems.map((item) => <li>{item}</li>)}
          </ul>
        </details>

        <article class="studio__screen" data-step-panel="welcome">
          <div class="studio__screen-head">
            <p class="studio__kicker">Start here</p>
            <h2>Copy the VPS details from your provider</h2>
            <p>
              Keep the provider page open. Studio only needs the server IP, SSH username, SSH port, and the first-login
              password if the server does not already have your SSH key.
            </p>
          </div>

          <div class="studio__mode-gate" id="studio-mode-gate" data-mode="static">
            <div>
              <strong id="mode-gate-title">Checking for Studio</strong>
              <p id="mode-gate-body">Studio is checking whether meridian studio is running on this computer.</p>
            </div>
            <button class="studio__secondary" type="button" id="mode-gate-command">Copy meridian studio</button>
          </div>

          <div class="studio__saved-start" id="saved-server-start" hidden>
            <div>
              <strong>Use a saved server</strong>
              <p>Skip typing when this computer already knows a VPS.</p>
            </div>
            <div id="saved-server-start-list"></div>
          </div>

          <div class="studio__provider-grid" aria-label="Provider details to copy">
            <div class="studio__detail-tile">
              <span>Public IP</span>
              <strong>198.51.100.10</strong>
              <small>The internet-facing server address.</small>
            </div>
            <div class="studio__detail-tile">
              <span>SSH user</span>
              <strong>root or ubuntu</strong>
              <small>The Linux login name from the provider.</small>
            </div>
            <div class="studio__detail-tile">
              <span>SSH port</span>
              <strong>22</strong>
              <small>Use the provider value if it is different.</small>
            </div>
            <div class="studio__detail-tile">
              <span>First password</span>
              <strong>Used once</strong>
              <small>Only needed to install a key in Local Studio.</small>
            </div>
          </div>

          <div class="studio__faq">
            <h3>Quick answers</h3>
            {studioFaqs.welcome.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__primary" type="button" data-next-step="server">I have these details</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="server" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Connection details</p>
            <h2>Paste the SSH command from your VPS provider</h2>
            <p>Studio fills the technical fields from the command. Give the server a friendly title so you can recognize it later.</p>
          </div>

          <div class="studio__recommended-path">
            <label class="studio__field studio__field--wide" for="server-ssh-command">
              <span>Paste SSH command <StudioHelp helpKey="sshCommandPaste" text={studioHelp.sshCommandPaste} /></span>
              <input id="server-ssh-command" type="text" autocomplete="off" placeholder="ssh ubuntu@198.51.100.10 -p 2222" />
              <small class="studio__field-help">Look for a command like this in your provider dashboard or welcome email.</small>
            </label>
            <div class="studio__parse-chips" id="ssh-command-preview" hidden></div>
            <label class="studio__field studio__field--wide" for="server-title">
              <span>{title.label} <StudioHelp helpKey="title" text={title.help} /></span>
              <input id="server-title" type="text" autocomplete="off" placeholder="Family VPN" data-field="server.title" />
              <small class="studio__field-help">Leave it empty to name the server after its IP address.</small>
            </label>
          </div>

          <details class="studio__manual-entry">
            <summary>I do not have an SSH command</summary>
            <p>Enter the same details manually. They are usually shown as IP address, username, and port.</p>
            <div class="studio__field-grid">
              <label class="studio__field" for="server-host">
                <span>{host.label} <StudioHelp helpKey="host" text={host.help} /></span>
                <input id="server-host" type="text" autocomplete="off" placeholder="198.51.100.10" data-field="server.host" />
              </label>
              <label class="studio__field" for="server-user">
                <span>{sshUser.label} <StudioHelp helpKey="ssh_user" text={sshUser.help} /></span>
                <input id="server-user" type="text" autocomplete="username" placeholder={sshUser.placeholder} data-field="server.ssh_user" />
              </label>
              <label class="studio__field" for="server-port">
                <span>{sshPort.label} <StudioHelp helpKey="ssh_port" text={sshPort.help} /></span>
                <input id="server-port" type="text" inputmode="numeric" autocomplete="off" placeholder={sshPort.placeholder} data-field="server.ssh_port" />
              </label>
            </div>
          </details>

          <div class="studio__errors" id="server-errors" role="alert" aria-live="assertive" hidden></div>
          <div class="studio__action-status" id="server-action-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="welcome">Back</button>
            <button class="studio__ghost" type="button" id="save-server" data-local-action hidden>Save only</button>
            <button class="studio__primary" type="button" id="save-and-validate">Check server access</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="connect" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">SSH check</p>
            <h2>Confirm Meridian can reach the server</h2>
            <p>This validation does not deploy anything. It checks reachability, authentication, and whether sudo works.</p>
          </div>

          <div class="studio__notice" id="saved-server-notice" role="status" aria-live="polite" hidden></div>
          <div class="studio__facts" id="validation-facts" role="status" aria-live="polite" hidden></div>

          <div class="studio__split-action" data-local-action hidden>
            <div>
              <strong>Local Studio</strong>
              <p>Runs the validation here and returns friendly next steps if something is wrong.</p>
            </div>
            <button class="studio__secondary" type="button" id="validate-server">Validate SSH</button>
          </div>
          <div class="studio__split-action" data-static-action>
            <div>
              <strong>Check it from Terminal</strong>
              <p>Copies the SSH command so you can test the same connection yourself.</p>
            </div>
            <button class="studio__ghost" type="button" id="copy-ssh-command">Copy SSH command</button>
          </div>

          <div class="studio__faq">
            <h3>Troubleshooting</h3>
            {studioFaqs.connect.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="server">Back</button>
            <button class="studio__secondary" type="button" id="confirm-manual-ssh" data-static-action>I checked SSH manually</button>
            <button class="studio__primary" type="button" data-next-step="keys">Prepare key-based SSH</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="keys" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Secure access</p>
            <h2>Use the password once, then use a key</h2>
            <p>A private key stays on this computer. Its public key is installed on the server and verified immediately.</p>
          </div>

          <div class="studio__key-diagram" aria-label="SSH key explanation">
            <div>
              <span>Private key</span>
              <strong>This computer</strong>
              <small>Secret. Never pasted or uploaded.</small>
            </div>
            <div class="studio__key-arrow" aria-hidden="true">to</div>
            <div>
              <span>Public key</span>
              <strong>Your VPS</strong>
              <small>Safe to install on the server.</small>
            </div>
          </div>

          <div class="studio__field-grid" data-local-action hidden>
            <label class="studio__field" for="server-password">
              <span>One-time SSH password <StudioHelp helpKey="sshPassword" text={studioHelp.sshPassword} /></span>
              <input id="server-password" type="password" autocomplete="off" data-lpignore="true" />
            </label>
            <label class="studio__choice-card" for="disable-password-auth">
              <input id="disable-password-auth" type="checkbox" />
              <span>
                <strong>Ask deploy to disable password SSH later <StudioHelp helpKey="disablePasswordAuth" text={studioHelp.disablePasswordAuth} /></strong>
                <small>{studioHelp.disablePasswordAuth}</small>
              </span>
            </label>
          </div>

          <div class="studio__action-status" id="key-action-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__split-action" data-local-action hidden>
            <div>
              <strong>Recommended</strong>
              <p>Generate a Meridian key, install its public half, then verify key login.</p>
            </div>
            <button class="studio__secondary" type="button" id="bootstrap-key">Install and verify key</button>
          </div>
          <div class="studio__split-action" data-static-action>
            <div>
              <strong>Set up the key from Terminal</strong>
              <p>Copy the standard command and run it once; it asks for the password there, not here.</p>
            </div>
            <button class="studio__ghost" type="button" id="copy-key-command">Copy key command</button>
          </div>

          <div class="studio__faq">
            <h3>Key basics</h3>
            {studioFaqs.keys.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="connect">Back</button>
            <button class="studio__secondary" type="button" id="confirm-manual-key" data-static-action>I completed key setup</button>
            <button class="studio__primary" type="button" data-next-step="deploy">Choose deploy options</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="deploy" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Safe defaults</p>
            <h2>Choose what the first setup should create</h2>
            <p>Start with the recommended options. An empty field uses the default shown in grey.</p>
          </div>

          <label class="studio__field studio__field--wide" id="saved-server-field" for="saved-server" hidden>
            <span>Use saved server <StudioHelp helpKey="savedServer" text={studioHelp.savedServer} /></span>
            <select id="saved-server"></select>
          </label>

          <div class="studio__field-grid">
            <label class="studio__field" for="deploy-server-name">
              <span>{serverName.label} <StudioHelp helpKey="server_name" text={serverName.help} /></span>
              <input id="deploy-server-name" type="text" placeholder={serverName.placeholder} data-field="deploy.server_name" />
            </label>
            <label class="studio__field" for="deploy-client-name">
              <span>{clientName.label} <StudioHelp helpKey="client_name" text={clientName.help} /></span>
              <input id="deploy-client-name" type="text" placeholder={clientName.placeholder} data-field="deploy.client_name" />
            </label>
          </div>

          <div class="studio__choice-grid">
            <label class="studio__choice-card" for="deploy-harden">
              <input id="deploy-harden" type="checkbox" data-field="deploy.harden" />
              <span>
                <strong>{harden.label}</strong>
                <small>{harden.help}</small>
              </span>
            </label>
            <label class="studio__choice-card" for="deploy-geo-block">
              <input id="deploy-geo-block" type="checkbox" data-field="deploy.geo_block" />
              <span>
                <strong>{geoBlock.label}</strong>
                <small>{geoBlock.help}</small>
              </span>
            </label>
          </div>

          <details class="studio__advanced" id="deploy-advanced">
            <summary>Advanced deploy settings</summary>
            <div class="studio__field-grid">
              <label class="studio__field" for="deploy-sni">
                <span>{sni.label} <StudioHelp helpKey="sni" text={sni.help} /></span>
                <input id="deploy-sni" type="text" placeholder={sni.placeholder} data-field="deploy.sni" />
              </label>
              <label class="studio__field" for="deploy-domain">
                <span>{domain.label} <StudioHelp helpKey="domain" text={domain.help} /></span>
                <input id="deploy-domain" type="text" placeholder="vpn.example.com" data-field="deploy.domain" />
              </label>
              <label class="studio__field" for="deploy-color">
                <span>{color.label} <StudioHelp helpKey="color" text={color.help} /></span>
                <select id="deploy-color" data-field="deploy.color">
                  {colorOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label class="studio__field" for="deploy-icon">
                <span>{icon.label} <StudioHelp helpKey="icon" text={icon.help} /></span>
                <input id="deploy-icon" type="text" data-field="deploy.icon" />
              </label>
              <label class="studio__choice-card" for="deploy-warp">
                <input id="deploy-warp" type="checkbox" data-field="deploy.warp" />
                <span>
                  <strong>{warp.label}</strong>
                  <small>{warp.help}</small>
                </span>
              </label>
            </div>
          </details>

          <div class="studio__errors" id="deploy-errors" role="alert" aria-live="assertive" hidden></div>
          <div class="studio__action-status" id="deploy-preview-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__split-action" data-static-action>
            <div>
              <strong>Run it from Terminal</strong>
              <p>The preview command changes nothing. The deploy command asks you to confirm before it changes the server.</p>
            </div>
            <div class="studio__action-center-buttons">
              <button class="studio__ghost" type="button" id="copy-static-dry-run">Copy preview command</button>
              <button class="studio__secondary" type="button" id="copy-static-deploy">Copy deploy command</button>
            </div>
          </div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="keys">Back</button>
            <button class="studio__primary" type="button" id="run-dry-run" data-local-action hidden>Preview changes</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="review" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Confirmation boundary</p>
            <h2>Review what Meridian will change</h2>
            <p>Key setup may have installed a public SSH key already. VPN services, firewall changes, and SSH hardening wait for this deploy review.</p>
          </div>

          <div class="studio__review" id="review-summary"></div>
          <div class="studio__action-status" id="plan-gate-status" role="status" aria-live="polite" hidden></div>

          <label class="studio__confirm" for="confirm-deploy" data-local-action hidden>
            <input id="confirm-deploy" type="checkbox" />
            <span>I reviewed this and want Meridian to change the server.</span>
          </label>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="deploy">Back</button>
            <button class="studio__ghost" type="button" id="download-request">Download deploy.json</button>
            <button class="studio__secondary" type="button" id="copy-deploy-command">Copy deploy command</button>
            <button class="studio__primary" type="button" id="start-deploy" data-local-action hidden disabled>Start deploy</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="complete" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Evidence</p>
            <h2>Progress and result</h2>
            <p id="completion-copy">Start a deploy to see its progress here.</p>
          </div>
          <div class="studio__progress-card" id="operation-progress-card" role="status" aria-live="polite" hidden></div>
          <div class="studio__result" id="studio-result" data-status="idle" role="status" aria-live="polite"></div>
          <div class="studio__action-center" id="deploy-action-center" hidden>
            <div>
              <strong>Next steps</strong>
              <p id="deploy-action-copy">Finish with a connection test before adding relays or more complex routes.</p>
            </div>
            <div class="studio__action-center-buttons">
              <button class="studio__primary" type="button" id="copy-invite-link">Copy invite link</button>
              <button class="studio__secondary" type="button" id="copy-test-command">Copy test command</button>
              <button class="studio__secondary" type="button" id="copy-add-device-command">Copy add-device command</button>
            </div>
            <ul class="studio__post-deploy-list" id="deploy-action-list"></ul>
          </div>
          <div class="studio__recovery-card" id="deploy-recovery-card" hidden>
            <div>
              <strong id="recovery-title">Recovery</strong>
              <p id="recovery-copy">Studio shows the safest next step here if deploy fails.</p>
            </div>
            <div class="studio__action-center-buttons" data-local-action hidden>
              <button class="studio__primary" type="button" id="retry-deploy">Try deploy again</button>
              <button class="studio__secondary" type="button" id="copy-diagnostics">Copy diagnostic report</button>
            </div>
          </div>
          <ol class="studio__timeline" id="studio-timeline"></ol>
          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="review">Back</button>
            <button class="studio__secondary" type="button" id="cancel-operation" hidden>Cancel deploy</button>
          </div>
        </article>
      </section>
    </section>

    <dialog class="studio__sheet" id="command-sheet" aria-labelledby="command-sheet-title">
      <div class="studio__sheet-head">
        <div>
          <p class="studio__kicker">Advanced drawer</p>
          <h2 id="command-sheet-title">Command sheet</h2>
        </div>
        <button class="studio__ghost studio__ghost--small" type="button" id="close-command-sheet">Close</button>
      </div>

      <div class="studio__sheet-grid">
        <section>
          <div class="studio__panel-head">
            <h3>Commands</h3>
            <button class="studio__ghost studio__ghost--small" type="button" id="download-server">Download server.json</button>
            <button class="studio__ghost studio__ghost--small" type="button" id="download-request-sheet">Download deploy.json</button>
          </div>
          <div class="studio__command-list">
            <button class="studio__command" type="button" id="copy-save-command"><span id="save-command"></span></button>
            <button class="studio__command" type="button" id="copy-dry-run-command"><span id="dry-run-command"></span></button>
            <button class="studio__command" type="button" id="copy-sheet-deploy-command"><span id="deploy-command"></span></button>
            <button class="studio__command" type="button" id="copy-request-dry-run-command"><span id="request-dry-run-command"></span></button>
          </div>
          <p class="studio__copy-status" id="copy-status" aria-live="polite"></p>
        </section>

        <section>
          <div class="studio__panel-head">
            <h3>server.json</h3>
          </div>
          <pre class="studio__code" id="server-json"></pre>
        </section>

        <section>
          <div class="studio__panel-head">
            <h3>deploy.json</h3>
          </div>
          <pre class="studio__code" id="request-json"></pre>
        </section>

        <section>
          <label class="studio__field" for="studio-paste">
            <span>Pasted machine output <StudioHelp helpKey="pastedOutput" text={studioHelp.pastedOutput} /></span>
            <textarea id="studio-paste" spellcheck="false"></textarea>
          </label>
          <div class="studio__sheet-actions">
            <button class="studio__secondary" type="button" id="parse-output">Parse output</button>
          </div>
          <p class="studio__copy-status" id="parse-status" aria-live="polite"></p>
        </section>
      </div>
    </dialog>
  </main>
</StudioLayout>

<script>
  // @ts-check
  import { startStudio } from '../studio/app.js';

  startStudio(document);
</script>
