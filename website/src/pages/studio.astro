---
import Base from '../layouts/Base.astro';
import { studioFaqs, studioHelp, studioJourneySteps } from '../studio/helpCatalog.js';
import StudioHelp from '../studio/components/StudioHelp.astro';
import { workflowOptions } from '../studio/contractDefaults.js';
import { deployWorkflow } from '../studio/generated/index.js';

const firstContext = studioJourneySteps[0];
const colorOptions = workflowOptions(deployWorkflow, 'color');
---

<Base
  title="Meridian Studio"
  description="Guided Meridian server setup and deploy assistant."
>
  <main id="main" class="studio">
    <header class="studio__topbar" aria-labelledby="studio-title">
      <div class="studio__brand">
        <p class="studio__eyebrow">Meridian Studio</p>
        <h1 id="studio-title">Set up your VPN server</h1>
      </div>
      <div class="studio__top-status" aria-label="Studio status">
        <div class="studio__mode" id="studio-mode" data-state="static" aria-live="polite">
          <span class="studio__dot" aria-hidden="true"></span>
          <span id="studio-mode-label">Static Studio</span>
        </div>
        <span class="studio__draft" id="studio-draft-status">Draft saved locally</span>
        <button class="studio__ghost studio__ghost--small" type="button" id="open-command-sheet">Commands</button>
        <button class="studio__ghost studio__ghost--small" type="button" id="studio-reset">Reset</button>
      </div>
      <div class="studio__trust-strip" aria-label="Safety facts">
        <span>Local actions run on this computer</span>
        <span>SSH password is never saved</span>
        <span>Deploy changes wait for review</span>
      </div>
    </header>

    <section class="studio__cockpit" aria-label="Guided Studio cockpit">
      <aside class="studio__journey" aria-label="Setup journey">
        <ol class="studio__steps" id="studio-steps">
          {studioJourneySteps.map((step, index) => (
            <li>
              <button type="button" data-step-target={step.id}>
                <span class="studio__step-index">{String(index + 1).padStart(2, '0')}</span>
                <span>
                  <strong>{step.label}</strong>
                  <small class="studio__step-status" data-step-status>Ready</small>
                </span>
              </button>
            </li>
          ))}
        </ol>
      </aside>

      <section class="studio__task">
        <div class="studio__task-meta">
          <span id="studio-current-step">Prepare: VPS basics</span>
          <span>Guided setup</span>
        </div>

        <div class="studio__task-status" role="status" aria-live="polite">
          <span>Status</span>
          <strong id="status-title">Ready</strong>
          <small id="status-detail">Studio is checking whether a local Engine is available.</small>
        </div>

        <details class="studio__step-help">
          <summary>
            <span>Need help with this step?</span>
            <strong id="studio-context-title">{firstContext.contextTitle}</strong>
          </summary>
          <p id="studio-context-body">{firstContext.contextBody}</p>
          <ul class="studio__context-list" id="studio-context-list">
            {firstContext.contextItems.map((item) => <li>{item}</li>)}
          </ul>
        </details>

        <article class="studio__screen" data-step-panel="welcome">
          <div class="studio__screen-head">
            <p class="studio__kicker">Start here</p>
            <h2>Copy the VPS details from your provider</h2>
            <p>
              Keep the provider page open. Studio only needs the server IP, SSH username, SSH port, and the first-login
              password if the server does not already have your SSH key.
            </p>
          </div>

          <div class="studio__mode-gate" id="studio-mode-gate" data-mode="static">
            <div>
              <strong id="mode-gate-title">Start Local Studio for the guided path</strong>
              <p id="mode-gate-body">
                This page can prepare commands, but saving servers, checking SSH, installing keys, and deploying need
                the localhost Engine from <code>meridian studio</code>.
              </p>
            </div>
            <button class="studio__secondary" type="button" id="mode-gate-command">Copy meridian studio</button>
          </div>

          <div class="studio__saved-start" id="saved-server-start" hidden>
            <div>
              <strong>Use a saved server</strong>
              <p>Skip typing when this computer already knows a VPS.</p>
            </div>
            <div id="saved-server-start-list"></div>
          </div>

          <div class="studio__provider-grid" aria-label="Provider details to copy">
            <div class="studio__detail-tile">
              <span>Public IP</span>
              <strong>198.51.100.10</strong>
              <small>The internet-facing server address.</small>
            </div>
            <div class="studio__detail-tile">
              <span>SSH user</span>
              <strong>root or ubuntu</strong>
              <small>The Linux login name from the provider.</small>
            </div>
            <div class="studio__detail-tile">
              <span>SSH port</span>
              <strong>22</strong>
              <small>Use the provider value if it is different.</small>
            </div>
            <div class="studio__detail-tile">
              <span>First password</span>
              <strong>Used once</strong>
              <small>Only needed to install a key in Local Studio.</small>
            </div>
          </div>

          <div class="studio__faq">
            <h3>Quick answers</h3>
            {studioFaqs.welcome.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__primary" type="button" data-next-step="server">I have these details</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="server" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Connection details</p>
            <h2>Paste the SSH command from your VPS provider</h2>
            <p>Studio fills the technical fields from the command. Give the server a friendly title so you can recognize it later.</p>
          </div>

          <div class="studio__recommended-path studio__field-grid--server">
            <label class="studio__field studio__field--wide" for="server-ssh-command">
              <span>Paste SSH command <StudioHelp helpKey="sshCommandPaste" text={studioHelp.sshCommandPaste} /></span>
              <input id="server-ssh-command" type="text" autocomplete="off" placeholder="ssh ubuntu@198.51.100.10 -p 2222" />
              <small class="studio__field-help">Look for a command like this in your provider dashboard or welcome email.</small>
            </label>
            <div class="studio__parse-chips" id="ssh-command-preview" hidden></div>
            <label class="studio__field studio__field--wide" for="server-title">
              <span>Server title <StudioHelp helpKey="serverTitle" text={studioHelp.serverTitle} /></span>
              <input id="server-title" type="text" autocomplete="off" placeholder="Family VPN" />
              <small class="studio__field-help">Use a name you will recognize later, such as Family VPN or London VPS.</small>
            </label>
          </div>

          <details class="studio__manual-entry">
            <summary>I do not have an SSH command</summary>
            <p>Enter the same details manually. They are usually shown as IP address, username, and port.</p>
            <div class="studio__field-grid">
              <label class="studio__field" for="server-host">
                <span>Public IP <StudioHelp helpKey="serverPublicIp" text={studioHelp.serverPublicIp} /></span>
                <input id="server-host" type="text" inputmode="numeric" autocomplete="off" placeholder="198.51.100.10" />
                <small class="studio__field-help">Use the public internet address from the VPS provider.</small>
              </label>
              <label class="studio__field" for="server-user">
                <span>SSH username <StudioHelp helpKey="sshUsername" text={studioHelp.sshUsername} /></span>
                <input id="server-user" type="text" autocomplete="username" placeholder="root" />
                <small class="studio__field-help">Common values are root, ubuntu, debian, or admin.</small>
              </label>
              <label class="studio__field" for="server-port">
                <span>SSH port <StudioHelp helpKey="sshPort" text={studioHelp.sshPort} /></span>
                <input id="server-port" type="number" inputmode="numeric" min="1" max="65535" />
                <small class="studio__field-help">Use 22 unless the provider gave you a different port.</small>
              </label>
            </div>
          </details>

          <div class="studio__errors" id="server-errors" role="alert" aria-live="assertive" hidden></div>
          <div class="studio__action-status" id="server-action-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="welcome">Back</button>
            <button class="studio__ghost" type="button" id="save-server">Save only</button>
            <button class="studio__primary" type="button" id="save-and-validate">Check server access</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="connect" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">SSH check</p>
            <h2>Confirm Meridian can reach the server</h2>
            <p>This validation does not deploy anything. It checks reachability, authentication, and whether sudo works.</p>
          </div>

          <div class="studio__notice" id="saved-server-notice" role="status" aria-live="polite" hidden></div>
          <div class="studio__facts" id="validation-facts" role="status" aria-live="polite" hidden></div>

          <div class="studio__split-action" data-local-action>
            <div>
              <strong>Local Studio</strong>
              <p>Runs the validation here and returns friendly next steps if something is wrong.</p>
            </div>
            <button class="studio__secondary" type="button" id="validate-server">Validate SSH</button>
          </div>
          <div class="studio__split-action" data-static-action>
            <div>
              <strong>Static fallback</strong>
              <p>Copies the manual SSH command so you can test the same connection in Terminal.</p>
            </div>
            <button class="studio__ghost" type="button" id="copy-ssh-command">Copy SSH command</button>
          </div>

          <div class="studio__faq">
            <h3>Troubleshooting</h3>
            {studioFaqs.connect.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="server">Back</button>
            <button class="studio__secondary" type="button" id="confirm-manual-ssh" data-static-action>I checked SSH manually</button>
            <button class="studio__primary" type="button" data-next-step="keys">Prepare key-based SSH</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="keys" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Secure access</p>
            <h2>Use the password once, then use a key</h2>
            <p>A private key stays on this computer. Its public key is installed on the server and verified immediately.</p>
          </div>

          <div class="studio__key-diagram" aria-label="SSH key explanation">
            <div>
              <span>Private key</span>
              <strong>This computer</strong>
              <small>Secret. Never pasted or uploaded.</small>
            </div>
            <div class="studio__key-arrow" aria-hidden="true">to</div>
            <div>
              <span>Public key</span>
              <strong>Your VPS</strong>
              <small>Safe to install on the server.</small>
            </div>
          </div>

          <div class="studio__field-grid">
            <label class="studio__field" for="server-password">
              <span>One-time SSH password <StudioHelp helpKey="sshPassword" text={studioHelp.sshPassword} /></span>
              <input id="server-password" type="password" autocomplete="off" data-lpignore="true" />
            </label>
            <label class="studio__choice-card" for="disable-password-auth">
              <input id="disable-password-auth" type="checkbox" />
              <span>
                <strong>Ask deploy to disable password SSH later <StudioHelp helpKey="disablePasswordAuth" text={studioHelp.disablePasswordAuth} /></strong>
                <small>{studioHelp.disablePasswordAuth}</small>
              </span>
            </label>
          </div>

          <div class="studio__action-status" id="key-action-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__split-action" data-local-action>
            <div>
              <strong>Recommended</strong>
              <p>Generate a Meridian key, install its public half, then verify key login.</p>
            </div>
            <button class="studio__secondary" type="button" id="bootstrap-key">Install and verify key</button>
          </div>
          <div class="studio__split-action" data-static-action>
            <div>
              <strong>Manual fallback</strong>
              <p>Copy the standard command if you prefer to do key setup in Terminal.</p>
            </div>
            <button class="studio__ghost" type="button" id="copy-key-command">Copy manual key command</button>
          </div>

          <div class="studio__faq">
            <h3>Key basics</h3>
            {studioFaqs.keys.map(([question, answer]) => (
              <details>
                <summary>{question}</summary>
                <p>{answer}</p>
              </details>
            ))}
          </div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="connect">Back</button>
            <button class="studio__secondary" type="button" id="confirm-manual-key" data-static-action>I completed key setup</button>
            <button class="studio__primary" type="button" data-next-step="deploy">Choose deploy options</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="deploy" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Safe defaults</p>
            <h2>Choose what the first setup should create</h2>
            <p>Start with the recommended options. Advanced camouflage and routing stay available in the command sheet.</p>
          </div>

          <label class="studio__field studio__field--wide" id="saved-server-field" for="saved-server" hidden>
            <span>Use saved server <StudioHelp helpKey="savedServer" text={studioHelp.savedServer} /></span>
            <select id="saved-server"></select>
          </label>

          <div class="studio__field-grid">
            <label class="studio__field" for="deploy-server-name">
              <span>Connection page name <StudioHelp helpKey="displayName" text={studioHelp.displayName} /></span>
              <input id="deploy-server-name" type="text" placeholder="My VPN" />
            </label>
            <label class="studio__field" for="deploy-client-name">
              <span>First client name <StudioHelp helpKey="clientName" text={studioHelp.clientName} /></span>
              <input id="deploy-client-name" type="text" placeholder="default" />
            </label>
          </div>

          <div class="studio__choice-grid">
            <label class="studio__choice-card" for="deploy-harden">
              <input id="deploy-harden" type="checkbox" />
              <span>
                <strong>Harden SSH and firewall <StudioHelp helpKey="hardening" text={studioHelp.hardening} /></strong>
                <small>{studioHelp.hardening}</small>
              </span>
            </label>
            <label class="studio__choice-card" for="deploy-geo-block">
              <input id="deploy-geo-block" type="checkbox" />
              <span>
                <strong>Block RU traffic <StudioHelp helpKey="geoBlock" text={studioHelp.geoBlock} /></strong>
                <small>{studioHelp.geoBlock}</small>
              </span>
            </label>
          </div>

          <details class="studio__advanced" id="deploy-advanced">
            <summary>Advanced deploy settings</summary>
            <div class="studio__field-grid">
              <label class="studio__field" for="deploy-sni">
                <span>Camouflage target <StudioHelp helpKey="sni" text={studioHelp.sni} /></span>
                <input id="deploy-sni" type="text" />
              </label>
              <label class="studio__field" for="deploy-domain">
                <span>Domain <StudioHelp helpKey="domain" text={studioHelp.domain} /></span>
                <input id="deploy-domain" type="text" />
              </label>
              <label class="studio__field" for="deploy-color">
                <span>Color palette <StudioHelp helpKey="color" text={studioHelp.color} /></span>
                <select id="deploy-color">
                  {colorOptions.map((option) => <option value={option.value}>{option.label}</option>)}
                </select>
              </label>
              <label class="studio__field" for="deploy-icon">
                <span>Icon <StudioHelp helpKey="icon" text={studioHelp.icon} /></span>
                <input id="deploy-icon" type="text" />
              </label>
              <label class="studio__choice-card" for="deploy-pq">
                <input id="deploy-pq" type="checkbox" />
                <span>
                  <strong>Post-quantum encryption <StudioHelp helpKey="pq" text={studioHelp.pq} /></strong>
                  <small>{studioHelp.pq}</small>
                </span>
              </label>
              <label class="studio__choice-card" for="deploy-warp">
                <input id="deploy-warp" type="checkbox" />
                <span>
                  <strong>Cloudflare WARP <StudioHelp helpKey="warp" text={studioHelp.warp} /></strong>
                  <small>{studioHelp.warp}</small>
                </span>
              </label>
            </div>
          </details>

          <div class="studio__action-status" id="deploy-preview-status" role="status" aria-live="polite" hidden></div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="keys">Back</button>
            <button class="studio__primary" type="button" id="run-dry-run">Preview changes</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="review" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Confirmation boundary</p>
            <h2>Review what Meridian will change</h2>
            <p>Key setup may have installed a public SSH key already. VPN services, firewall changes, and SSH hardening wait for this deploy review.</p>
          </div>

          <div class="studio__review" id="review-summary"></div>
          <div class="studio__action-status" id="plan-gate-status" role="status" aria-live="polite" hidden></div>

          <label class="studio__confirm" for="confirm-deploy">
            <input id="confirm-deploy" type="checkbox" />
            <span>I reviewed this and want Meridian to change the server.</span>
          </label>
          <div class="studio__errors" id="deploy-errors" role="alert" aria-live="assertive" hidden></div>

          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="deploy">Back</button>
            <button class="studio__ghost" type="button" id="download-request">Download deploy.json</button>
            <button class="studio__secondary" type="button" id="copy-deploy-command">Copy deploy command</button>
            <button class="studio__primary" type="button" id="start-deploy">Start deploy</button>
          </div>
        </article>

        <article class="studio__screen" data-step-panel="complete" hidden>
          <div class="studio__screen-head">
            <p class="studio__kicker">Evidence</p>
            <h2>Progress and result</h2>
            <p id="completion-copy">Run a dry-run or deploy to see operation evidence here.</p>
          </div>
          <div class="studio__progress-card" id="operation-progress-card" role="status" aria-live="polite" hidden></div>
          <div class="studio__result" id="studio-result" data-status="idle" role="status" aria-live="polite"></div>
          <div class="studio__action-center" id="deploy-action-center" hidden>
            <div>
              <strong>Next steps</strong>
              <p id="deploy-action-copy">Finish with a connection test before adding relays or more complex routes.</p>
            </div>
            <div class="studio__action-center-buttons">
              <button class="studio__primary" type="button" id="copy-invite-link">Copy invite link</button>
              <button class="studio__secondary" type="button" id="copy-test-command">Copy test command</button>
              <button class="studio__secondary" type="button" id="copy-add-device-command">Copy add-device command</button>
            </div>
            <ul class="studio__post-deploy-list" id="deploy-action-list"></ul>
          </div>
          <div class="studio__recovery-card" id="deploy-recovery-card" hidden>
            <div>
              <strong id="recovery-title">Recovery</strong>
              <p id="recovery-copy">Studio will show the safest next step here if deploy fails.</p>
            </div>
            <div class="studio__action-center-buttons">
              <button class="studio__primary" type="button" id="retry-deploy">Try deploy again</button>
              <button class="studio__secondary" type="button" id="copy-diagnostics">Copy diagnostic report</button>
            </div>
          </div>
          <ol class="studio__timeline" id="studio-timeline"></ol>
          <div class="studio__actionbar">
            <button class="studio__ghost" type="button" data-prev-step="review">Back</button>
            <button class="studio__secondary" type="button" id="cancel-operation">Stop after current step</button>
          </div>
        </article>
      </section>
    </section>

    <dialog class="studio__sheet" id="command-sheet" aria-labelledby="command-sheet-title">
      <div class="studio__sheet-head">
        <div>
          <p class="studio__kicker">Advanced drawer</p>
          <h2 id="command-sheet-title">Command sheet</h2>
        </div>
        <button class="studio__ghost studio__ghost--small" type="button" id="close-command-sheet">Close</button>
      </div>

      <div class="studio__sheet-grid">
        <section>
          <div class="studio__panel-head">
            <h3>Static fallback</h3>
            <button class="studio__ghost studio__ghost--small" type="button" id="download-server">Download server.json</button>
            <button class="studio__ghost studio__ghost--small" type="button" id="download-request-sheet">Download deploy.json</button>
          </div>
          <div class="studio__command-list">
            <button class="studio__command" type="button" id="copy-save-command"><span id="save-command"></span></button>
            <button class="studio__command" type="button" id="copy-dry-run-command"><span id="dry-run-command"></span></button>
          </div>
          <p class="studio__copy-status" id="copy-status" aria-live="polite"></p>
        </section>

        <section>
          <div class="studio__panel-head">
            <h3>server.json</h3>
          </div>
          <pre class="studio__code" id="server-json"></pre>
        </section>

        <section>
          <div class="studio__panel-head">
            <h3>deploy.json</h3>
          </div>
          <pre class="studio__code" id="request-json"></pre>
        </section>

        <section>
          <label class="studio__field" for="studio-paste">
            <span>Pasted machine output <StudioHelp helpKey="pastedOutput" text={studioHelp.pastedOutput} /></span>
            <textarea id="studio-paste" spellcheck="false"></textarea>
          </label>
          <div class="studio__sheet-actions">
            <button class="studio__secondary" type="button" id="parse-output">Parse output</button>
          </div>
          <p class="studio__copy-status" id="parse-status" aria-live="polite"></p>
        </section>
      </div>
    </dialog>
  </main>
</Base>

<script>
  // @ts-nocheck
  import { studioJourneySteps } from '../studio/helpCatalog.js';
  import { connectLocalEngine, engineGet, enginePost } from '../studio/localEngineAdapter.js';
  import {
    buildCliCommands,
    buildCommandPack,
    buildDeployRequestFromJourney,
    buildServerCliCommands,
    buildServerConnectionDraft,
    formatJson,
    parseSshCommand,
    parseEnvelope,
    parseEventStream,
    summarizeEnvelope,
    timelineFromEvents,
    validateDeployRequest,
    validateServerConnectionDraft,
  } from '../studio/staticAdapter.js';
  import {
    clearJourneyDraft,
    createDefaultJourneyState,
    loadJourneyDraft,
    saveJourneyDraft,
  } from '../studio/storageAdapter.js';
  import {
    deployRequestSchema,
    deployWorkflow,
    serverConnectionDraftSchema,
    serverOnboardingWorkflow,
  } from '../studio/generated';

  const steps = studioJourneySteps.map((step) => step.id);
  const $ = (id) => document.getElementById(id);
  const fields = {
    title: $('server-title'),
    host: $('server-host'),
    user: $('server-user'),
    port: $('server-port'),
    sshCommand: $('server-ssh-command'),
    password: $('server-password'),
    disablePasswordAuth: $('disable-password-auth'),
    savedServer: $('saved-server'),
    serverName: $('deploy-server-name'),
    clientName: $('deploy-client-name'),
    harden: $('deploy-harden'),
    geoBlock: $('deploy-geo-block'),
    sni: $('deploy-sni'),
    domain: $('deploy-domain'),
    color: $('deploy-color'),
    icon: $('deploy-icon'),
    pq: $('deploy-pq'),
    warp: $('deploy-warp'),
    confirm: $('confirm-deploy'),
  };
  const els = {
    mode: $('studio-mode'),
    modeLabel: $('studio-mode-label'),
    draftStatus: $('studio-draft-status'),
    currentStep: $('studio-current-step'),
    statusTitle: $('status-title'),
    statusDetail: $('status-detail'),
    contextTitle: $('studio-context-title'),
    contextBody: $('studio-context-body'),
    contextList: $('studio-context-list'),
    serverErrors: $('server-errors'),
    deployErrors: $('deploy-errors'),
    sshCommandPreview: $('ssh-command-preview'),
    modeGate: $('studio-mode-gate'),
    modeGateTitle: $('mode-gate-title'),
    modeGateBody: $('mode-gate-body'),
    savedServerStart: $('saved-server-start'),
    savedServerStartList: $('saved-server-start-list'),
    serverActionStatus: $('server-action-status'),
    validationFacts: $('validation-facts'),
    keyActionStatus: $('key-action-status'),
    deployPreviewStatus: $('deploy-preview-status'),
    planGateStatus: $('plan-gate-status'),
    savedServerField: $('saved-server-field'),
    savedServerNotice: $('saved-server-notice'),
    reviewSummary: $('review-summary'),
    progressCard: $('operation-progress-card'),
    result: $('studio-result'),
    actionCenter: $('deploy-action-center'),
    actionCopy: $('deploy-action-copy'),
    actionList: $('deploy-action-list'),
    copyInviteLink: $('copy-invite-link'),
    copyTestCommand: $('copy-test-command'),
    copyAddDeviceCommand: $('copy-add-device-command'),
    recoveryCard: $('deploy-recovery-card'),
    recoveryTitle: $('recovery-title'),
    recoveryCopy: $('recovery-copy'),
    retryDeploy: $('retry-deploy'),
    copyDiagnostics: $('copy-diagnostics'),
    timeline: $('studio-timeline'),
    completionCopy: $('completion-copy'),
    copyStatus: $('copy-status'),
    parseStatus: $('parse-status'),
    paste: $('studio-paste'),
    serverJson: $('server-json'),
    requestJson: $('request-json'),
    saveCommand: $('save-command'),
    dryRunCommand: $('dry-run-command'),
    saveServer: $('save-server'),
    saveAndValidate: $('save-and-validate'),
    validateServer: $('validate-server'),
    bootstrapKey: $('bootstrap-key'),
    runDryRun: $('run-dry-run'),
    startDeploy: $('start-deploy'),
    cancelOperation: $('cancel-operation'),
    commandSheet: $('command-sheet'),
  };
  const commands = buildCliCommands();
  let journey = loadJourneyDraft(window.localStorage);
  let engine = null;
  let savedServers = [];
  let savedServersLoaded = false;
  let currentOperationId = journey.activeOperationId || '';
  let lastEventSeq = 0;
  let operationEvents = [];
  let pollTimer = 0;
  let latestPlan = null;
  let latestPlanSource = '';
  let lastDeployResult = null;
  let lastFailure = null;
  let lastTerminalOperationId = '';
  let commandSheetReturnFocus = null;
  let activityStatus = {
    title: 'Ready',
    detail: 'Studio is checking whether a local Engine is available.',
  };

  function serverDraft() {
    return buildServerConnectionDraft({
      host: journey.server.host,
      ssh_port: journey.server.ssh_port,
      ssh_user: journey.server.ssh_user,
      title: journey.server.title,
    });
  }

  function deployRequest(confirm = false) {
    return buildDeployRequestFromJourney({ ...journey, confirmDeploy: confirm });
  }

  function requestSignature(request) {
    return JSON.stringify(Object.keys(request).sort().reduce((sorted, key) => {
      sorted[key] = request[key];
      return sorted;
    }, {}));
  }

  function expectedDryRunServerIp(request) {
    if (request.ip) return request.ip;
    const selected = savedServers.find((server) =>
      [server.id, server.title, server.host].includes(request.requested_server),
    );
    return selected?.host || '';
  }

  function persist() {
    saveJourneyDraft(window.localStorage, journey);
    els.draftStatus.textContent = 'Draft saved locally';
  }

  function setStep(step) {
    const target = steps.includes(step) ? step : 'welcome';
    const gate = stepGate(target);
    if (!gate.allowed) {
      setStatus('Finish this step first', gate.reason, 'warning');
      showStatus(els.planGateStatus, 'Review is locked', gate.reason, 'warning');
      return;
    }
    journey.currentStep = target;
    persist();
    render();
    window.requestAnimationFrame(() => focusCurrentStep());
  }

  function setStatus(title, detail, tone = 'ok') {
    activityStatus = { title, detail };
    els.statusTitle.textContent = title;
    els.statusDetail.textContent = detail;
    els.statusTitle.closest('.studio__task-status')?.setAttribute('data-tone', tone);
  }

  function stepGate(step) {
    const order = steps.indexOf(step);
    const serverErrors = validateServerConnectionDraft(serverDraft(), serverConnectionDraftSchema, serverOnboardingWorkflow);
    const request = deployRequest(false);
    const deployErrors = validateDeployRequest(request, deployRequestSchema, deployWorkflow);
    if (step === 'review') {
      if (deployErrors.length > 0) {
        return { allowed: false, reason: 'Fix deploy options before previewing changes.' };
      }
      if (!latestPlan) {
        return { allowed: false, reason: 'Run Preview changes so Studio has real plan evidence for this tab.' };
      }
      if (!journey.readiness.dryRunComplete || journey.lastDryRunSignature !== requestSignature(request)) {
        return { allowed: false, reason: 'Preview changes with the current request before review.' };
      }
      return { allowed: true, reason: '' };
    }
    if (order <= steps.indexOf(journey.currentStep) || step === 'welcome' || step === 'server') {
      return { allowed: true, reason: '' };
    }
    if (step === 'connect') {
      return serverErrors.length === 0
        ? { allowed: true, reason: '' }
        : { allowed: false, reason: 'Enter a valid server title, public IP, SSH username, and SSH port first.' };
    }
    if (step === 'keys') {
      return serverErrors.length === 0
        ? { allowed: true, reason: '' }
        : { allowed: false, reason: 'Enter valid server details before key setup.' };
    }
    if (step === 'deploy') {
      return journey.readiness.sshValidated || journey.readiness.keyReady
        ? { allowed: true, reason: '' }
        : { allowed: false, reason: 'Meridian needs a confirmed server connection before deploy options matter.' };
    }
    return { allowed: true, reason: '' };
  }

  function render() {
    document.querySelectorAll('[data-step-panel]').forEach((panel) => {
      panel.hidden = panel.dataset.stepPanel !== journey.currentStep;
    });
    document.querySelectorAll('[data-step-target]').forEach((button) => {
      const active = button.dataset.stepTarget === journey.currentStep;
      const state = stepProgress(button.dataset.stepTarget);
      const gate = stepGate(button.dataset.stepTarget);
      const meta = studioJourneySteps.find((item) => item.id === button.dataset.stepTarget);
      const label = meta ? `${meta.label}: ${meta.short}` : button.textContent?.trim() || 'Step';
      button.setAttribute('aria-current', active ? 'step' : 'false');
      button.setAttribute('aria-disabled', state === 'locked' ? 'true' : 'false');
      button.setAttribute(
        'aria-label',
        state === 'locked'
          ? `${label}: locked. ${gate.reason}`
          : label,
      );
      button.dataset.state = state;
      button.title = state === 'locked' ? gate.reason : '';
      const status = button.querySelector('[data-step-status]');
      if (status) status.textContent = stepStateLabel(state);
    });

    const step = studioJourneySteps.find((item) => item.id === journey.currentStep) ?? studioJourneySteps[0];
    els.currentStep.textContent = `${step.label}: ${step.short}`;
    els.contextTitle.textContent = step.contextTitle;
    els.contextBody.textContent = step.contextBody;
    els.contextList.replaceChildren(
      ...step.contextItems.map((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        return li;
      }),
    );

    fields.title.value = journey.server.title;
    fields.host.value = journey.server.host;
    fields.user.value = journey.server.ssh_user;
    fields.port.value = String(journey.server.ssh_port);
    fields.serverName.value = journey.deploy.server_name;
    fields.clientName.value = journey.deploy.client_name;
    fields.harden.checked = Boolean(journey.deploy.harden);
    fields.geoBlock.checked = Boolean(journey.deploy.geo_block);
    fields.sni.value = journey.deploy.sni;
    fields.domain.value = journey.deploy.domain;
    fields.color.value = journey.deploy.color;
    fields.icon.value = journey.deploy.icon;
    fields.pq.checked = Boolean(journey.deploy.pq);
    fields.warp.checked = Boolean(journey.deploy.warp);
    fields.confirm.checked = Boolean(journey.confirmDeploy);

    renderSavedServers();
    const draft = serverDraft();
    const request = deployRequest();
    const signature = requestSignature(request);
    const serverErrors = validateServerConnectionDraft(draft, serverConnectionDraftSchema, serverOnboardingWorkflow);
    const deployErrors = validateDeployRequest(request, deployRequestSchema, deployWorkflow);
    const pack = buildCommandPack({ deployRequest: request, serverDraft: draft });

    els.serverJson.textContent = formatJson(draft);
    els.requestJson.textContent = formatJson(request);
    els.saveCommand.textContent = pack.saveServer;
    els.dryRunCommand.textContent = pack.dryRun;
    renderErrors(els.serverErrors, serverErrors);
    renderErrors(els.deployErrors, deployErrors);
    renderReview(draft, request);
    renderModeGate();
    renderPlanGate(signature);

    els.saveServer.disabled = !engine || serverErrors.length > 0;
    els.saveAndValidate.disabled = !engine || serverErrors.length > 0;
    els.validateServer.disabled = !engine || serverErrors.length > 0;
    els.bootstrapKey.disabled = !engine || serverErrors.length > 0;
    els.runDryRun.disabled = engine ? deployErrors.length > 0 : false;
    els.startDeploy.disabled =
      !engine ||
      !latestPlan ||
      deployErrors.length > 0 ||
      !journey.confirmDeploy ||
      !journey.readiness.dryRunComplete ||
      journey.lastDryRunSignature !== signature;
    els.cancelOperation.disabled = !currentOperationId || !engine;
    document.querySelectorAll('[data-local-action]').forEach((element) => {
      element.hidden = !engine;
    });
    document.querySelectorAll('[data-static-action]').forEach((element) => {
      element.hidden = Boolean(engine);
    });

    els.mode.dataset.state = engine ? 'engine' : 'static';
    els.modeLabel.textContent = engine ? 'Local Studio' : 'Static Studio';
    els.statusTitle.textContent = activityStatus.title;
    els.statusDetail.textContent = activityStatus.detail;
  }

  function stepProgress(step) {
    if (step === journey.currentStep) return 'active';
    if (step === 'welcome') return 'done';
    if (step === 'server') return journey.readiness.serverSaved ? 'done' : 'available';
    if (step === 'connect') return journey.readiness.sshValidated ? 'done' : stepGate(step).allowed ? 'available' : 'locked';
    if (step === 'keys') return journey.readiness.keyReady ? 'done' : stepGate(step).allowed ? 'available' : 'locked';
    if (step === 'deploy') return journey.readiness.dryRunComplete ? 'done' : stepGate(step).allowed ? 'available' : 'locked';
    if (step === 'review') return stepGate(step).allowed ? 'available' : 'locked';
    if (step === 'complete') return currentOperationId || journey.readiness.dryRunComplete ? 'available' : 'locked';
    return 'available';
  }

  function stepStateLabel(state) {
    if (state === 'active') return 'Current step';
    if (state === 'done') return 'Done';
    if (state === 'locked') return 'Locked';
    return 'Ready';
  }

  function focusCurrentStep() {
    const panel = document.querySelector(`[data-step-panel="${journey.currentStep}"]`);
    const heading = panel?.querySelector('h2');
    if (heading instanceof HTMLElement) {
      heading.setAttribute('tabindex', '-1');
      heading.focus({ preventScroll: true });
    }
  }

  function renderModeGate() {
    els.modeGate.dataset.mode = engine ? 'engine' : 'static';
    els.modeGateTitle.textContent = engine ? 'Local Studio is connected' : 'Start Local Studio for the guided path';
    $('mode-gate-command').textContent = engine ? 'Open command sheet' : 'Copy meridian studio';
    const text = document.createElement('span');
    text.textContent = engine
      ? 'Save servers, check SSH, install keys, preview, and deploy from this computer.'
      : 'Copy ';
    if (!engine) {
      const code = document.createElement('code');
      code.textContent = 'meridian studio';
      els.modeGateBody.replaceChildren(
        text,
        code,
        document.createTextNode(', run it in Terminal, then keep this page open while it reconnects.'),
      );
      return;
    }
    els.modeGateBody.replaceChildren(text);
  }

  function renderPlanGate(signature) {
    const requestChanged = journey.lastDryRunSignature && journey.lastDryRunSignature !== signature;
    if (journey.readiness.dryRunComplete && !requestChanged && latestPlan) {
      const source = latestPlanSource === 'static' ? 'Imported CLI dry-run' : 'Local Engine dry-run';
      showStatus(els.planGateStatus, 'Preview ready', `${source} is loaded for this review. Confirm the changes to unlock deploy.`, 'ok');
      return;
    }
    if (journey.readiness.dryRunComplete && !latestPlan) {
      showStatus(els.planGateStatus, 'Preview evidence missing', 'Run Preview changes again so Studio can show the actual plan for this tab.', 'warning');
      return;
    }
    if (requestChanged) {
      showStatus(els.planGateStatus, 'Preview needs refresh', 'Deploy options changed. Preview changes again before starting deploy.', 'warning');
      return;
    }
    showStatus(els.planGateStatus, 'Preview required', 'Use Preview changes before review so this page shows a real plan.', 'warning');
  }

  function renderSavedServers() {
    els.savedServerField.hidden = savedServers.length === 0;
    const current = journey.selectedServerId;
    const options = [
      new Option('Use the server entered above', ''),
      ...savedServers.map((server) => new Option(`${server.title} (${server.host})`, server.id)),
    ];
    fields.savedServer.replaceChildren(...options);
    if (savedServers.some((server) => server.id === current)) {
      fields.savedServer.value = current;
    } else if (savedServersLoaded) {
      fields.savedServer.value = '';
      journey.selectedServerId = '';
    } else {
      fields.savedServer.value = '';
    }
    const selected = savedServers.find((server) => server.id === journey.selectedServerId);
    els.savedServerNotice.hidden = !selected;
    els.savedServerNotice.textContent = selected
      ? `Using saved server ${selected.title} at ${selected.host}:${selected.ssh_port}.`
      : '';
    renderSavedServerStart();
  }

  function renderSavedServerStart() {
    const usable = savedServers.filter((server) => ['validated', 'key_ready'].includes(server.auth_state));
    els.savedServerStart.hidden = usable.length === 0;
    els.savedServerStartList.replaceChildren(
      ...usable.map((server) => {
        const button = document.createElement('button');
        button.className = 'studio__saved-choice';
        button.type = 'button';
        button.dataset.useServer = server.id;
        const title = document.createElement('strong');
        const detail = document.createElement('span');
        title.textContent = server.title;
        detail.textContent = `${server.auth_state === 'key_ready' ? 'Key ready' : 'SSH checked'} · ${server.host}:${server.ssh_port}`;
        button.replaceChildren(title, detail);
        return button;
      }),
    );
  }

  function useSavedServer(serverId) {
    const server = savedServers.find((item) => item.id === serverId);
    if (!server) return;
    journey.selectedServerId = server.id;
    journey.readiness.serverSaved = true;
    journey.readiness.sshValidated = ['validated', 'key_ready'].includes(server.auth_state);
    journey.readiness.keyReady = server.auth_state === 'key_ready';
    journey.server.title = server.title;
    journey.server.host = server.host;
    journey.server.ssh_user = server.ssh_user;
    journey.server.ssh_port = server.ssh_port;
    showStatus(
      els.serverActionStatus,
      'Saved server selected',
      `${server.title} will be used for this deploy.`,
      'ok',
    );
    persist();
    setStep(journey.readiness.sshValidated ? 'deploy' : 'connect');
  }

  function renderErrors(container, errors) {
    container.hidden = errors.length === 0;
    container.replaceChildren(
      ...errors.map((error) => {
        const item = document.createElement('p');
        item.textContent = error.message;
        return item;
      }),
    );
  }

  function showStatus(container, title, detail, tone = 'ok') {
    container.hidden = false;
    container.dataset.tone = tone;
    const strong = document.createElement('strong');
    const span = document.createElement('span');
    strong.textContent = title;
    span.textContent = detail || '';
    container.replaceChildren(strong, span);
  }

  function hideStatus(container) {
    container.hidden = true;
    container.replaceChildren();
  }

  function renderValidationFacts(result) {
    if (!result) {
      els.validationFacts.hidden = true;
      els.validationFacts.replaceChildren();
      return;
    }
    const facts = [
      ['Reached server', result.reachable, result.reachable ? 'The SSH port answered.' : 'Check the IP address, SSH port, and provider firewall.'],
      ['Logged in', result.auth_ok, result.auth_ok ? 'The username and key/password worked.' : 'Check username, password, or key setup.'],
      ['Sudo works', result.sudo_ok, result.sudo_ok ? 'Meridian can make system changes.' : 'Use root or a user with passwordless sudo.'],
      ['Detected OS', Boolean(result.detected_os), result.detected_os || 'OS was not detected yet.'],
    ];
    els.validationFacts.hidden = false;
    els.validationFacts.replaceChildren(
      ...facts.map(([label, ok, detail]) => {
        const item = document.createElement('div');
        item.className = ok ? 'studio__fact studio__fact--ok' : 'studio__fact studio__fact--warn';
        const title = document.createElement('strong');
        const copy = document.createElement('span');
        title.textContent = label;
        copy.textContent = detail;
        item.replaceChildren(title, copy);
        return item;
      }),
    );
  }

  function renderReview(draft, request) {
    const previewReady = Boolean(journey.readiness.dryRunComplete && latestPlan);
    const target = journey.selectedServerId || `${draft.title} (${draft.host}:${draft.ssh_port})`;
    const ports = latestPlan?.ports
      ? `Ports: Reality ${latestPlan.ports.reality_port}, WSS ${latestPlan.ports.wss_port}, XHTTP ${latestPlan.ports.xhttp_port}.`
      : 'Ports appear after preview.';
    const cards = [
      {
        title: 'Target',
        badge: previewReady ? 'Previewed' : 'Needs preview',
        detail: `${target}. Install target: ${latestPlan?.server_ip || request.ip || 'saved server'}.`,
        tone: previewReady ? 'ok' : 'warning',
      },
      {
        title: 'VPN services',
        badge: latestPlan?.mode === 'redeploy' ? 'Update' : 'Install',
        detail: `${latestPlan?.mode === 'redeploy' ? 'Updates existing Meridian services' : 'Installs Meridian services'} for ${request.server_name}. ${ports}`,
        tone: 'change',
      },
      {
        title: 'SSH and firewall',
        badge: request.harden ? 'Will harden' : 'Hardening off',
        detail: request.harden
          ? 'Deploy may tighten SSH and firewall rules after key setup has been verified.'
          : 'Deploy will avoid SSH hardening for this run. Use this when the VPS already hosts other services.',
        tone: request.harden ? 'change' : 'quiet',
      },
      {
        title: 'First device',
        badge: 'Create profile',
        detail: `Creates the first client profile named ${request.client_name}. Test one device before adding relays or route policy.`,
        tone: 'ok',
      },
      {
        title: 'Traffic rules',
        badge: request.geo_block ? 'Block RU' : 'Default exit',
        detail: request.geo_block
          ? 'Blocks RU destinations on this server. Regional exits are configured separately.'
          : 'Traffic uses the default exit until a route policy is configured.',
        tone: request.geo_block ? 'warning' : 'quiet',
      },
      {
        title: 'Evidence source',
        badge: previewReady ? (latestPlanSource === 'static' ? 'CLI import' : 'Engine') : 'Missing',
        detail: previewReady
          ? 'This review is tied to the current deploy fields. Changing any option requires another preview.'
          : 'Preview changes before deploying so this review is based on real plan evidence.',
        tone: previewReady ? 'ok' : 'warning',
      },
    ];
    els.reviewSummary.replaceChildren(
      ...cards.map((card) => {
        const item = document.createElement('article');
        item.className = 'studio__impact-card';
        item.dataset.tone = card.tone;
        const top = document.createElement('div');
        const title = document.createElement('strong');
        const badge = document.createElement('span');
        const detail = document.createElement('p');
        title.textContent = card.title;
        badge.textContent = card.badge;
        detail.textContent = card.detail;
        top.replaceChildren(title, badge);
        item.replaceChildren(top, detail);
        return item;
      }),
    );
  }

  async function refreshSavedServers() {
    if (!engine) return;
    try {
      const payload = await engineGet('/api/v1/servers');
      savedServers = Array.isArray(payload.servers) ? payload.servers : [];
      savedServersLoaded = true;
    } catch {
      savedServers = [];
      savedServersLoaded = true;
    }
    render();
  }

  async function runAction(label, fn, options = {}) {
    setStatus(`${label} running`, 'Please wait. Do not refresh this page while a local action is running.', 'running');
    try {
      const payload = await fn();
      handleActionPayload(label, payload);
      setStatus(`${label} complete`, summarizePayload(payload), 'ok');
      renderPayload(payload);
      await refreshSavedServers();
      if (options.nextStep && (!options.requireReadiness || journey.readiness[options.requireReadiness])) {
        setStep(options.nextStep);
      }
    } catch (error) {
      renderEngineError(error);
    }
  }

  function handleActionPayload(label, payload) {
    if (payload.schema === 'meridian.server-profile/v1' && payload.server) {
      journey.readiness.serverSaved = true;
      journey.selectedServerId = payload.server.id || journey.selectedServerId;
      showStatus(els.serverActionStatus, 'Server saved', `${payload.server.title} is ready for an SSH check.`, 'ok');
      persist();
      return;
    }
    if (payload.schema === 'meridian.server-validate/v1' && payload.result) {
      const result = payload.result;
      renderValidationFacts(result);
      journey.readiness.sshValidated = Boolean(result.auth_ok && result.sudo_ok);
      if (result.server?.id) {
        journey.selectedServerId = result.server.id;
      }
      showStatus(
        els.serverActionStatus,
        journey.readiness.sshValidated ? 'SSH works' : 'SSH needs attention',
        summarizePayload(payload),
        journey.readiness.sshValidated ? 'ok' : 'warning',
      );
      persist();
      return;
    }
    if (payload.schema === 'meridian.server-bootstrap-key/v1' && payload.result) {
      journey.readiness.keyReady = Boolean(payload.result.verified);
      journey.readiness.sshValidated = journey.readiness.keyReady || journey.readiness.sshValidated;
      if (payload.result.server?.id) {
        journey.selectedServerId = payload.result.server.id;
      }
      showStatus(
        els.keyActionStatus,
        journey.readiness.keyReady ? 'Key login verified' : 'Public key installed',
        summarizePayload(payload),
        journey.readiness.keyReady ? 'ok' : 'warning',
      );
      persist();
      return;
    }
    if (payload.schema === 'meridian.deploy-dry-run/v1' && payload.plan) {
      latestPlan = payload.plan;
      latestPlanSource = 'engine';
      const signature = requestSignature(deployRequest(false));
      journey.readiness.dryRunComplete = true;
      journey.lastDryRunSignature = signature;
      showStatus(els.deployPreviewStatus, 'Preview ready', summarizePayload(payload), 'ok');
      persist();
    }
  }

  function summarizePayload(payload) {
    if (payload.schema === 'meridian.server-profile/v1' && payload.server) {
      return `${payload.server.title} saved at ${payload.server.host}:${payload.server.ssh_port}.`;
    }
    if (payload.schema === 'meridian.server-validate/v1' && payload.result) {
      if (payload.result.auth_ok && payload.result.sudo_ok) {
        return `SSH and sudo work${payload.result.detected_os ? ` on ${payload.result.detected_os}` : ''}.`;
      }
      if (Array.isArray(payload.result.hints) && payload.result.hints.length > 0) {
        return payload.result.hints.join(' ');
      }
      return 'SSH validation needs attention.';
    }
    if (payload.schema === 'meridian.server-bootstrap-key/v1' && payload.result) {
      const base = payload.result.verified
        ? 'Key login was verified. The password is no longer needed for Studio actions.'
        : 'Public key was installed, but Studio could not verify private-key login yet.';
      const warnings = Array.isArray(payload.result.warnings) ? payload.result.warnings : [];
      return warnings.length > 0 ? `${base} ${warnings.join(' ')}` : base;
    }
    if (payload.schema === 'meridian.deploy-dry-run/v1' && payload.plan) {
      return `Preview ready for ${payload.plan.server_ip}. Review the planned changes before deploy.`;
    }
    if (payload.schema === 'meridian.deploy-operation-result/v1' && payload.result) {
      return payload.result.summary || `Deploy completed for ${payload.result.server_ip}.`;
    }
    const body = payload.result || payload.plan || payload.server || payload;
    if (Array.isArray(body.hints) && body.hints.length > 0) return body.hints.join(' ');
    if (body.summary) return body.summary;
    if (body.mode && body.server_ip) return `Preview ready for ${body.server_ip}`;
    return payload.schema || 'Action finished.';
  }

  function renderPayload(payload) {
    if (payload.schema === 'meridian.deploy-operation-result/v1' && payload.result) {
      renderDeploySuccess(payload.result);
      return;
    }
    els.result.dataset.status = 'ok';
    const title = document.createElement('strong');
    const text = document.createElement('span');
    const details = document.createElement('small');
    const presentation = presentPayload(payload);
    title.textContent = presentation.status;
    text.textContent = presentation.title;
    details.textContent = summarizePayload(payload);
    els.result.replaceChildren(title, text, details);
  }

  function resetTerminalPanels() {
    els.actionCenter.hidden = true;
    els.recoveryCard.hidden = true;
    els.progressCard.hidden = true;
  }

  function renderDeploySuccess(result, options = {}) {
    lastDeployResult = result;
    lastFailure = null;
    els.result.dataset.status = options.afterCancel ? 'warning' : 'ok';
    const title = document.createElement('strong');
    const text = document.createElement('span');
    const details = document.createElement('small');
    title.textContent = options.afterCancel ? 'completed after stop request' : 'ready';
    text.textContent = result.summary || `Deploy completed for ${result.server_ip}.`;
    details.textContent = result.connection_page_url
      ? 'The invite link is ready. Test one device before changing route policy or adding relays.'
      : 'Deploy finished. Run a connection test before adding relays or more devices.';
    els.result.replaceChildren(title, text, details);
    renderActionCenter(result);
  }

  function renderActionCenter(result) {
    const invite = result.connection_page_url || '';
    const testCommand = result.test_command || `meridian test ${result.server_ip}`;
    const addDeviceCommand = `meridian client add ${result.client_name && result.client_name !== 'default' ? 'new-device' : 'phone'}`;
    const items = [
      'Open the invite link on one device and connect.',
      `Run ${testCommand} after the device connects.`,
      'Add relays or regional route exits only after the first device works.',
    ];
    if (result.domain) {
      items.push(`If you use Cloudflare for ${result.domain}, keep WebSockets enabled and SSL/TLS on Full (Strict).`);
    }
    els.actionCopy.textContent = invite
      ? 'Copy the invite link first, then run a connection test from Terminal.'
      : 'No invite URL was returned yet. Use the test command and client commands while recovery improves.';
    els.actionList.replaceChildren(
      ...items.map((item) => {
        const li = document.createElement('li');
        li.textContent = item;
        return li;
      }),
    );
    els.copyInviteLink.disabled = !invite;
    els.copyInviteLink.dataset.copyValue = invite;
    els.copyTestCommand.dataset.copyValue = testCommand;
    els.copyAddDeviceCommand.dataset.copyValue = addDeviceCommand;
    els.actionCenter.hidden = false;
    els.recoveryCard.hidden = true;
  }

  function renderRecoveryCard(error, operationId = '') {
    const message = error instanceof Error ? error.message : 'Deploy failed.';
    const headline = message.split('\n')[0] || 'Deploy needs attention';
    const hint = error?.hint || message.split('\n').slice(1).join(' ');
    const retryable = Boolean(error?.retryable ?? true);
    lastFailure = {
      message: headline,
      hint,
      retryable,
      operationId,
    };
    els.recoveryTitle.textContent = headline;
    els.recoveryCopy.textContent = hint || recoveryMessageFor(headline, retryable);
    els.retryDeploy.hidden = !retryable;
    els.copyDiagnostics.hidden = !operationId || !engine;
    els.recoveryCard.hidden = false;
    els.actionCenter.hidden = true;
  }

  function recoveryMessageFor(message, retryable) {
    if (/docker|container|compose/i.test(message)) {
      return 'The server may be partially prepared. Re-running deploy is safe after checking the provider firewall and Docker logs.';
    }
    if (/ssh|permission|sudo/i.test(message)) {
      return 'Fix SSH access first, then run the preview again before deploying.';
    }
    return retryable
      ? 'Re-running deploy is safe after checking the message above.'
      : 'This needs manual attention before retrying.';
  }

  function presentPayload(payload) {
    if (payload.schema === 'meridian.server-profile/v1') {
      return { status: 'saved', title: 'Server saved' };
    }
    if (payload.schema === 'meridian.server-validate/v1') {
      return { status: payload.result?.auth_ok && payload.result?.sudo_ok ? 'ready' : 'check', title: 'SSH check complete' };
    }
    if (payload.schema === 'meridian.server-bootstrap-key/v1') {
      return { status: payload.result?.verified ? 'ready' : 'check', title: 'SSH key setup complete' };
    }
    if (payload.schema === 'meridian.deploy-dry-run/v1') {
      return { status: 'preview', title: 'Deploy preview ready' };
    }
    if (payload.schema === 'meridian.deploy-operation-result/v1') {
      return { status: 'complete', title: 'Deploy finished' };
    }
    return { status: 'ok', title: 'Action complete' };
  }

  function renderEngineError(error, options = {}) {
    const message = error instanceof Error ? error.message : 'Engine request failed.';
    setStatus('Action failed', message, 'error');
    els.result.dataset.status = 'failed';
    const title = document.createElement('strong');
    const text = document.createElement('span');
    const details = document.createElement('small');
    title.textContent = 'needs action';
    text.textContent = message.split('\n')[0];
    details.textContent = error?.hint || message.split('\n').slice(1).join(' ');
    els.result.replaceChildren(title, text, details);
    renderRecoveryCard(error, options.operationId || lastTerminalOperationId || currentOperationId);
    showStatus(currentActionStatusContainer(), 'Action failed', text.textContent, 'error');
  }

  function currentActionStatusContainer() {
    if (journey.currentStep === 'keys') return els.keyActionStatus;
    if (['deploy', 'complete'].includes(journey.currentStep)) return els.deployPreviewStatus;
    if (journey.currentStep === 'review') return els.planGateStatus;
    return els.serverActionStatus;
  }

  function renderEnvelope(envelope) {
    const summary = summarizeEnvelope(envelope);
    els.result.dataset.status = summary.status;
    const status = document.createElement('strong');
    const text = document.createElement('span');
    const changed = document.createElement('small');
    status.textContent = summary.status;
    text.textContent = summary.text;
    changed.textContent = summary.changed ? 'Changes expected' : 'No immediate changes';
    els.result.replaceChildren(status, text, changed);
    setStep('complete');
  }

  function renderTimeline(events) {
    renderProgressCard(events);
    const items = timelineFromEvents(events).map((event) => {
      const item = document.createElement('li');
      item.className = `studio__timeline-item studio__timeline-item--${event.level}`;
      const seq = document.createElement('span');
      const body = document.createElement('div');
      const message = document.createElement('strong');
      const meta = document.createElement('small');
      const details = document.createElement('details');
      const summary = document.createElement('summary');
      const data = document.createElement('pre');
      seq.textContent = String(event.seq || '');
      message.textContent = event.message || event.type;
      meta.textContent = [event.phase, event.type, event.time].filter(Boolean).join(' · ');
      summary.textContent = 'Details';
      data.textContent = formatJson(event.data || {});
      details.replaceChildren(summary, data);
      body.replaceChildren(message, meta, details);
      item.replaceChildren(seq, body);
      return item;
    });
    els.timeline.replaceChildren(...items);
  }

  function renderProgressCard(events, snapshot = null) {
    const latest = events.length > 0 ? events[events.length - 1] : snapshot?.latest_event;
    if (!latest && !snapshot) {
      els.progressCard.hidden = true;
      return;
    }
    const data = latest?.data || {};
    const step = data.step || latest?.message || snapshot?.state || 'Working';
    const index = Number(data.index || 0);
    const total = Number(data.total || 0);
    const phase = latest?.phase || snapshot?.current_phase || 'deploy';
    const state = snapshot?.state || 'running';
    const title = document.createElement('strong');
    const body = document.createElement('span');
    const meta = document.createElement('small');
    title.textContent = friendlyOperationState(state);
    body.textContent = index > 0 && total > 0 ? `${step}, step ${index} of ${total}` : String(step);
    meta.textContent =
      state === 'running' || state === 'queued'
        ? 'This can take a few minutes. Keep this tab open.'
        : `${phase} · ${latest?.type || state}`;
    els.progressCard.dataset.status = state;
    els.progressCard.replaceChildren(title, body, meta);
    els.progressCard.hidden = false;
  }

  function friendlyOperationState(state) {
    if (state === 'queued') return 'Waiting to start';
    if (state === 'running') return 'Deploy in progress';
    if (state === 'cancel_requested') return 'Stopping after current step';
    if (state === 'completed_after_cancel') return 'Completed after stop request';
    if (state === 'cancelled') return 'Stopped before deploy';
    if (state === 'failed') return 'Needs recovery';
    if (state === 'succeeded') return 'Deploy complete';
    return state;
  }

  async function startDeploy() {
    const request = deployRequest(true);
    journey.confirmDeploy = true;
    lastDeployResult = null;
    lastFailure = null;
    lastTerminalOperationId = '';
    resetTerminalPanels();
    persist();
    try {
      const payload = await enginePost(engine, '/api/v1/deploy/start', request);
      currentOperationId = payload.operation?.id || '';
      journey.activeOperationId = currentOperationId;
      lastEventSeq = 0;
      operationEvents = [];
      persist();
      els.completionCopy.textContent = 'Deploy started. Progress updates will appear below.';
      setStep('complete');
      pollOperation();
    } catch (error) {
      if (error?.operation?.id) {
        currentOperationId = error.operation.id;
        journey.activeOperationId = currentOperationId;
        lastEventSeq = 0;
        operationEvents = [];
        persist();
        setStatus('Deploy already running', 'Studio is resuming the active operation for this server.', 'running');
        setStep('complete');
        pollOperation();
        return;
      }
      renderEngineError(error);
    }
  }

  async function pollOperation() {
    if (!currentOperationId) return;
    window.clearTimeout(pollTimer);
    try {
      const [statusPayload, eventsPayload, resultPayload] = await Promise.all([
        engineGet(`/api/v1/operations/${currentOperationId}`),
        engineGet(`/api/v1/operations/${currentOperationId}/events?after_seq=${lastEventSeq}`),
        engineGet(`/api/v1/operations/${currentOperationId}/result`),
      ]);
      const state = statusPayload.operation?.state || 'running';
      operationEvents = [...operationEvents, ...(eventsPayload.events || [])];
      lastEventSeq = eventsPayload.latest_seq || statusPayload.operation?.last_seq || lastEventSeq;
      renderTimeline(operationEvents);
      renderProgressCard(operationEvents, statusPayload.operation);
      setStatus(`Deploy ${state}`, 'Events below update automatically.', state === 'running' ? 'running' : 'ok');
      if (state === 'succeeded' && resultPayload.result) {
        renderPayload(resultPayload.result);
        lastTerminalOperationId = currentOperationId;
        journey.activeOperationId = '';
        currentOperationId = '';
        persist();
        render();
        return;
      }
      if (state === 'completed_after_cancel' && resultPayload.result) {
        renderDeploySuccess(resultPayload.result.result || resultPayload.result, { afterCancel: true });
        lastTerminalOperationId = currentOperationId;
        journey.activeOperationId = '';
        currentOperationId = '';
        persist();
        render();
        return;
      }
      if (state === 'failed' && resultPayload.error) {
        const error = new Error([resultPayload.error.message, resultPayload.error.hint].filter(Boolean).join('\n'));
        error.hint = resultPayload.error.hint || '';
        error.retryable = Boolean(resultPayload.error.retryable);
        error.category = resultPayload.error.category || 'system';
        lastTerminalOperationId = currentOperationId;
        renderEngineError(error, { operationId: currentOperationId });
        journey.activeOperationId = '';
        currentOperationId = '';
        persist();
        render();
        return;
      }
      if (state === 'cancel_requested') {
        setStatus('Cancel requested', 'Studio is waiting for the current Engine step to stop safely.', 'warning');
      }
      if (state === 'cancelled') {
        showStatus(els.deployPreviewStatus, 'Operation stopped', 'Deploy did not start, or stopped before a terminal result was available.', 'warning');
        setStatus('Operation stopped', 'Deploy did not start, or stopped before a terminal result was available.', 'warning');
        lastTerminalOperationId = currentOperationId;
        journey.activeOperationId = '';
        currentOperationId = '';
        persist();
        render();
        return;
      }
      pollTimer = window.setTimeout(pollOperation, 1200);
    } catch (error) {
      renderEngineError(error);
    }
  }

  async function copy(text, label) {
    await navigator.clipboard.writeText(text);
    els.copyStatus.textContent = `${label} copied`;
    setStatus(`${label} copied`, 'Paste it into Terminal when you are ready.', 'ok');
    window.setTimeout(() => {
      els.copyStatus.textContent = '';
    }, 1600);
  }

  function downloadJson(filename, value) {
    const url = URL.createObjectURL(new Blob([formatJson(value) + '\n'], { type: 'application/json' }));
    const link = document.createElement('a');
    link.href = url;
    link.download = filename;
    link.click();
    URL.revokeObjectURL(url);
  }

  async function copyDiagnostics() {
    const operationId = lastFailure?.operationId || lastTerminalOperationId;
    if (!engine || !operationId) return;
    try {
      const payload = await engineGet(`/api/v1/operations/${operationId}/diagnostics`);
      await navigator.clipboard.writeText(payload.markdown || formatJson(payload));
      setStatus('Diagnostics copied', 'The report is redacted and ready to paste into a support conversation.', 'ok');
    } catch (error) {
      renderEngineError(error, { operationId });
    }
  }

  function syncFromInputs() {
    const previousServer = requestSignature(journey.server);
    journey.server.title = fields.title.value;
    journey.server.host = fields.host.value;
    journey.server.ssh_user = fields.user.value || 'root';
    journey.server.ssh_port = Number(fields.port.value || 22);
    journey.deploy.server_name = fields.serverName.value || 'My VPN';
    journey.deploy.client_name = fields.clientName.value || 'default';
    journey.deploy.harden = fields.harden.checked;
    journey.deploy.geo_block = fields.geoBlock.checked;
    journey.deploy.sni = fields.sni.value || 'www.microsoft.com';
    journey.deploy.domain = fields.domain.value;
    journey.deploy.color = fields.color.value || workflowOptions(deployWorkflow, 'color')[0]?.value || 'ocean';
    journey.deploy.icon = fields.icon.value;
    journey.deploy.pq = fields.pq.checked;
    journey.deploy.warp = fields.warp.checked;
    journey.confirmDeploy = fields.confirm.checked;
    journey.selectedServerId = fields.savedServer.value;
    const selected = savedServers.find((server) => server.id === journey.selectedServerId);
    if (selected) {
      journey.readiness.serverSaved = true;
      journey.readiness.sshValidated = ['validated', 'key_ready'].includes(selected.auth_state);
      journey.readiness.keyReady = selected.auth_state === 'key_ready';
    } else if (previousServer !== requestSignature(journey.server)) {
      journey.readiness.serverSaved = false;
      journey.readiness.sshValidated = false;
      journey.readiness.keyReady = false;
    }
    if (journey.lastDryRunSignature && journey.lastDryRunSignature !== requestSignature(deployRequest(false))) {
      journey.readiness.dryRunComplete = false;
      latestPlan = null;
      latestPlanSource = '';
    }
    persist();
    render();
  }

  function openCommandSheet() {
    commandSheetReturnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    if (typeof els.commandSheet.showModal === 'function') {
      els.commandSheet.showModal();
    } else {
      els.commandSheet.setAttribute('open', '');
    }
    window.requestAnimationFrame(() => $('close-command-sheet')?.focus());
  }

  function closeCommandSheet() {
    if (typeof els.commandSheet.close === 'function') {
      els.commandSheet.close();
    } else {
      els.commandSheet.removeAttribute('open');
      restoreCommandSheetFocus();
    }
  }

  function restoreCommandSheetFocus() {
    if (commandSheetReturnFocus?.isConnected) {
      commandSheetReturnFocus.focus();
    }
    commandSheetReturnFocus = null;
  }

  function renderSshCommandPreview(parsed, error = '') {
    if (!fields.sshCommand.value.trim()) {
      els.sshCommandPreview.hidden = true;
      els.sshCommandPreview.replaceChildren();
      return;
    }
    els.sshCommandPreview.hidden = false;
    if (error) {
      const item = document.createElement('span');
      item.dataset.tone = 'warning';
      item.textContent = error;
      els.sshCommandPreview.replaceChildren(item);
      return;
    }
    const chips = [
      ['User', parsed.ssh_user],
      ['IP', parsed.host],
      ['Port', parsed.ssh_port],
      ['Title', parsed.title],
    ];
    els.sshCommandPreview.replaceChildren(
      ...chips.map(([label, value]) => {
        const chip = document.createElement('span');
        chip.textContent = `${label}: ${value}`;
        return chip;
      }),
    );
  }

  function previewSshCommand() {
    const text = fields.sshCommand.value.trim();
    if (!text) {
      renderSshCommandPreview(null);
      return;
    }
    try {
      renderSshCommandPreview(parseSshCommand(text));
    } catch {
      renderSshCommandPreview(null, 'Waiting for a full SSH command');
    }
  }

  function importSshCommand() {
    const text = fields.sshCommand.value.trim();
    if (!text) return;
    try {
      const parsed = parseSshCommand(text);
      journey.server.host = parsed.host;
      journey.server.ssh_port = parsed.ssh_port;
      journey.server.ssh_user = parsed.ssh_user;
      if (!journey.server.title) {
        journey.server.title = parsed.title;
      }
      renderSshCommandPreview(parsed);
      showStatus(els.serverActionStatus, 'SSH command imported', 'Server fields were filled from the pasted command.', 'ok');
      persist();
      render();
    } catch (error) {
      showStatus(
        els.serverActionStatus,
        'Could not read SSH command',
        error instanceof Error ? error.message : 'Paste a command like ssh ubuntu@198.51.100.10 -p 2222.',
        'warning',
      );
    }
  }

  document.querySelectorAll('[data-next-step]').forEach((button) => {
    button.addEventListener('click', () => setStep(button.dataset.nextStep));
  });
  document.querySelectorAll('[data-prev-step]').forEach((button) => {
    button.addEventListener('click', () => setStep(button.dataset.prevStep));
  });
  document.querySelectorAll('[data-step-target]').forEach((button) => {
    button.addEventListener('click', () => setStep(button.dataset.stepTarget));
  });
  els.savedServerStartList.addEventListener('click', (event) => {
    const button = event.target instanceof Element ? event.target.closest('[data-use-server]') : null;
    if (button instanceof HTMLElement) {
