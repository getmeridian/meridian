      field.addEventListener('change', syncFromInputs);
    }
  });
  fields.sshCommand.addEventListener('input', previewSshCommand);
  fields.sshCommand.addEventListener('paste', () => window.setTimeout(importSshCommand, 0));
  fields.sshCommand.addEventListener('change', importSshCommand);

  $('studio-reset').addEventListener('click', () => {
    journey = clearJourneyDraft(window.localStorage);
    fields.password.value = '';
    currentOperationId = '';
    setStatus('Ready', engine ? 'Local Studio is available.' : 'Static command mode is active.', 'ok');
    render();
