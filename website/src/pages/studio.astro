  $('copy-save-command').addEventListener('click', () => copy(buildServerCliCommands(serverDraft()).save, 'Save command'));
  $('copy-dry-run-command').addEventListener('click', () => copy(commands.dryRun, 'Dry-run command'));
  $('copy-deploy-command').addEventListener('click', () => copy(commands.deploy, 'Deploy command'));
  $('download-server').addEventListener('click', () => downloadJson('server.json', serverDraft()));
  $('download-request').addEventListener('click', () => downloadJson('deploy.json', deployRequest(false)));
  $('download-request-sheet').addEventListener('click', () => downloadJson('deploy.json', deployRequest(false)));
  els.copyInviteLink.addEventListener('click', () => copy(els.copyInviteLink.dataset.copyValue || '', 'Invite link'));
  els.copyTestCommand.addEventListener('click', () => copy(els.copyTestCommand.dataset.copyValue || '', 'Test command'));
  els.copyAddDeviceCommand.addEventListener('click', () =>
    copy(els.copyAddDeviceCommand.dataset.copyValue || 'meridian client add phone', 'Add-device command'),
  );
  els.retryDeploy.addEventListener('click', () => startDeploy());
  els.copyDiagnostics.addEventListener('click', copyDiagnostics);
  $('parse-output').addEventListener('click', () => {
    try {
      const text = els.paste.value.trim();
      if (!text) {
        els.parseStatus.textContent = 'No output pasted';
        return;
      }
      if (text.startsWith('{')) {
        const envelope = parseEnvelope(text);
        if (envelope.command === 'deploy' && envelope.summary?.text?.startsWith('Deploy plan:')) {
          const expectedIp = expectedDryRunServerIp(deployRequest(false));
          if (expectedIp && envelope.data?.server_ip && envelope.data.server_ip !== expectedIp) {
            els.parseStatus.textContent = `That dry-run is for ${envelope.data.server_ip}, but this draft targets ${expectedIp}.`;
            return;
          }
          latestPlan = envelope.data || null;
          latestPlanSource = 'static';
          journey.readiness.dryRunComplete = true;
          journey.lastDryRunSignature = requestSignature(deployRequest(false));
          persist();
          showStatus(els.deployPreviewStatus, 'Preview imported', 'The pasted dry-run output is now the review source.', 'ok');
          els.parseStatus.textContent = 'Dry-run preview imported';
          closeCommandSheet();
          setStep('review');
        } else {
          renderEnvelope(envelope);
          els.parseStatus.textContent = 'Envelope parsed';
        }
      } else {
        const events = parseEventStream(text);
        renderTimeline(events);
        els.parseStatus.textContent = `${events.length} events parsed`;
      }
    } catch (error) {
      els.parseStatus.textContent = error instanceof Error ? error.message : 'Could not parse output';
    }
  });
  connectLocalEngine().then(async (detected) => {
    engine = detected;
    journey.mode = engine ? 'engine' : 'static';
    setStatus(
      engine ? 'Local Studio available' : 'Static command mode',
      engine
        ? 'Save servers, install keys, preview, and deploy locally.'
        : 'Generate commands and JSON. Launch `meridian studio` for guided actions.',
    );
    persist();
    await refreshSavedServers();
    if (engine && currentOperationId) {
      setStatus('Resuming operation', 'Studio is reconnecting to the active deploy operation.', 'running');
      setStep('complete');
      pollOperation();
    }
    render();
  });
  if (!journey.currentStep) journey = createDefaultJourneyState();
  render();
</script>

