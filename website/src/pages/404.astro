---
/**
 * 404 — one static page for every missing URL, so its text swaps to the reader's
 * language in the browser (shell strings); the docs link opens /docs/, which picks
 * the reader's language too.
 */
import Base from '../layouts/Base.astro';
import { shellT } from '../i18n';

const t = shellT('en');
---

<Base title={`${t('notFound.title')} — Meridian`} titleKey="notFound.title" noindex>
  <main id="main" class="not-found" data-i18n-scope>
    <div class="container">
      <p class="not-found__code" aria-hidden="true">404</p>
      <h1 data-t="notFound.title">{t('notFound.title')}</h1>
      <p class="not-found__text" data-t="notFound.text">{t('notFound.text')}</p>
      <div class="btn-row not-found__actions">
        <a href="/" class="btn btn--primary" data-t="notFound.home">{t('notFound.home')}</a>
        <a href="/docs/" class="btn btn--secondary" data-docs-link data-t="notFound.docs">{t('notFound.docs')}</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .not-found {
    padding: clamp(64px, 12vw, 128px) 0;
    text-align: center;
  }
  .not-found__code {
    font-family: var(--mono);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--ac-text);
    margin-bottom: 12px;
  }
  .not-found__text {
    color: var(--t2);
    font-size: 1.1rem;
    margin: 12px 0 32px;
  }
  .not-found__actions {
    justify-content: center;
  }
</style>
