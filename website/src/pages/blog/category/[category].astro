---
import BlogListing from '../../../components/blog/BlogListing.astro';
import { categorySlug, getPosts, type Post } from '../../../components/blog/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const categories = [...new Set(posts.map((p) => p.data.category))];
  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: { category, posts: posts.filter((p) => p.data.category === category) },
  }));
}

const { category, posts } = Astro.props as { category: string; posts: Post[] };
---

<BlogListing
  title={`${category} — Meridian Blog`}
  heading={category}
  description={`${posts.length} ${posts.length === 1 ? "article" : "articles"} about ${category.toLowerCase()} on the Meridian blog.`}
  posts={posts}
  category={category}
/>
