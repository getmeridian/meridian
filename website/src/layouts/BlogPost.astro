---
/**
 * BlogPost — a single post: header, prose body (src/styles/prose.css, matched to the
 * docs), and two more posts to read next.
 */
import Base from './Base.astro';
import Mermaid from '../components/Mermaid.astro';
import BlogCard from '../components/blog/BlogCard.astro';
import { categoryHref, formatDate, getPosts, isoDate, type Post } from '../components/blog/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, author, category, readingTime } = post.data;
const more = (await getPosts()).filter((p) => p.id !== post.id).slice(0, 2);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: isoDate(date),
  inLanguage: 'en',
  author: { '@type': 'Organization', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'Meridian',
    logo: { '@type': 'ImageObject', url: new URL('/img/logo-512.png', Astro.site).href },
  },
};
---

<Base title={`${title} — Meridian Blog`} description={description} ogType="article">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <main id="main" class="post">
    <article class="post__article">
      <header class="post__header">
        <a href="/blog/" class="post__back">← All posts</a>
        <a href={categoryHref(category)} class="pill">{category}</a>
        <h1>{title}</h1>
        <p class="post__lead">{description}</p>
        <p class="post__meta">
          <time datetime={isoDate(date)}>{formatDate(date, 'long')}</time>
          <span aria-hidden="true">·</span>
          <span>{author}</span>
          <span aria-hidden="true">·</span>
          <span>{readingTime} min read</span>
        </p>
      </header>
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
    </article>

    {more.length > 0 && (
      <aside class="post__more container" aria-labelledby="more-posts">
        <h2 id="more-posts">More from the blog</h2>
        <div class="post__more-grid">
          {more.map((p) => <BlogCard post={p} headingLevel={3} />)}
        </div>
        <p><a href="/blog/">← All posts</a> · <a href="/blog/rss.xml">RSS feed</a></p>
      </aside>
    )}
  </main>
  <Mermaid />
</Base>

<style>
  .post {
    padding: clamp(32px, 6vw, 64px) 0 24px;
  }
  .post__article {
    max-width: calc(var(--prose-max) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .post__header {
    margin-bottom: 36px;
  }
  .post__back {
    display: block;
    width: fit-content;
    margin-bottom: 28px;
    font-size: 0.92rem;
    color: var(--t2);
  }
  .post__back:hover {
    color: var(--t1);
  }
  .post__header h1 {
    margin: 14px 0 16px;
    font-size: clamp(2rem, 4.5vw, 2.8rem);
  }
  .post__lead {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--t2);
    margin-bottom: 18px;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--t3);
  }
  .post__more {
    margin-top: var(--section-y);
    padding-top: 40px;
    border-top: 1px solid var(--b1);
  }
  .post__more h2 {
    font-size: 1.5rem;
    margin-bottom: 20px;
  }
  .post__more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    margin-bottom: 24px;
  }
  .post__more > p {
    color: var(--t3);
    font-size: 0.94rem;
  }
</style>

<style is:global>
  @import '../styles/prose.css';
</style>
