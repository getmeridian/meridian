---
/**
 * Base — the HTML shell for every non-docs page: head metadata, nav, footer.
 *
 * Landing pages exist per locale and pass `locale` plus `alternates`; everything is
 * static HTML. Pages without a locale version (blog, 404) keep English content and
 * swap only the shell text (nav, footer, `data-t`) to the reader's language.
 */
import fs from 'node:fs';
import path from 'node:path';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { LOCALE_INFO, LOCALES, dirOf, type Locale } from '../i18n/locales';
import type { ShellKey } from '../i18n/shell';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  locale?: Locale;
  /** hreflang alternates; set only by pages that exist in every locale. */
  alternates?: { hreflang: string; href: string }[];
  noindex?: boolean;
  /** Shell string that names the page; the client swap retitles the tab with it. */
  titleKey?: ShellKey;
}

const {
  title,
  description = 'One command deploys a hardened VLESS+Reality proxy server and a link to share. Open source.',
  ogImage = '/img/og.png',
  ogImageAlt = 'Meridian: share secure internet with the people you care about',
  ogType = 'website',
  locale = 'en',
  alternates,
  noindex = false,
  titleKey,
} = Astro.props;

const localized = Boolean(alternates);
const info = LOCALE_INFO[locale];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const version = fs.readFileSync(path.resolve('../VERSION'), 'utf8').trim();
const bodyFont = {
  en: ['/fonts/source-sans-3-latin.woff2'],
  ru: ['/fonts/source-sans-3-latin.woff2', '/fonts/source-sans-3-cyrillic.woff2'],
  fa: ['/fonts/vazirmatn-arabic.woff2'],
  zh: ['/fonts/source-sans-3-latin.woff2'],
}[locale];
---

<!doctype html>
<html lang={info.lang} dir={dirOf(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Theme before first paint: the saved choice, else the OS's (Expressive Code reads
         data-theme, as on Starlight pages). Storage may be unavailable (Tor, private modes). -->
    <script is:inline>
      (function () {
        var t;
        try {
          t = localStorage.getItem('starlight-theme') || localStorage.getItem('meridian-theme');
        } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <slot name="early" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FDFAF6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1C1E28" media="(prefers-color-scheme: dark)" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:site_name" content="Meridian" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={info.og} />
    {localized && LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={LOCALE_INFO[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <link rel="canonical" href={canonicalURL} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" type="application/rss+xml" title="Meridian Blog" href="/blog/rss.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/img/logo-180.png" />
    {bodyFont.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body data-title-key={titleKey}>
    <a href="#main" class="skip-link" data-t="skip">Skip to content</a>
    <Nav locale={locale} localized={localized} />
    <slot />
    <Footer locale={locale} version={version} />

    {!localized && (
      <script>
        import { swapShell } from '../i18n/swap';
        swapShell();
      </script>
    )}
    <script is:inline>
      // An explicit language choice sticks: `/` sends readers to their saved language.
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element && e.target.closest('a[data-lang-choice]');
        if (!link) return;
        try {
          localStorage.setItem('meridian-lang', link.getAttribute('data-lang-choice'));
        } catch (err) {}
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
