{
  "name": "meridian-video",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "studio": "remotion studio",
    "tts": "node scripts/tts.mjs",
    "still": "remotion still src/index.ts Setup out/still.png",
    "render": "remotion render src/index.ts Setup out/meridian-setup.mp4",
    "render:ru": "remotion render src/index.ts SetupRu out/meridian-setup.ru.mp4",
    "render:short": "remotion render src/index.ts Short out/meridian-short.en.mp4",
    "render:short:ru": "remotion render src/index.ts ShortRu out/meridian-short.ru.mp4",
    "export:short": "node scripts/export-short.mjs",
    "music": "uv run --project ~/.cache/ace-step/ACE-Step-1.5 python scripts/music.py",
    "export": "node scripts/export.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
